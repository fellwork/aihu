@route {
  name: 'about'
}

@template {
  <div class="about">
    <h1>About</h1>
    <p>This is the about page — a second route wired through the aihu router.</p>
    <a href="/">Home</a>
  </div>
}

@style {
.about {
  padding: 2rem;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  max-width: 600px;
  margin: 0 auto;
}
}
