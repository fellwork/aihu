{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!dist",
      "!coverage",
      "!target",
      "!bun.lock",
      "!**/*.cjs",
      "!.claude",
      "!.team",
      "!.mcp.json",
      "!examples/**/*.css",
      "!bench/compiler-conformance",
      "!packages/cli/tests/legacy-snapshot.golden",
      "!brand",
      "!apps/docs/playground/presets.generated.ts",
      "!apps/docs-next/playground/presets.generated.ts",
      "!packages/mcp/src/cookbook-index.json",
      "!vendor",
      "!packages/css-engine/styles/aihu-default.css",
      "!packages/css-engine/styles/aihu-graphite.css",
      "!apps/storybook/src/stories/animations-gallery.generated.css",
      "!apps/storybook/src/stories/animations-gallery.generated.ts",
      "!scripts/fixtures/animations-gallery/expected.generated.css",
      "!scripts/fixtures/animations-gallery/expected.generated.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noCommaOperator": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noConfusingVoidType": "off",
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "bench/arbor/src/**",
        "packages/plugin-agent-readiness/src/vite-plugin.ts",
        "packages/language-server/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/vscode-aihu/server/completion.ts",
        "packages/language-server/src/core/completion.ts",
        "scripts/check-gate-wiring.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/docs-next/src/data/api/generated/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/docs/**", "apps/docs-next/**"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/swarm-console/src/styles/**/*.css"],
      "css": {
        "parser": {
          "tailwindDirectives": true
        }
      }
    },
    {
      "includes": ["packages/css-engine/crates/aihu-css-core/recipes/**/*.css"],
      "css": {
        "parser": {
          "tailwindDirectives": true
        }
      }
    }
  ]
}
