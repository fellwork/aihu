# Normalize line endings on commit; check out with the platform's native eol.
# Prevents CRLF artifacts on Windows that bit Phase 2 (see .team/learnings.md).
* text=auto eol=lf

# Lockfiles and binary blobs stay verbatim.
bun.lock binary
*.png binary
*.ico binary
*.jpg binary
*.gif binary
*.webp binary

# GitHub Linguist — .aihu files are not yet a registered language. Until
# the project qualifies for a PR to github-linguist/linguist (200+ adopter
# bar + sample files + grammar reference), the bulk of an .aihu file is
# TypeScript (inside @state and @agent blocks), so map to that — the block
# markers (@template {, @style {) render as harmless annotations rather
# than the broken-tag look that Vue/HTML mappings produce.
*.aihu linguist-language=TypeScript
*.aihu linguist-detectable=true
