# Normalize line endings on commit; check out with the platform's native eol.
# Prevents CRLF artifacts on Windows that bit Phase 2 (see .team/learnings.md).
* text=auto eol=lf

# Lockfiles and binary blobs stay verbatim.
bun.lock binary
*.png binary
*.ico binary
*.jpg binary
*.gif binary
*.webp binary

# GitHub Linguist — render .aihu files as Vue SFCs (closest match for the
# template/style/script block structure). Aihu is not yet a registered
# language in linguist; submit a PR to github-linguist/linguist when the
# project hits the 200+ adopter bar. Until then this gives PR diffs and
# code views proper syntax highlighting on github.com.
*.aihu linguist-language=Vue
*.aihu linguist-detectable=true
