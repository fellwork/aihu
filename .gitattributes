# Normalize line endings on commit; check out with the platform's native eol.
# Prevents CRLF artifacts on Windows that bit Phase 2 (see .team/learnings.md).
* text=auto eol=lf

# Lockfiles and binary blobs stay verbatim.
bun.lock binary
*.png binary
*.ico binary
*.jpg binary
*.gif binary
*.webp binary

# GitHub Linguist — detect .scribe files as the Scribe language.
# The linguist-language value must match a language registered in
# https://github.com/github-linguist/linguist/blob/master/lib/linguist/languages.yml
# Submit a PR to Linguist to register "Scribe" with this grammar.
*.scribe linguist-language=TypeScript
*.scribe linguist-detectable=true
