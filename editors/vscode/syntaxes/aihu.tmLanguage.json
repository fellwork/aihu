{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aihu SFC",
  "scopeName": "source.aihu",
  "patterns": [
    { "include": "#agent-block" },
    { "include": "#script-setup-block" },
    { "include": "#server-setup-block" },
    { "include": "#template-block" },
    { "include": "#style-block" }
  ],
  "repository": {
    "agent-block": {
      "begin": "(<)(agent)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.aihu" },
        "2": { "name": "entity.name.tag.aihu" },
        "3": { "name": "punctuation.definition.tag.end.aihu" }
      },
      "end": "(</)(agent)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.aihu" },
        "2": { "name": "entity.name.tag.aihu" },
        "3": { "name": "punctuation.definition.tag.end.aihu" }
      },
      "name": "meta.block.agent.aihu",
      "patterns": [
        { "include": "#agent-comment" },
        { "include": "#agent-input" },
        { "include": "#agent-state" },
        { "include": "#agent-action" }
      ]
    },
    "agent-comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.aihu"
    },
    "agent-input": {
      "begin": "^\\s*(input)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.input.aihu" },
        "2": { "name": "variable.parameter.input.aihu" },
        "3": { "name": "punctuation.separator.colon.aihu" }
      },
      "end": "$",
      "patterns": [
        { "include": "#agent-comment" },
        { "include": "#agent-types" },
        {
          "match": "(=)\\s*([^#\\n]+)",
          "captures": {
            "1": { "name": "keyword.operator.assignment.aihu" },
            "2": { "name": "string.unquoted.default.aihu" }
          }
        }
      ]
    },
    "agent-state": {
      "begin": "^\\s*(state)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.state.aihu" },
        "2": { "name": "variable.other.state.aihu" },
        "3": { "name": "punctuation.separator.colon.aihu" }
      },
      "end": "$",
      "patterns": [{ "include": "#agent-comment" }, { "include": "#agent-types" }]
    },
    "agent-action": {
      "begin": "^\\s*(action)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()(\\))",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.action.aihu" },
        "2": { "name": "entity.name.function.action.aihu" },
        "3": { "name": "punctuation.section.parens.begin.aihu" },
        "4": { "name": "punctuation.section.parens.end.aihu" }
      },
      "end": "$",
      "patterns": [
        { "include": "#agent-comment" },
        {
          "match": "->",
          "name": "keyword.operator.arrow.aihu"
        },
        {
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.section.braces.begin.aihu" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.braces.end.aihu" }
          },
          "patterns": [
            {
              "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
              "captures": {
                "1": { "name": "variable.other.member.aihu" },
                "2": { "name": "punctuation.separator.colon.aihu" }
              }
            },
            { "include": "#agent-types" },
            {
              "match": ",",
              "name": "punctuation.separator.comma.aihu"
            }
          ]
        }
      ]
    },
    "agent-types": {
      "patterns": [
        {
          "match": "\\b(string|number|boolean)\\b",
          "name": "support.type.primitive.aihu"
        },
        {
          "begin": "\\b(enum)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "support.type.enum.aihu" },
            "2": { "name": "punctuation.section.parens.begin.aihu" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.section.parens.end.aihu" }
          },
          "patterns": [
            {
              "match": "[A-Za-z_][A-Za-z0-9_]*",
              "name": "constant.other.enum-variant.aihu"
            },
            {
              "match": ",",
              "name": "punctuation.separator.comma.aihu"
            }
          ]
        }
      ]
    },
    "script-setup-block": {
      "begin": "(<)(script)(\\s+setup\\b[^>]*)?(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.aihu" },
        "2": { "name": "entity.name.tag.aihu" },
        "3": { "name": "meta.tag.attributes.aihu" },
        "4": { "name": "punctuation.definition.tag.end.aihu" }
      },
      "end": "(</)(script)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.aihu" },
        "2": { "name": "entity.name.tag.aihu" },
        "3": { "name": "punctuation.definition.tag.end.aihu" }
      },
      "name": "meta.block.script.aihu",
      "contentName": "source.ts",
      "patterns": [{ "include": "source.ts" }]
    },
    "server-setup-block": {
      "begin": "(<)(server)(\\s+setup\\b[^>]*)?(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.aihu" },
        "2": { "name": "entity.name.tag.aihu" },
        "3": { "name": "meta.tag.attributes.aihu" },
        "4": { "name": "punctuation.definition.tag.end.aihu" }
      },
      "end": "(</)(server)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.aihu" },
        "2": { "name": "entity.name.tag.aihu" },
        "3": { "name": "punctuation.definition.tag.end.aihu" }
      },
      "name": "meta.block.server.aihu",
      "contentName": "source.ts",
      "patterns": [{ "include": "source.ts" }]
    },
    "template-block": {
      "begin": "(<)(template)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.aihu" },
        "2": { "name": "entity.name.tag.aihu" },
        "3": { "name": "punctuation.definition.tag.end.aihu" }
      },
      "end": "(</)(template)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.aihu" },
        "2": { "name": "entity.name.tag.aihu" },
        "3": { "name": "punctuation.definition.tag.end.aihu" }
      },
      "name": "meta.block.template.aihu",
      "contentName": "text.html.basic",
      "patterns": [{ "include": "text.html.basic" }]
    },
    "style-block": {
      "begin": "(<)(style)([^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.aihu" },
        "2": { "name": "entity.name.tag.aihu" },
        "3": { "name": "meta.tag.attributes.aihu" },
        "4": { "name": "punctuation.definition.tag.end.aihu" }
      },
      "end": "(</)(style)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.aihu" },
        "2": { "name": "entity.name.tag.aihu" },
        "3": { "name": "punctuation.definition.tag.end.aihu" }
      },
      "name": "meta.block.style.aihu",
      "contentName": "source.css",
      "patterns": [{ "include": "source.css" }]
    }
  }
}
