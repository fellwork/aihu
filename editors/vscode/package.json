{
  "name": "aihu-vscode",
  "displayName": "Aihu SFC",
  "description": "Syntax highlighting and snippets for .aihu SFCs",
  "version": "0.0.1",
  "publisher": "fellwork",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aihu",
        "aliases": [
          "Aihu SFC",
          "aihu"
        ],
        "extensions": [
          ".aihu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aihu",
        "scopeName": "source.aihu",
        "path": "./syntaxes/aihu.tmLanguage.json",
        "embeddedLanguages": {
          "source.ts": "typescript",
          "text.html.basic": "html",
          "source.css": "css"
        }
      }
    ],
    "snippets": [
      {
        "language": "aihu",
        "path": "./snippets/aihu.json"
      }
    ]
  }
}
