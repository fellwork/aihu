#!/usr/bin/env sh
# Pre-commit: fast checks only (biome formats/lints in <1s)
# For the full CI replay, use `bun run check:ci` or rely on the pre-push hook.
bunx biome check --write --staged --no-errors-on-unmatched

# README autogen sync — keeps the data-heavy sections of README.md and every
# packages/**/README.md fresh on every commit. Must stay in sync: fail the commit
# if drift is detected and prompt the author to run `bun scripts/sync-readme.ts`.
bun scripts/sync-readme.ts --check
