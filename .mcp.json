{
  "mcpServers": {
    "gbrain": {
      "command": "bash",
      "args": [".claude/scripts/gbrain-mcp.sh"]
    },
    "aihu": {
      "command": "bun",
      "args": ["run", "--filter", "@aihu/mcp", "serve"],
      "env": {
        "AIHU_COOKBOOK_PATH": "./packages/mcp/src/cookbook-index.json"
      }
    }
  }
}
