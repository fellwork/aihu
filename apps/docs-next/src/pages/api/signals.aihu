@route {
  path: "/api/signals",
  name: "api-signals",
  layout: "docs",
  head: {
    title: "@aihu/signals — API Reference — aihu",
    description: "Typed API reference for @aihu/signals: signal, computed, effect, batch, untrack, and the Signal / Read / Write types.",
    canonical: "/api/signals"
  }
}

@state {
  // Raw-HTML `html={…}` bindings do not hydrate inside an `each` loop (only a
  // single top-level binding does — see the landing hero). So per-export
  // signatures + examples render as plain interpolated text in <pre><code>;
  // that also means they land in the DOM-free __ssrString and ship as real
  // static HTML. Syntax-highlighted code is showcased on the landing hero +
  // examples playground (single top-level bindings).
  import { PKG, EXPORTS } from '../../data/api-signals.ts'

  const pkg = PKG
  const fns = EXPORTS.filter((e) => e.kind === 'function')
  const types = EXPORTS.filter((e) => e.kind === 'type')

  const items = EXPORTS.map((e, i) => ({
    name: e.name,
    kind: e.kind,
    summary: e.summary,
    params: e.params ?? [],
    returns: e.returns ?? '',
    signature: e.signature,
    example: e.example ?? '',
    hasExample: !!e.example,
    hasParams: (e.params ?? []).length > 0,
    num: String(i + 1).padStart(2, '0'),
  }))
}

@template {
  <div class="dn-api dn-article">
    <p class="dn-breadcrumb dn-rail"><a href="/api/signals">API</a> / {pkg.name}</p>

    <header class="dn-api-head">
      <div class="dn-api-titles">
        <h1 class="dn-api-pkg">{pkg.name}</h1>
        <span class="dn-status dn-status-graphite dn-api-badge">
          <span class="dn-dot dn-dot-graphite"></span>runtime core
        </span>
      </div>
      <p class="dn-api-tagline">{pkg.tagline}</p>
      <p class="dn-api-blurb">{pkg.blurb}</p>
      <dl class="dn-api-spec">
        <div><dt>exports</dt><dd class="dn-num">{items.length}</dd></div>
        <div><dt>functions</dt><dd class="dn-num">{fns.length}</dd></div>
        <div><dt>types</dt><dd class="dn-num">{types.length}</dd></div>
        <div><dt>size</dt><dd class="dn-num">≤ 2 kB</dd></div>
      </dl>
    </header>

    <div class="dn-api-index">
      <div class="dn-api-index-col">
        <p class="dn-api-index-label">Functions</p>
        <ul>
          <li each={f of fns} key={f.name}><a href={`#${f.name}`}><code>{f.name}</code></a></li>
        </ul>
      </div>
      <div class="dn-api-index-col">
        <p class="dn-api-index-label">Types</p>
        <ul>
          <li each={t of types} key={t.name}><a href={`#${t.name}`}><code>{t.name}</code></a></li>
        </ul>
      </div>
    </div>

    <section class="dn-api-export" each={it of items} key={it.name}>
      <div class="dn-api-export-head">
        <span class="dn-rail dn-api-export-num">{it.num}</span>
        <h2 id={it.name} class="dn-api-export-name"><code>{it.name}</code></h2>
        <span class="dn-chip dn-api-kind">{it.kind}</span>
      </div>
      <pre class="dn-api-sig"><code>{it.signature}</code></pre>
      <p class="dn-api-summary">{it.summary}</p>

      <div class="dn-api-params" if={it.hasParams}>
        <table>
          <thead><tr><th>Parameter</th><th>Type</th><th>Description</th></tr></thead>
          <tbody>
            <tr each={p of it.params} key={p.name}>
              <td><code>{p.name}</code><span class="dn-api-opt" if={p.optional}>?</span></td>
              <td><code class="dn-api-type">{p.type}</code></td>
              <td>{p.desc}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="dn-api-returns" if={it.returns !== ''}>
        <span class="dn-api-returns-label">Returns</span>
        <code>{it.returns}</code>
      </p>

      <pre class="dn-api-ex" if={it.hasExample}><code>{it.example}</code></pre>
    </section>
  </div>
}

@style {
  .dn-api {
    max-width: var(--content-max);
  }
  .dn-breadcrumb {
    margin: 0 0 1.5rem;
  }
  .dn-breadcrumb a {
    color: var(--muted);
  }
  .dn-api-titles {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }
  .dn-api-pkg {
    font-family: var(--font-mono);
    font-size: var(--fs-2xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg-strong);
    margin: 0;
  }
  .dn-api-badge {
    border: 1px solid var(--graphite-line);
    background: var(--graphite-soft);
    border-radius: var(--r-full);
    padding: 0.15rem 0.65rem;
    font-size: var(--fs-xs);
  }
  .dn-api-tagline {
    font-size: var(--fs-lg);
    color: var(--fg);
    margin: 0.85rem 0 0.5rem;
  }
  .dn-api-blurb {
    color: var(--muted);
    line-height: 1.65;
    margin: 0 0 1.5rem;
  }
  /* datasheet spec rail for the package */
  .dn-api-spec {
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: 0 2.5rem;
    justify-content: start;
    margin: 0 0 0.5rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .dn-api-spec dt {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--faint);
  }
  .dn-api-spec dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--fs-md);
    font-weight: 550;
    color: var(--fg-strong);
    font-variant-numeric: tabular-nums;
  }
  .dn-api-index {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
    margin: 1.5rem 0 1rem;
  }
  .dn-api-index-label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--faint);
    font-weight: 500;
    margin: 0 0 0.6rem;
  }
  .dn-api-index ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
  }
  .dn-api-index a {
    text-decoration: none;
  }
  .dn-api-index code {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--accent);
    background: var(--code-inline-bg);
    border: 1px solid var(--code-border);
    padding: 0.1rem 0.45rem;
    border-radius: 5px;
  }
  .dn-api-export {
    padding: 2rem 0;
    border-top: 1px solid var(--border);
  }
  .dn-api-export-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 0.9rem;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .dn-api-export-num {
    color: var(--accent);
    font-weight: 500;
  }
  .dn-api-export-name {
    margin: 0;
  }
  .dn-api-export-name code {
    font-family: var(--font-mono);
    font-size: var(--fs-xl);
    font-weight: 600;
    color: var(--fg-strong);
  }
  .dn-api-kind {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .dn-api-sig {
    margin: 0 0 1rem;
    padding: 0.9rem 1.1rem;
    background: var(--code-bg);
    border: 1px solid var(--code-border);
    border-left: 2px solid var(--accent-line);
    border-radius: var(--r-md);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--graphite);
  }
  .dn-api-sig code {
    font-family: var(--font-mono);
    color: inherit;
  }
  .dn-api-ex {
    margin: 0 0 0.5rem;
    padding: 0.9rem 1.1rem;
    background: var(--code-bg);
    border: 1px solid var(--code-border);
    border-radius: var(--r-md);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.65;
    color: var(--fg);
  }
  .dn-api-ex code {
    font-family: var(--font-mono);
    color: inherit;
  }
  .dn-api-summary {
    color: var(--fg);
    line-height: 1.65;
    margin: 0 0 1rem;
  }
  .dn-api-params table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
    margin: 0 0 1rem;
  }
  .dn-api-params th,
  .dn-api-params td {
    text-align: left;
    padding: 0.5rem 0.7rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .dn-api-params th {
    font-family: var(--font-mono);
    color: var(--faint);
    font-weight: 500;
    text-transform: uppercase;
    font-size: var(--fs-xs);
    letter-spacing: 0.05em;
  }
  .dn-api-params code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--accent);
  }
  .dn-api-type {
    color: var(--graphite) !important;
  }
  .dn-api-opt {
    color: var(--faint);
  }
  .dn-api-returns {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin: 0 0 1rem;
    font-size: var(--fs-sm);
  }
  .dn-api-returns-label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--faint);
    font-weight: 500;
  }
  .dn-api-returns code {
    font-family: var(--font-mono);
    color: var(--graphite);
    font-size: 0.85em;
  }
  @media (max-width: 560px) {
    .dn-api-index {
      grid-template-columns: 1fr;
    }
    .dn-api-spec {
      grid-template-columns: repeat(2, auto);
      gap: 0.75rem 2rem;
    }
  }
}
