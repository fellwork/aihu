@route {
  path: "/guides/installation",
  name: "guide-installation",
  layout: "docs",
  head: {
    title: "Installation — aihu",
    description: "Scaffold, install, run, and build an aihu application with the @aihu/cli.",
    canonical: "/guides/installation"
  }
}

@state {
  // Dogfood the markdown pipeline AT PRERENDER — see getting-started.aihu
  // for the full rationale (renderMarkdown runs inside this page's own
  // @state, so the guide body ships as real static HTML).
  import { renderMarkdown } from '../../lib/markdown.ts'
  import { INSTALLATION } from '../../data/guide-installation.ts'

  const body = renderMarkdown(INSTALLATION)
}

@template {
  <div class="dn-guide">
    <p class="dn-sec-num"><b>G · 02</b> guides</p>
    <p class="dn-breadcrumb dn-rail"><a href="/guides/getting-started">Guides</a> / Installation</p>
    <article class="dn-prose dn-article" html={body}></article>
    <nav class="dn-page-nav" aria-label="Guide pagination">
      <a class="dn-page-prev" href="/guides/getting-started">
        <span>Previous</span>
        <strong>← Getting Started</strong>
      </a>
      <a class="dn-page-next" href="/guides/reactivity">
        <span>Next</span>
        <strong>Reactivity →</strong>
      </a>
    </nav>
  </div>
}

@style {
  .dn-guide {
    max-width: var(--content-max);
  }
  .dn-guide > .dn-sec-num {
    margin: 0 0 1rem;
  }
  .dn-breadcrumb {
    margin: 0 0 2rem;
  }
  .dn-breadcrumb a {
    color: var(--muted);
  }
  .dn-page-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .dn-page-prev,
  .dn-page-next {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.85rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    text-decoration: none;
    color: var(--fg);
  }
  .dn-page-next {
    align-items: flex-end;
  }
  .dn-page-prev:hover,
  .dn-page-next:hover {
    text-decoration: none;
    border-color: var(--accent-line);
  }
  .dn-page-prev span,
  .dn-page-next span {
    font-size: var(--fs-xs);
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .dn-page-prev strong,
  .dn-page-next strong {
    color: var(--accent);
    font-weight: 600;
  }
}
