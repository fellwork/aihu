# Ported from apps/docs/public/_headers so the cutover does not silently drop
# aihu.dev's security headers, agent-surface CORS, or asset caching.
#
# Differences from apps/docs, all because the docs app is a different app:
#   - no `cdnjs.cloudflare.com` — this app loads no third-party scripts/styles.
#   - `'wasm-unsafe-eval'` IS required, exactly as in apps/docs. The two notes
#     that used to stand here ("this app has no WASM playground", "that route
#     does not exist here") were written before the playground was ported in
#     a0960786 and were never revisited. The result: /playground shipped, and
#     every compile died on the LIVE deploy with
#       CompileError: WebAssembly.instantiateStreaming(): ... violates the
#       following Content Security policy directive ... 'unsafe-eval' is not an
#       allowed source of script in ... "script-src 'self' 'unsafe-inline'"
#     while working perfectly in local dev, which serves no _headers at all.
#     Chrome requires this directive to instantiate ANY WebAssembly module; it
#     is much narrower than 'unsafe-eval' and does not permit eval().
#   - still no `/playground` COOP+COEP block, unlike apps/docs. Those exist to
#     enable SharedArrayBuffer; the aihu compiler WASM is single-threaded and
#     does not need them, and `COEP: require-corp` would additionally force
#     every subresource to opt in via CORP — a real risk to the preview iframe
#     for no benefit. CSP was the only actual blocker; verified on the preview.
#   - no `/pagefind/*` block — this app does not ship pagefind.
#   - explicit Content-Type on the extensionless `/.well-known/webmcp` alias,
#     which apps/docs' worker set in code and Pages cannot infer from the name.

/.well-known/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Cache-Control: public, max-age=3600

/.well-known/webmcp
  Content-Type: application/json; charset=utf-8

/llms.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/llms-full.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/ai.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/agents.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/openapi.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/robots.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/sitemap.xml
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: public, max-age=0, must-revalidate
  Link: </.well-known/mcp/server-card.json>; rel="mcp-server", </llms.txt>; rel="ai-content-discovery", </openapi.json>; rel="openapi", </.well-known/agent-card.json>; rel="agent-card"

/*.html
  Cache-Control: public, max-age=0, must-revalidate
  Link: </.well-known/mcp/server-card.json>; rel="mcp-server", </llms.txt>; rel="ai-content-discovery", </openapi.json>; rel="openapi", </.well-known/agent-card.json>; rel="agent-card"

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'none'; object-src 'none'
