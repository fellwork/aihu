@route {
  path: "/docs/[...slug]",
  name: "docs-page"
}

@state {
  import { signal, effect } from '@aihu/signals'

  $prop: {
    route: { type: { params: { slug: string } } },
  }

  // All markdown modules, lazily loaded by Vite's static glob analysis.
  // The keys are relative paths from THIS file's location.
  const mdModules = import.meta.glob('../../content/docs/**/*.md')

  const [html, setHtml] = signal('<p>Loading&hellip;</p>')
  const [notFound, setNotFound] = signal(false)

  $lifecycle.mount {
    return effect(() => {
      const slug = route.params.slug ?? 'introduction'
      const key = `../../content/docs/${slug}.md`
      const loader = mdModules[key]
      if (!loader) {
        setHtml('')
        setNotFound(true)
        return
      }
      setNotFound(false)
      setHtml('<p>Loading&hellip;</p>')
      loader().then((mod: { html: string; title: string; slug: string }) => {
        setHtml(mod.html)
        document.title = `${mod.title} — aihu`
      }).catch(() => {
        setHtml('')
        setNotFound(true)
      })
    })
  }
}

@template {
  <div class="docs-page-content">
    <$show when={notFound()}>
      <p class="not-found">Page not found.</p>
    </$show>
    <$show when={!notFound()}>
      <article>{@html html()}</article>
    </$show>
  </div>
}

@style {
  .docs-page-content {
    width: 100%;
  }

  article {
    max-width: 72ch;
    margin: 0 auto;
  }

  .not-found {
    color: var(--muted);
    font-style: italic;
    padding: 2rem 0;
  }
}
