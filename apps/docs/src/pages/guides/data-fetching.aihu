@route {
  path: "/guides/data-fetching",
  name: "guide-data-fetching",
  layout: "docs",
  head: {
    title: "Data Fetching — aihu",
    description: "The resource() @state intrinsic, createResource from @aihu-plugin/data, server loaders, governed route.data, and streaming routes.",
    canonical: "/guides/data-fetching"
  }
}

@state {
  import { renderMarkdown } from '../../lib/markdown.ts'
  import { DATA_FETCHING } from '../../data/guide-data-fetching.ts'

  const body = renderMarkdown(DATA_FETCHING)
}

@template {
  <div class="dn-guide">
    <p class="dn-sec-num"><b>G · 12</b> guides</p>
    <p class="dn-breadcrumb dn-rail"><a href="/guides/getting-started">Guides</a> / Data Fetching</p>
    <article class="dn-prose dn-article" html={body}></article>
    <nav class="dn-page-nav" aria-label="Guide pagination">
      <a class="dn-page-prev" href="/guides/routing-layouts">
        <span>Previous</span>
        <strong>← Routing &amp; Layouts</strong>
      </a>
      <a class="dn-page-next" href="/guides/ssr-hydration">
        <span>Next</span>
        <strong>SSR &amp; Hydration →</strong>
      </a>
    </nav>
  </div>
}

@style {
  .dn-guide {
    max-width: var(--content-max);
  }
  .dn-guide > .dn-sec-num {
    margin: 0 0 1rem;
  }
  .dn-breadcrumb {
    margin: 0 0 2rem;
  }
  .dn-breadcrumb a {
    color: var(--muted);
  }
  .dn-page-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .dn-page-prev,
  .dn-page-next {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.85rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    text-decoration: none;
    color: var(--fg);
  }
  .dn-page-next {
    align-items: flex-end;
  }
  .dn-page-prev:hover,
  .dn-page-next:hover {
    text-decoration: none;
    border-color: var(--accent-line);
  }
  .dn-page-prev span,
  .dn-page-next span {
    font-size: var(--fs-xs);
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .dn-page-prev strong,
  .dn-page-next strong {
    color: var(--accent-strong);
    font-weight: 600;
  }
}
