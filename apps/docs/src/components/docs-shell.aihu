@state {
  import { signal, effect } from '@aihu/signals'

  // Resolve initial slug from pathname: /docs/introduction → 'introduction'
  // /docs/guides/authoring-components → 'guides/authoring-components'
  // / → 'introduction' (default)
  function slugFromPathname(pathname: string): string {
    const stripped = pathname.replace(/^\/docs\/?/, '')
    return stripped || 'introduction'
  }

  const [activePage, setActivePage] = signal(
    typeof location !== 'undefined'
      ? slugFromPathname(location.pathname)
      : 'introduction'
  )

  // All markdown modules — static glob so Vite can analyze at build time
  const mdModules = import.meta.glob('../content/docs/**/*.md')

  const [activeHtml, setActiveHtml] = signal('<p>Loading content&hellip;</p>')

  // Load markdown for the active page
  if (typeof window !== 'undefined') {
    effect(() => {
      const slug = activePage()
      const key = `../content/docs/${slug}.md`
      const loader = mdModules[key]
      if (!loader) {
        setActiveHtml('<p>Page not found.</p>')
        return
      }
      loader().then((mod: { html: string; title: string; slug: string }) => {
        setActiveHtml(mod.html)
        document.title = `${mod.title} — aihu`
      }).catch(() => {
        setActiveHtml('<p>Failed to load page.</p>')
      })
    })

    // Listen for popstate (back/forward, and our programmatic dispatches)
    window.addEventListener('popstate', () => {
      setActivePage(slugFromPathname(location.pathname))
    })

    // Intercept <a> clicks for in-docs navigation
    document.addEventListener('click', (e: MouseEvent) => {
      const target = (e.target as HTMLElement).closest('a')
      if (!target) return
      const href = target.getAttribute('href')
      if (!href || !href.startsWith('/docs/')) return
      e.preventDefault()
      history.pushState(null, '', href)
      window.dispatchEvent(new PopStateEvent('popstate'))
    })
  }
}

@template {
  <div class="docs-shell">
    <nav class="docs-nav" id="docs-nav" aria-label="Documentation navigation">

      <span class="nav-group-label">Getting Started</span>
      <ul>
        <li><a class="nav-link" href="/docs/introduction" $class:active={activePage() === 'introduction'}>Introduction</a></li>
        <li><a class="nav-link" href="/docs/installation" $class:active={activePage() === 'installation'}>Installation</a></li>
        <li><a class="nav-link" href="/docs/getting-started" $class:active={activePage() === 'getting-started'}>Getting Started</a></li>
        <li><a class="nav-link" href="/docs/playground" $class:active={activePage() === 'playground'}>Playground</a></li>
      </ul>

      <span class="nav-group-label">Core</span>
      <ul>
        <li><a class="nav-link" href="/docs/guides/authoring-components" $class:active={activePage() === 'guides/authoring-components'}>Authoring Components</a></li>
        <li><a class="nav-link" href="/docs/guides/reactivity" $class:active={activePage() === 'guides/reactivity'}>Reactivity</a></li>
        <li><a class="nav-link" href="/docs/guides/authoring-agents" $class:active={activePage() === 'guides/authoring-agents'}>Authoring Agents</a></li>
        <li><a class="nav-link" href="/docs/guides/styling" $class:active={activePage() === 'guides/styling'}>Styling</a></li>
        <li><a class="nav-link" href="/docs/guides/theming" $class:active={activePage() === 'guides/theming'}>Theming</a></li>
        <li><a class="nav-link" href="/docs/guides/primitives" $class:active={activePage() === 'guides/primitives'}>Primitives</a></li>
      </ul>

      <span class="nav-group-label">Advanced</span>
      <ul>
        <li><a class="nav-link" href="/docs/guides/routing-layouts" $class:active={activePage() === 'guides/routing-layouts'}>Routing &amp; Layouts</a></li>
        <li><a class="nav-link" href="/docs/guides/data-fetching" $class:active={activePage() === 'guides/data-fetching'}>Data Fetching</a></li>
        <li><a class="nav-link" href="/docs/guides/authoring-plugins" $class:active={activePage() === 'guides/authoring-plugins'}>Authoring Plugins</a></li>
        <li><a class="nav-link" href="/docs/guides/ssr-hydration" $class:active={activePage() === 'guides/ssr-hydration'}>SSR &amp; Hydration</a></li>
      </ul>

      <span class="nav-group-label">Reference</span>
      <ul>
        <li><a class="nav-link" href="/docs/migration" $class:active={activePage() === 'migration'}>Migration (v0 → v1)</a></li>
        <li><a class="nav-link" href="/docs/guides/deployment" $class:active={activePage() === 'guides/deployment'}>Deployment</a></li>
        <li><a class="nav-link" href="/docs/api-reference" $class:active={activePage() === 'api-reference'}>API Reference</a></li>
      </ul>

      <span class="nav-group-label">Packages</span>
      <ul>
        <li><a class="nav-link" href="/docs/packages/context" $class:active={activePage() === 'packages/context'}>@aihu/context</a></li>
        <li><a class="nav-link" href="/docs/packages/agent-a2a" $class:active={activePage() === 'packages/agent-a2a'}>@aihu/agent-a2a</a></li>
        <li><a class="nav-link" href="/docs/packages/agent-acp" $class:active={activePage() === 'packages/agent-acp'}>@aihu/agent-acp</a></li>
      </ul>

    </nav>
    <main class="docs-content">
      <div class="doc-page-wrapper" $class:is-active={activePage() !== 'playground'}>
        <article>{@html activeHtml()}</article>
      </div>
      <div class="playground-page" $class:is-active={activePage() === 'playground'}>
        <h1>Playground</h1>
        <p class="playground-intro">Edit. Compile. Inspect. All in your browser — powered by the WASM build of <code>aihu-compile</code>.</p>
        <playground-embed></playground-embed>
      </div>
    </main>
  </div>
}

@style {
:host {
  display: block;
  width: 100%;
  max-width: var(--page-max, 1280px);
  margin: 0 auto;
}

.docs-shell {
  display: grid;
  grid-template-columns: var(--sidebar-w, 260px) 1fr;
  gap: 0;
  min-height: calc(100vh - var(--header-h, 64px));
}

.docs-nav {
  border-right: 1px solid var(--border);
  padding: var(--space-6, 1.5rem) 0 var(--space-8, 2rem);
  position: sticky;
  top: var(--header-h, 64px);
  height: calc(100vh - var(--header-h, 64px));
  overflow-y: auto;
  background: var(--bg);
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
}

.nav-link {
  display: block;
  padding: 7px 24px;
  color: var(--muted);
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 450;
  border-left: 2px solid transparent;
  transition: background 0.1s ease, color 0.1s ease, border-color 0.1s ease;
  line-height: 1.4;
}

.nav-link:hover {
  background: var(--hover-bg);
  color: var(--fg);
  text-decoration: none;
  border-left-color: var(--border);
}

.nav-link.active {
  color: var(--accent);
  background: rgba(200, 84, 58, 0.08);
  border-left-color: var(--accent);
  font-weight: 600;
}

:host-context(.dark) .nav-link.active {
  background: rgba(232, 112, 90, 0.12);
}

.docs-content {
  padding: 3rem 3rem 4rem;
  min-width: 0;
  color: var(--fg);
}

.docs-content article {
  max-width: 72ch;
  margin: 0 auto;
}

.docs-content article h1 { margin-top: 0; font-size: 2rem; font-weight: 700; letter-spacing: -0.03em; line-height: 1.2; text-wrap: balance; }
.docs-content article h2 { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; margin-top: 3rem; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border); text-wrap: balance; }
.docs-content article h3 { font-size: 1.25rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.75rem; text-wrap: balance; }
.docs-content article p  { margin: 0 0 1rem; line-height: 1.75; }

.docs-content article pre {
  background: var(--code-bg);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 1.5rem;
  overflow-x: auto;
  font-size: 0.875rem;
  line-height: 1.65;
  margin: 1.5rem 0;
  font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
}

.docs-content article code {
  font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
  background: var(--code-bg);
  border: 1px solid var(--border);
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 0.8125rem;
  color: var(--accent);
}

.docs-content article pre code {
  background: none;
  border: none;
  padding: 0;
  font-size: inherit;
  color: inherit;
}

.docs-content article table {
  border-collapse: collapse;
  width: 100%;
  margin: 1.5rem 0;
  font-size: 0.875rem;
  display: block;
  overflow-x: auto;
}

.docs-content article th,
.docs-content article td {
  border: 1px solid var(--border);
  padding: 10px 16px;
  text-align: left;
  line-height: 1.5;
}

.docs-content article th {
  background: var(--btn-bg);
  font-weight: 600;
  font-size: 0.6875rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--muted);
}

.doc-page-wrapper {
  display: none;
}

.doc-page-wrapper.is-active {
  display: block;
}

.playground-page {
  display: none;
  width: 100%;
}

.playground-page.is-active {
  display: block;
}

.playground-page h1 {
  margin-top: 0;
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.2;
}

.playground-page .playground-intro {
  margin: 0 0 1.5rem;
  color: var(--muted);
  line-height: 1.75;
}

.playground-page .playground-intro code {
  font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
  background: var(--code-bg);
  border: 1px solid var(--border);
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 0.8125rem;
  color: var(--accent);
}

@media (max-width: 768px) {
  .docs-shell {
    grid-template-columns: 1fr;
  }

  .docs-nav {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 280px;
    height: 100%;
    z-index: 150;
    transform: translateX(-100%);
    transition: transform 200ms ease;
    padding-top: calc(var(--header-h, 64px) + 1rem);
    box-shadow: var(--shadow-md, 0 4px 12px rgba(26, 29, 36, 0.1), 0 2px 4px rgba(26, 29, 36, 0.06));
  }

  .docs-nav.open {
    transform: translateX(0);
  }

  .docs-content {
    padding: 2rem 1.5rem 3rem;
  }
}
}
