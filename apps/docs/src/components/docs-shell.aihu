@state {
import { signal, effect } from '@aihu/signals'

const [activePage, setActivePage] = signal(
  typeof location !== 'undefined' && location.hash
    ? location.hash.slice(1)
    : 'introduction'
)

if (typeof window !== 'undefined') {
  window.addEventListener('hashchange', () => {
    setActivePage(location.hash ? location.hash.slice(1) : 'introduction')
  })
}

const activeHtml = () =>
  window.__DOCS__?.[activePage()]?.html ?? '<p>Loading content&hellip;</p>'
}

@template {
  <div class="docs-shell">
    <nav class="docs-nav">
      <ul>
        <li><a class="nav-link" href="#introduction">Introduction</a></li>
        <li><a class="nav-link" href="#installation">Installation</a></li>
        <li><a class="nav-link" href="#getting-started">Getting Started</a></li>
        <li><a class="nav-link" href="#authoring-components">Components</a></li>
        <li><a class="nav-link" href="#reactivity">Reactivity</a></li>
        <li><a class="nav-link" href="#authoring-agents">Agents</a></li>
        <li><a class="nav-link" href="#routing-layouts">Routing + Layouts</a></li>
        <li><a class="nav-link" href="#data-fetching">Data Fetching</a></li>
        <li><a class="nav-link" href="#authoring-plugins">Plugins</a></li>
        <li><a class="nav-link" href="#ssr-hydration">SSR + Hydration</a></li>
        <li><a class="nav-link" href="#deployment">Deployment</a></li>
        <li><a class="nav-link" href="#api-reference">API Reference</a></li>
      </ul>
    </nav>
    <main class="docs-content">
      <article $html={activeHtml()}></article>
    </main>
  </div>
}

@style {
.docs-shell {
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 0;
  min-height: calc(100vh - 60px);
}

.docs-nav {
  border-right: 1px solid var(--border);
  padding: 24px 0;
  position: sticky;
  top: 60px;
  height: calc(100vh - 60px);
  overflow-y: auto;
}

.docs-nav ul {
  list-style: none;
  margin: 0;
  padding: 0;
}

.nav-link {
  display: block;
  padding: 6px 20px;
  color: var(--fg);
  text-decoration: none;
  font-size: .9rem;
  border-left: 3px solid transparent;
  transition: background .1s, border-color .1s;
}

.nav-link:hover {
  background: var(--hover-bg);
  border-left-color: var(--border);
}

.docs-content {
  padding: 40px 48px;
  max-width: 760px;
}

.docs-content article h1 { margin-top: 0; }
.docs-content article pre {
  background: var(--code-bg);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 16px;
  overflow-x: auto;
  font-size: .875rem;
}
.docs-content article code {
  background: var(--code-bg);
  padding: 2px 6px;
  border-radius: 4px;
  font-size: .875rem;
}
.docs-content article pre code { background: none; padding: 0; }
.docs-content article table {
  border-collapse: collapse;
  width: 100%;
  margin: 16px 0;
}
.docs-content article th,
.docs-content article td {
  border: 1px solid var(--border);
  padding: 8px 12px;
  text-align: left;
}
.docs-content article th { background: var(--code-bg); }
}
