@state {
  import { signal, effect } from '@aihu/signals'
  const [activePage, setActivePage] = signal(

  typeof location !== 'undefined' && location.hash

  ? location.hash.slice(1)

  : 'introduction'

  )

  if (typeof window !== 'undefined') {

  window.addEventListener('hashchange', () => {

  setActivePage(location.hash ? location.hash.slice(1) : 'introduction')

  })

  }

  const activeHtml = () =>

  window.__DOCS__?.[activePage()]?.html ?? '<p>Loading content&hellip;</p>'
}

@template {
  <div class="docs-shell">
    <nav class="docs-nav" id="docs-nav" aria-label="Documentation navigation">

      <span class="nav-group-label">Getting Started</span>
      <ul>
        <li><a class="nav-link" href="#introduction" $class:active={activePage() === 'introduction'}>Introduction</a></li>
        <li><a class="nav-link" href="#installation" $class:active={activePage() === 'installation'}>Installation</a></li>
        <li><a class="nav-link" href="#getting-started" $class:active={activePage() === 'getting-started'}>Getting Started</a></li>
        <li><a class="nav-link" href="#playground" $class:active={activePage() === 'playground'}>Playground</a></li>
      </ul>

      <span class="nav-group-label">Guides</span>
      <ul>
        <li><a class="nav-link" href="#guides/authoring-components" $class:active={activePage() === 'guides/authoring-components'}>Authoring Components</a></li>
        <li><a class="nav-link" href="#guides/reactivity" $class:active={activePage() === 'guides/reactivity'}>Reactivity</a></li>
        <li><a class="nav-link" href="#guides/authoring-agents" $class:active={activePage() === 'guides/authoring-agents'}>Authoring Agents</a></li>
        <li><a class="nav-link" href="#guides/styling" $class:active={activePage() === 'guides/styling'}>Styling</a></li>
        <li><a class="nav-link" href="#guides/theming" $class:active={activePage() === 'guides/theming'}>Theming</a></li>
        <li><a class="nav-link" href="#guides/utility-classes" $class:active={activePage() === 'guides/utility-classes'}>Utility Classes</a></li>
        <li><a class="nav-link" href="#guides/primitives" $class:active={activePage() === 'guides/primitives'}>Primitives</a></li>
        <li><a class="nav-link" href="#guides/routing-layouts" $class:active={activePage() === 'guides/routing-layouts'}>Routing &amp; Layouts</a></li>
        <li><a class="nav-link" href="#guides/data-fetching" $class:active={activePage() === 'guides/data-fetching'}>Data Fetching</a></li>
        <li><a class="nav-link" href="#guides/ssr-hydration" $class:active={activePage() === 'guides/ssr-hydration'}>SSR &amp; Hydration</a></li>
        <li><a class="nav-link" href="#guides/agent-discovery" $class:active={activePage() === 'guides/agent-discovery'}>Agent Discovery</a></li>
        <li><a class="nav-link" href="#guides/authoring-plugins" $class:active={activePage() === 'guides/authoring-plugins'}>Authoring Plugins</a></li>
        <li><a class="nav-link" href="#guides/deployment" $class:active={activePage() === 'guides/deployment'}>Deployment</a></li>
      </ul>

      <span class="nav-group-label">Packages</span>
      <ul>
        <li><a class="nav-link" href="#packages/context" $class:active={activePage() === 'packages/context'}>@aihu/context</a></li>
        <li><a class="nav-link" href="#packages/agent-a2a" $class:active={activePage() === 'packages/agent-a2a'}>@aihu/agent-a2a</a></li>
        <li><a class="nav-link" href="#packages/agent-acp" $class:active={activePage() === 'packages/agent-acp'}>@aihu/agent-acp</a></li>
        <li><a class="nav-link" href="#packages/cli" $class:active={activePage() === 'packages/cli'}>@aihu/cli</a></li>
        <li><a class="nav-link" href="#packages/adapter-cloudflare" $class:active={activePage() === 'packages/adapter-cloudflare'}>@aihu/adapter-cloudflare</a></li>
        <li><a class="nav-link" href="#packages/adapter-vercel" $class:active={activePage() === 'packages/adapter-vercel'}>@aihu/adapter-vercel</a></li>
      </ul>

      <span class="nav-group-label">Reference</span>
      <ul>
        <li><a class="nav-link" href="#migration" $class:active={activePage() === 'migration'}>Migration (v0 → v1)</a></li>
        <li><a class="nav-link" href="#api-reference" $class:active={activePage() === 'api-reference'}>API Reference</a></li>
      </ul>

    </nav>
    <main class="docs-content">
      <div class="doc-page-wrapper" $class:is-active={activePage() !== 'playground'}>
        <article>{@html activeHtml()}</article>
      </div>
      <div class="playground-page" $class:is-active={activePage() === 'playground'}>
        <h1>Playground</h1>
        <p class="playground-intro">Edit. Compile. Inspect. All in your browser — powered by the WASM build of <code>aihu-compile</code>.</p>
        <playground-embed></playground-embed>
      </div>
    </main>
  </div>
}

@style {
:host {
  display: block;
  width: 100%;
  max-width: var(--page-max, 1280px);
  margin: 0 auto;
}

.docs-shell {
  display: grid;
  grid-template-columns: var(--sidebar-w, 260px) 1fr;
  gap: 0;
  min-height: calc(100vh - var(--header-h, 64px));
}

.docs-nav {
  border-right: 1px solid var(--border);
  padding: var(--space-6, 1.5rem) 0 var(--space-8, 2rem);
  position: sticky;
  top: var(--header-h, 64px);
  height: calc(100vh - var(--header-h, 64px));
  overflow-y: auto;
  background: var(--bg);
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
}

.nav-link {
  display: block;
  padding: 7px 24px;
  color: var(--muted);
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 450;
  border-left: 2px solid transparent;
  transition: background 0.1s ease, color 0.1s ease, border-color 0.1s ease;
  line-height: 1.4;
}

.nav-link:hover {
  background: var(--hover-bg);
  color: var(--fg);
  text-decoration: none;
  border-left-color: var(--border);
}

.nav-link.active {
  color: var(--accent);
  background: rgba(200, 84, 58, 0.08);
  border-left-color: var(--accent);
  font-weight: 600;
}

:host-context(.dark) .nav-link.active {
  background: rgba(232, 112, 90, 0.12);
}

.docs-content {
  padding: 3rem 3rem 4rem;
  min-width: 0;
  color: var(--fg);
}

.docs-content article {
  max-width: 72ch;
  margin: 0 auto;
}

.docs-content article h1 { margin-top: 0; font-size: 2rem; font-weight: 700; letter-spacing: -0.03em; line-height: 1.2; text-wrap: balance; }
.docs-content article h2 { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; margin-top: 3rem; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border); text-wrap: balance; }
.docs-content article h3 { font-size: 1.25rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.75rem; text-wrap: balance; }
.docs-content article p  { margin: 0 0 1rem; line-height: 1.75; }

.docs-content article pre {
  background: var(--code-bg);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 1.5rem;
  overflow-x: auto;
  font-size: 0.875rem;
  line-height: 1.65;
  margin: 1.5rem 0;
  font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
}

.docs-content article code {
  font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
  background: var(--code-bg);
  border: 1px solid var(--border);
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 0.8125rem;
  color: var(--accent);
}

.docs-content article pre code {
  background: none;
  border: none;
  padding: 0;
  font-size: inherit;
  color: inherit;
}

/* ── Baked syntax-highlight palette (kn-*) ──────────────────────────
 * @aihu-plugin/kindly-note bakes kn-* spans into <pre><code> at BUILD TIME
 * (see apps/docs/build.ts). Those spans render inside THIS component's SHADOW
 * DOM, so global style.css cannot reach them — the palette MUST live here.
 * Selectors are flat (the emitter does not wrap output in a `.kn` root) and
 * keyed off the warm brand colors that previously lived in style.css's hljs
 * block. Only TypeScript/JSON fences carry kn-* spans today (those lang packs
 * exist on the registry); bash/css/html fences render as uncolored escaped text
 * until @kindly-note/lang-{bash,css,html} ship. */
.docs-content article pre code .kn-keyword,
.docs-content article pre code .kn-built_in,
.docs-content article pre code .kn-tag,
.docs-content article pre code .kn-name,
.docs-content article pre code .kn-symbol { color: #c8543a; }
.docs-content article pre code .kn-string,
.docs-content article pre code .kn-attr,
.docs-content article pre code .kn-meta { color: #6b9e5e; }
.docs-content article pre code .kn-comment { color: #9e9890; font-style: italic; }
.docs-content article pre code .kn-number,
.docs-content article pre code .kn-literal { color: #4f88c4; }
.docs-content article pre code .kn-title,
.docs-content article pre code .kn-function,
.docs-content article pre code .kn-type { color: #7b5ea8; }
.docs-content article pre code .kn-variable,
.docs-content article pre code .kn-params,
.docs-content article pre code .kn-punctuation { color: #5a5a55; }

:host-context(.dark) .docs-content article pre code .kn-keyword,
:host-context(.dark) .docs-content article pre code .kn-built_in,
:host-context(.dark) .docs-content article pre code .kn-tag,
:host-context(.dark) .docs-content article pre code .kn-name,
:host-context(.dark) .docs-content article pre code .kn-symbol { color: #e8705a; }
:host-context(.dark) .docs-content article pre code .kn-string,
:host-context(.dark) .docs-content article pre code .kn-attr,
:host-context(.dark) .docs-content article pre code .kn-meta { color: #88c07a; }
:host-context(.dark) .docs-content article pre code .kn-comment { color: #6e6860; font-style: italic; }
:host-context(.dark) .docs-content article pre code .kn-number,
:host-context(.dark) .docs-content article pre code .kn-literal { color: #79aee0; }
:host-context(.dark) .docs-content article pre code .kn-title,
:host-context(.dark) .docs-content article pre code .kn-function,
:host-context(.dark) .docs-content article pre code .kn-type { color: #b08ad8; }
:host-context(.dark) .docs-content article pre code .kn-variable,
:host-context(.dark) .docs-content article pre code .kn-params,
:host-context(.dark) .docs-content article pre code .kn-punctuation { color: #9e9890; }

.docs-content article table {
  border-collapse: collapse;
  width: 100%;
  margin: 1.5rem 0;
  font-size: 0.875rem;
  display: block;
  overflow-x: auto;
}

.docs-content article th,
.docs-content article td {
  border: 1px solid var(--border);
  padding: 10px 16px;
  text-align: left;
  line-height: 1.5;
}

.docs-content article th {
  background: var(--btn-bg);
  font-weight: 600;
  font-size: 0.6875rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--muted);
}

.doc-page-wrapper {
  display: none;
}

.doc-page-wrapper.is-active {
  display: block;
}

.playground-page {
  display: none;
  width: 100%;
}

.playground-page.is-active {
  display: block;
}

.playground-page h1 {
  margin-top: 0;
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.2;
}

.playground-page .playground-intro {
  margin: 0 0 1.5rem;
  color: var(--muted);
  line-height: 1.75;
}

.playground-page .playground-intro code {
  font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
  background: var(--code-bg);
  border: 1px solid var(--border);
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 0.8125rem;
  color: var(--accent);
}

@media (max-width: 768px) {
  .docs-shell {
    grid-template-columns: 1fr;
  }

  .docs-nav {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 280px;
    height: 100%;
    z-index: 150;
    transform: translateX(-100%);
    transition: transform 200ms ease;
    padding-top: calc(var(--header-h, 64px) + 1rem);
    box-shadow: var(--shadow-md, 0 4px 12px rgba(26, 29, 36, 0.1), 0 2px 4px rgba(26, 29, 36, 0.06));
  }

  .docs-nav.open {
    transform: translateX(0);
  }

  .docs-content {
    padding: 2rem 1.5rem 3rem;
  }
}
}
