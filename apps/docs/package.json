{
  "name": "aihu-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "bun ../../scripts/build-wasm-bundle.ts dist/wasm",
    "build": "bun run build.ts",
    "bundle": "rolldown -c rolldown.config.ts",
    "dev": "bun run build && bunx wrangler pages dev dist/ --port 8788 --compatibility-date=2026-05-28",
    "dev:watch": "bun run build && concurrently \"bunx rolldown -c rolldown.config.ts --watch\" \"bunx wrangler pages dev dist/ --port 8788 --compatibility-date=2026-05-28\"",
    "test:e2e": "bunx playwright test"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@kindly-note/core": "^0.2.0",
    "@kindly-note/emitters-html": "^0.1.0",
    "@kindly-note/emitters-markdown": "^0.1.0",
    "@kindly-note/lang-json": "^0.1.0",
    "@kindly-note/lang-markdown": "^0.1.0",
    "@kindly-note/lang-typescript": "^0.1.0",
    "@kindly-note/render-markdown": "^0.1.0",
    "@playwright/test": "^1.50.0",
    "concurrently": "^9.0.0"
  },
  "dependencies": {
    "@aihu/adapter-cloudflare": "workspace:*",
    "@aihu-plugin/agent-readiness": "workspace:*",
    "@aihu-plugin/kindly-note": "workspace:*",
    "@aihu/server": "workspace:*",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.0",
    "marked": "^15.0.0"
  }
}
