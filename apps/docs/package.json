{
  "name": "aihu-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "bun ../../scripts/fetch-wasm-bundle.ts dist/wasm",
    "build": "bun run build.ts",
    "bundle": "rolldown -c rolldown.config.ts",
    "dev": "bun run build && bunx wrangler pages dev dist/ --port 8788",
    "dev:watch": "bun run build && concurrently \"bunx rolldown -c rolldown.config.ts --watch\" \"bunx wrangler pages dev dist/ --port 8788\"",
    "test:e2e": "bunx playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "concurrently": "^9.0.0"
  },
  "dependencies": {
    "@aihu/adapter-cloudflare": "workspace:*",
    "@aihu/agent-readiness": "workspace:*",
    "@aihu/server": "workspace:*",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.0",
    "marked": "^15.0.0"
  }
}
