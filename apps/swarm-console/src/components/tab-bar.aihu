// tab-bar — the section-as-pages nav (founder brief: "move the sections
// onto separate pages linked by a tab header"). Sits directly under
// swarm-header, sticky so it (and swarm-header above it) "stays visible on
// every tab" while a paginated list scrolls. Reads the shared `swarm`
// singleton + the `activeTab` route signal directly from
// ../lib/swarm-store.ts — the same "no props" convention every other
// section already follows (see that module's doc comment for why).
//
// Routing: plain `<a href="#/…">` anchors — the browser's native same-page
// hash navigation already fires a real `hashchange` event (the same
// mechanism apps/docs/src/components/docs-shell.aihu's nav relies on), which
// swarm-store.ts's own `hashchange` listener picks up. No `on:click`/JS nav
// needed.
//
// Design: `.tastemaker/style-lock.md` — the active tab reads as an ink
// underline (a quiet state), NOT terracotta (terracotta stays reserved for
// the logo dot + live pulse, per the lock's placement rule). Active/inactive
// are precomputed COMPLETE class-string constants (the same
// `dotClasses(live)`-style branch-is-a-literal pattern format.ts documents
// and uses throughout this app) rather than Tailwind's `class:name={cond}`
// toggle directive, so an active tab never carries both `text-muted` and
// `text-ink` at once (a real cascade-order hazard the toggle directive would
// otherwise create here).
//
// The "Your Move" warning badge IS a legal state-color use (it signals
// "there is something to act on"), scoped to exactly that label.

@state {
  import { swarm } from '../lib/swarm-store.ts'
  import { activeTab } from '../lib/swarm-store.ts'
  import { arr, chipClasses } from '../lib/format.ts'

  const swarmState = swarm.state

  const isYourMove = derived(() => activeTab() === 'your-move')
  const isContracts = derived(() => activeTab() === 'contracts')
  const isAgents = derived(() => activeTab() === 'agents')
  const isActivity = derived(() => activeTab() === 'activity')

  const TAB_BASE =
    'inline-flex items-center gap-2 h-full border-b-2 motion-safe:transition-colors motion-safe:duration-150'
  const TAB_ACTIVE = `${TAB_BASE} border-ink text-ink font-medium`
  const TAB_INACTIVE = `${TAB_BASE} border-transparent text-muted hover:text-ink`

  const yourMoveClasses = derived(() => (isYourMove() ? TAB_ACTIVE : TAB_INACTIVE))
  const contractsClasses = derived(() => (isContracts() ? TAB_ACTIVE : TAB_INACTIVE))
  const agentsClasses = derived(() => (isAgents() ? TAB_ACTIVE : TAB_INACTIVE))
  const activityClasses = derived(() => (isActivity() ? TAB_ACTIVE : TAB_INACTIVE))

  // Mirrors your-move.aihu's own "anything to act on" count (decide +
  // orphan + errors — NOT reviews, which need visibility but aren't a
  // pending decision) so the badge and the section it points at never
  // disagree about what counts as "your move".
  const actionCount = derived(
    () =>
      arr(swarmState().decide).length +
      arr(swarmState().orphan).length +
      arr(swarmState().errors).length,
  )
  const showBadge = derived(() => actionCount() > 0 && !isYourMove())
  const badgeClasses = chipClasses('warning')
}

@template {
  <nav class="sticky top-[52px] z-[9] h-[44px] bg-bg border-b border-border" aria-label="Console sections">
    <div class="max-w-[1160px] h-full mx-auto px-4 sm:px-6 flex items-center gap-6 font-mono text-xs tracking-[0.04em] uppercase">
      <a href="#/your-move" class={yourMoveClasses}>
        <span>your move</span>
        <span class={badgeClasses} if={showBadge}>{actionCount}</span>
      </a>
      <a href="#/contracts" class={contractsClasses}>contracts</a>
      <a href="#/agents" class={agentsClasses}>agents</a>
      <a href="#/activity" class={activityClasses}>activity</a>
    </div>
  </nav>
}
