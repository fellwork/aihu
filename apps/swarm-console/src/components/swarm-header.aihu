// swarm-header — mark, wordmark, stream-freshness chip, supervisor live-dot.
// Reads the shared `swarm`/`clock` singletons directly (../lib/swarm-store.ts)
// rather than a prop from the root — see that module's doc comment for why.
//
// Design: `.tastemaker/style-lock.md`. Terracotta is used ONLY for identity +
// liveness (the mark's dot, the live-status dot's pulse) — never decoration.
// The stale-stream chip is a state color (warning) used only to signal state.

@state {
  import { swarm, clock } from '../lib/swarm-store.ts'
  import { watch } from '@aihu/use/watch'
  import { bool, chipClasses, dotClasses } from '../lib/format.ts'

  const swarmState = swarm.state
  const swarmConnected = swarm.connected
  const now = clock.now

  // `state().t === 0` is the documented "no frame yet" sentinel (useSwarm's
  // SSR/pre-connect default).
  const hasData = derived(() => swarmState().t !== 0)

  // Wall-clock timestamp of the most recently received frame. `watch` fires
  // on every `state()` identity change (i.e. every SSE frame), and
  // `immediate: true` seeds it at mount so `stale` has a baseline before the
  // first frame too.
  let lastFrameAt = state(Date.now())
  watch(
    swarmState,
    () => {
      lastFrameAt = Date.now()
    },
    { immediate: true },
  )

  // "stream stale — data frozen": no frame in >5s, OR the SSE connection
  // itself dropped after already having data. Only meaningful once we've
  // received at least one frame — before that we're "connecting", not stale.
  const stale = derived(
    () => hasData() && (!swarmConnected() || now().getTime() - lastFrameAt() > 5000),
  )

  const supervisorUp = derived(() => bool(swarmState().supervisor_up))

  const liveLabel = derived(() =>
    !hasData() ? 'connecting…' : supervisorUp() ? 'live' : 'supervisor down',
  )

  const liveDotClasses = derived(() => dotClasses(supervisorUp()))
  const staleChipClasses = chipClasses('warning')
}

@template {
  <header class="sticky top-0 z-10 h-[52px] bg-bg border-b border-border">
    <div class="max-w-[1160px] h-full mx-auto px-4 sm:px-6 flex items-center justify-between gap-4">
      <div class="inline-flex items-center gap-2 text-ink min-w-0">
        <svg class="text-ink flex-none" width="20" height="20" viewBox="0 0 100 100" fill="none" aria-hidden="true">
          <path d="M 18 30 L 18 56 a 32 32 0 0 0 64 0 L 82 30" stroke="currentColor" stroke-width="14" fill="none" stroke-linecap="butt"></path>
          <circle cx="50" cy="16" r="9" fill="var(--color-accent)"></circle>
        </svg>
        <span class="font-semibold text-md tracking-tight whitespace-nowrap">swarm console</span>
      </div>
      <div class="inline-flex items-center gap-3">
        <span class={staleChipClasses} if={stale}>stream stale — data frozen</span>
        <span class="inline-flex items-center gap-2 font-mono text-xs text-muted whitespace-nowrap">
          <span class={liveDotClasses}></span>
          <span>{liveLabel}</span>
        </span>
      </div>
    </div>
  </header>
}
