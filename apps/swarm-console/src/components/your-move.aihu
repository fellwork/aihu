// your-move — decide cards + review rows + errors + empty state. The
// dominant zone of the console (design brief: "YOUR MOVE dominant;
// CONTRACTS/AGENTS recede; ACTIVITY quietest"). Reads the shared `swarm`
// singleton directly (../lib/swarm-store.ts) rather than a prop from the
// root — see that module's doc comment for why.
//
// Review rows are a REAL native `<table>` (`<thead>`/`<tbody>`/`<tr>`/
// `<th>`/`<td>`), not the `role="table"`/`row`/`cell` CSS-grid-of-divs an
// intermediate pass used — see contracts-ledger.aihu's module doc comment
// for the root-cause writeup (per-row independent grid + `items-center` let
// a shorter-content cell's border float above its siblings'; a native
// `<tr>` gives every `<td>` the row's shared height by construction, so
// this can't recur — a review with no PR link, e.g. a "verdict only" row,
// keeps its remaining cells aligned with every other row). Before that: the
// old flex row let variable-width id+owner text push the status column to a
// different x-position on every row (founder feedback) — `table-fixed` +
// explicit `w-*` widths on `<th>` fix that too. DECIDE cards below stay
// cards (prose questions, not tabular data) — only the review list is a
// table. Paginated at REVIEWS_PAGE_SIZE (../lib/swarm-store.ts) — founder
// addendum: "usually short; cap at ~10 with pager if more", resets to page
// 1 on every tab switch (swarm-store's shared hashchange listener).

@state {
  import { swarm, REVIEWS_PAGE_SIZE, goToReviewsPage, reviewsPage } from '../lib/swarm-store.ts'
  import {
    arr,
    chipClasses,
    firstLine,
    neutralTextClasses,
    prHref,
    reviewTag,
    str,
  } from '../lib/format.ts'

  type Rec = Record<string, unknown>

  const swarmState = swarm.state

  const decideRows = derived(() => {
    const mapOne = (d: Rec, i: number, src: string) => ({
      key: `${src}-${str(d.contract, String(i))}`,
      from: str(d.from ?? d.owner, 'unknown'),
      contract: str(d.contract, '—'),
      age: str(d.ago ?? d.age, ''),
      question: str(d.question ?? d.text, '(no question text)'),
    })
    const decide = (arr(swarmState().decide) as Rec[]).map((d, i) => mapOne(d, i, 'decide'))
    const orphan = (arr(swarmState().orphan) as Rec[]).map((d, i) => mapOne(d, i, 'orphan'))
    return [...decide, ...orphan]
  })

  // NOTE: written as a direct `computed(...)` call, not the `derived(...)`
  // sugar used everywhere else in this file — inherited from the pre-split
  // swarm-console.aihu's own known compiler quirk (packages/compiler's
  // state_wrappers scanner left THIS PARTICULAR `derived(...)` call
  // un-lowered in that file's context; `computed` is the exact primitive
  // `derived(...)` lowers to, so this is behaviorally identical).
  const allReviewRows = computed(() =>
    (arr(swarmState().reviews) as Rec[]).map((r, i) => {
      const tag = reviewTag(r.status)
      const pr = r.pr
      // Locals, not inline object-literal values — the compiler's
      // reactive-declaration scanner mis-reads an object property whose
      // value is a bare comparison/ternary as an un-`let`'d state decl.
      const isChip = tag.tone !== 'neutral'
      const prLabel = typeof pr === 'string' ? pr : ''
      const tagClasses = chipClasses(tag.tone)
      const neutralClasses = neutralTextClasses(tag.tone)
      return {
        key: `review-${str(r.contract, String(i))}`,
        contract: str(r.contract, '—'),
        owner: str(r.owner, '—'),
        tagLabel: tag.label,
        tagTitle: tag.title,
        isChip,
        tagClasses,
        neutralClasses,
        prLabel,
        prHref: prHref(pr),
      }
    }),
  )

  const totalReviews = derived(() => allReviewRows().length)
  const totalReviewPages = derived(() => Math.max(1, Math.ceil(totalReviews() / REVIEWS_PAGE_SIZE)))
  const reviewPage = derived(() => Math.min(reviewsPage(), totalReviewPages()))
  const reviewPageStart = derived(() => (reviewPage() - 1) * REVIEWS_PAGE_SIZE)
  const reviewRows = derived(() =>
    allReviewRows().slice(reviewPageStart(), reviewPageStart() + REVIEWS_PAGE_SIZE),
  )
  const reviewRangeStart = derived(() => (totalReviews() === 0 ? 0 : reviewPageStart() + 1))
  const reviewRangeEnd = derived(() =>
    Math.min(reviewPageStart() + REVIEWS_PAGE_SIZE, totalReviews()),
  )
  const showReviewPager = derived(() => totalReviews() > REVIEWS_PAGE_SIZE)
  const reviewHasPrev = derived(() => reviewPage() > 1)
  const reviewHasNext = derived(() => reviewPage() < totalReviewPages())
  const prevReviewPage = () => goToReviewsPage(Math.max(1, reviewPage() - 1))
  const nextReviewPage = () => goToReviewsPage(Math.min(totalReviewPages(), reviewPage() + 1))

  const errorRows = derived(() =>
    (arr(swarmState().errors) as Rec[]).map((e, i) => ({
      key: `error-${str(e.contract, String(i))}`,
      contract: str(e.contract, ''),
      message: firstLine(e),
    })),
  )

  const yourMoveEmpty = derived(
    () => decideRows().length === 0 && allReviewRows().length === 0 && errorRows().length === 0,
  )
}

@template {
  <section class="mb-12" aria-label="Your move">
    <p class="font-mono text-xs font-medium tracking-[0.12em] uppercase text-muted mb-4 pb-2 border-b border-border">your move</p>

    <p class="text-muted text-sm py-2" if={yourMoveEmpty}>nothing needs you</p>

    <div class="grid gap-6" if={!yourMoveEmpty}>
      <article class="border-l-2 border-warning p-6 bg-surface" each={d of decideRows} key={d.key}>
        <div class="flex items-baseline gap-4 mb-2 text-xs text-muted max-sm:flex-wrap">
          <span class="font-mono tabular-nums text-ink font-[550]">{d.from}</span>
          <span class="font-mono tabular-nums">{d.contract}</span>
          <span class="ml-auto">{d.age}</span>
        </div>
        <p class="text-base leading-relaxed text-ink">{d.question}</p>
      </article>

      <div if={totalReviews > 0}>
        <table class="w-full table-fixed border-collapse" aria-label="Review queue">
          <thead>
            <tr>
              <th scope="col" class="w-36 text-left font-mono text-xs font-medium tracking-[0.04em] uppercase text-muted pb-2 border-b border-border">contract</th>
              <th scope="col" class="w-28 text-left font-mono text-xs font-medium tracking-[0.04em] uppercase text-muted pb-2 border-b border-border">owner</th>
              <th scope="col" class="w-32 text-left font-mono text-xs font-medium tracking-[0.04em] uppercase text-muted pb-2 border-b border-border">status</th>
              <th scope="col" class="text-right font-mono text-xs font-medium tracking-[0.04em] uppercase text-muted pb-2 border-b border-border">pr</th>
            </tr>
          </thead>
          <!-- Every row renders every <td>, always — no cell is ever
               conditionally omitted. A review with no PR (a "verdict
               only" row) still gets its 4th <td>; only the INNER content
               of that cell is if/if-gated between a link and the
               "verdict only — read it" affordance text, same for the
               status cell's chip-vs-neutral-text branches — the <td>
               itself is unconditional in both cases. -->
          <tbody>
            <tr each={r of reviewRows} key={r.key}>
              <td class="align-middle font-mono tabular-nums text-ink py-4 border-b border-border">{r.contract}</td>
              <td class="align-middle text-muted text-sm py-4 border-b border-border">{r.owner}</td>
              <td class="align-middle py-4 border-b border-border">
                <span class={r.tagClasses} if={r.isChip} title={r.tagTitle}>{r.tagLabel}</span>
                <span class={r.neutralClasses} if={!r.isChip} title={r.tagTitle}>{r.tagLabel}</span>
              </td>
              <td class="align-middle text-right py-4 border-b border-border">
                <a class="font-mono tabular-nums text-ink hover:text-accent" if={r.prHref} href={r.prHref} target="_blank" rel="noopener noreferrer">{r.prLabel}</a>
                <span class="text-muted text-xs" if={!r.prHref}>verdict only — read it</span>
              </td>
            </tr>
          </tbody>
        </table>
        <div class="flex items-center gap-4 pt-3 font-mono text-xs text-muted" if={showReviewPager}>
          <span class="tabular-nums">{reviewRangeStart}–{reviewRangeEnd} of {totalReviews}</span>
          <button type="button" class="hover:text-ink disabled:opacity-40 disabled:pointer-events-none motion-safe:transition-colors motion-safe:duration-150" on:click={prevReviewPage} disabled={!reviewHasPrev} aria-label="Previous page of reviews">‹</button>
          <button type="button" class="hover:text-ink disabled:opacity-40 disabled:pointer-events-none motion-safe:transition-colors motion-safe:duration-150" on:click={nextReviewPage} disabled={!reviewHasNext} aria-label="Next page of reviews">›</button>
        </div>
      </div>

      <ul class="list-none grid" if={errorRows.length > 0}>
        <li class="flex items-baseline gap-3 py-3 border-b border-border" each={e of errorRows} key={e.key}>
          <code class="font-mono tabular-nums text-destructive flex-none" if={e.contract}>{e.contract}</code>
          <span class="text-destructive text-sm">{e.message}</span>
        </li>
      </ul>
    </div>
  </section>
}
