// activity-log — the history list. The quietest zone (design brief:
// "ACTIVITY quietest"). Now its own tab/page (founder: "sections as
// pages"). Reads the shared `swarm` singleton directly
// (../lib/swarm-store.ts) rather than a prop from the root — see that
// module's doc comment for why.
//
// A real fixed-column CSS grid (ago / from→to / kind / contract) — the
// original flex row only fixed the width of its first two columns
// (`w-[4.5rem]`/`min-w-[10rem]`); `kind` had no fixed width, so it (and
// `contract` right after it) drifted per row depending on `kind`'s own text
// length. Same alignment mechanism as your-move/contracts-ledger/
// agents-roster. Paginated at ACTIVITY_PAGE_SIZE (../lib/swarm-store.ts) —
// founder addendum: "show the most recent ~15 with the same pager", resets
// to page 1 on every tab switch (swarm-store's shared hashchange listener).

@state {
  import { swarm, ACTIVITY_PAGE_SIZE, activityPage, goToActivityPage } from '../lib/swarm-store.ts'
  import { arr, str } from '../lib/format.ts'

  type Rec = Record<string, unknown>

  const swarmState = swarm.state

  const allActivityRows = derived(() =>
    (arr(swarmState().activity) as Rec[]).map((e, i) => ({
      key: `activity-${i}-${str(e.contract, '')}`,
      ago: str(e.ago, ''),
      from: str(e.from, ''),
      to: str(e.to, ''),
      kind: str(e.kind, ''),
      contract: str(e.contract, ''),
    })),
  )

  const totalActivity = derived(() => allActivityRows().length)
  const totalActivityPages = derived(() =>
    Math.max(1, Math.ceil(totalActivity() / ACTIVITY_PAGE_SIZE)),
  )
  const activityPageClamped = derived(() => Math.min(activityPage(), totalActivityPages()))
  const activityPageStart = derived(() => (activityPageClamped() - 1) * ACTIVITY_PAGE_SIZE)
  const activityRows = derived(() =>
    allActivityRows().slice(activityPageStart(), activityPageStart() + ACTIVITY_PAGE_SIZE),
  )
  const activityRangeStart = derived(() => (totalActivity() === 0 ? 0 : activityPageStart() + 1))
  const activityRangeEnd = derived(() =>
    Math.min(activityPageStart() + ACTIVITY_PAGE_SIZE, totalActivity()),
  )
  const showActivityPager = derived(() => totalActivity() > ACTIVITY_PAGE_SIZE)
  const activityHasPrev = derived(() => activityPageClamped() > 1)
  const activityHasNext = derived(() => activityPageClamped() < totalActivityPages())
  const prevActivityPage = () => goToActivityPage(Math.max(1, activityPageClamped() - 1))
  const nextActivityPage = () =>
    goToActivityPage(Math.min(totalActivityPages(), activityPageClamped() + 1))

  const ACTIVITY_COLS = 'grid grid-cols-[4.5rem_11rem_7rem_1fr] gap-x-6 items-baseline'
}

@template {
  <section aria-label="History">
    <p class="font-mono text-xs font-medium tracking-[0.12em] uppercase text-muted mb-4 pb-2 border-b border-border">history</p>
    <p class="text-muted text-sm py-2" if={totalActivity === 0}>no activity yet</p>

    <div if={totalActivity > 0}>
      <div class={ACTIVITY_COLS} role="row">
        <span role="columnheader" class="font-mono text-xs font-medium tracking-[0.04em] uppercase text-muted pb-2 border-b border-border">ago</span>
        <span role="columnheader" class="font-mono text-xs font-medium tracking-[0.04em] uppercase text-muted pb-2 border-b border-border">from → to</span>
        <span role="columnheader" class="font-mono text-xs font-medium tracking-[0.04em] uppercase text-muted pb-2 border-b border-border">kind</span>
        <span role="columnheader" class="font-mono text-xs font-medium tracking-[0.04em] uppercase text-muted pb-2 border-b border-border">contract</span>
      </div>
      <div role="table">
        <div class={ACTIVITY_COLS} role="row" each={e of activityRows} key={e.key}>
          <span role="cell" class="font-mono tabular-nums py-3 border-b border-border text-muted text-xs">{e.ago}</span>
          <span role="cell" class="font-mono tabular-nums py-3 border-b border-border text-muted text-xs">{e.from} → {e.to}</span>
          <span role="cell" class="font-mono tabular-nums py-3 border-b border-border text-muted text-xs">{e.kind}</span>
          <span role="cell" class="font-mono tabular-nums py-3 border-b border-border text-muted text-xs">{e.contract}</span>
        </div>
      </div>
      <div class="flex items-center gap-4 pt-3 font-mono text-xs text-muted" if={showActivityPager}>
        <span class="tabular-nums">{activityRangeStart}–{activityRangeEnd} of {totalActivity}</span>
        <button type="button" class="hover:text-ink disabled:opacity-40 disabled:pointer-events-none motion-safe:transition-colors motion-safe:duration-150" on:click={prevActivityPage} disabled={!activityHasPrev} aria-label="Previous page of activity">‹</button>
        <button type="button" class="hover:text-ink disabled:opacity-40 disabled:pointer-events-none motion-safe:transition-colors motion-safe:duration-150" on:click={nextActivityPage} disabled={!activityHasNext} aria-label="Next page of activity">›</button>
      </div>
    </div>
  </section>
}
