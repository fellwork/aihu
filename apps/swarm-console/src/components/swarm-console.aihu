// swarm-console — the whole ops surface, as one root component (the same
// single-file shape as examples/realtime-scores, examples/weather-card:
// this is a single-view app-shell, not a multi-page site, so there is no
// @aihu/app file-router here — see ../../vite.config.ts).
//
// The ONLY data source is `useSwarm()` (@aihu/use/useSwarm), which opens
// the swarm bus's `/stream` SSE connection and keeps a signal in sync. This
// component does no fetching of its own and touches no other endpoint.
//
// Design: `.tastemaker/style-lock.md` "Datasheet for a living framework",
// applied to an ops surface per the founder brief — instrument-grade, calm,
// hairline rules instead of boxes-everywhere, tabular-nums, Geist Mono for
// data/labels. Terracotta is used ONLY for identity + liveness (the mark's
// dot, the header's live-pulse dot, the agent roster's live-pulse dot) —
// never for decoration. State tones (success/warning/destructive/neutral)
// are used ONLY where they signal state (chips, flags, the stale banner).

@state {
  import { useSwarm } from '@aihu/use/useSwarm'
  import { useNow } from '@aihu/use/useNow'
  import { watch } from '@aihu/use/watch'
  import {
    arr,
    bool,
    contractTag,
    firstLine,
    prHref,
    reviewTag,
    str,
    truncate,
  } from '../lib/format.ts'

  type Rec = Record<string, unknown>

  // The one and only data source — SSE-backed, SSR-safe (see useSwarm's own
  // module doc for the isClient no-op invariant this component inherits).
  const swarm = useSwarm()
  const swarmState = swarm.state
  const swarmConnected = swarm.connected

  // A 1s tick, used only to re-evaluate "has it been >5s since the last
  // frame" — the freshness check needs a clock independent of the bus.
  const clock = useNow({ interval: 1000 })
  const now = clock.now

  // `state().t === 0` is the documented "no frame yet" sentinel (useSwarm's
  // SSR/pre-connect default). Everything below the header stays in the
  // connecting/skeleton state until this flips.
  const hasData = derived(() => swarmState().t !== 0)

  // Wall-clock timestamp of the most recently received frame. `watch`
  // fires on every `state()` identity change (i.e. every SSE frame), and
  // `immediate: true` seeds it at mount so `stale` has a baseline before
  // the first frame too.
  let lastFrameAt = state(Date.now())
  watch(
    swarmState,
    () => {
      lastFrameAt = Date.now()
    },
    { immediate: true },
  )

  // "stream stale — data frozen": no frame in >5s, OR the SSE connection
  // itself dropped after already having data. Only meaningful once we've
  // received at least one frame — before that we're "connecting", not stale.
  const stale = derived(
    () => hasData() && (!swarmConnected() || now().getTime() - lastFrameAt() > 5000),
  )

  const supervisorUp = derived(() => bool(swarmState().supervisor_up))

  const liveLabel = derived(() =>
    !hasData() ? 'connecting…' : supervisorUp() ? 'live' : 'supervisor down',
  )

  // ---------------------------------------------------------------------
  // YOUR MOVE — decide (+ orphan, grouped identically per useSwarm's own
  // "what needs a move" doc comment), reviews, errors.
  // ---------------------------------------------------------------------

  const decideRows = derived(() => {
    const mapOne = (d: Rec, i: number, src: string) => ({
      key: `${src}-${str(d.contract, String(i))}`,
      from: str(d.from ?? d.owner, 'unknown'),
      contract: str(d.contract, '—'),
      age: str(d.ago ?? d.age, ''),
      question: str(d.question ?? d.text, '(no question text)'),
    })
    const decide = (arr(swarmState().decide) as Rec[]).map((d, i) => mapOne(d, i, 'decide'))
    const orphan = (arr(swarmState().orphan) as Rec[]).map((d, i) => mapOne(d, i, 'orphan'))
    return [...decide, ...orphan]
  })

  // NOTE: written as a direct `computed(...)` call, not the `derived(...)`
  // sugar used everywhere else in this file. `computed` is already
  // auto-imported from `@aihu/signals` by the compiler (every other
  // `derived(...)` binding below pulls it in) and is the exact primitive
  // `derived(...)` lowers to, so this is behaviorally identical — it works
  // around a compiler bug (packages/compiler's state_wrappers scanner)
  // where THIS PARTICULAR `derived(...)` call, in the context of this file,
  // was left un-lowered in the compiled output (`derived is not defined` at
  // runtime, since only `computed` is ever imported). Isolated minimal
  // repros of this exact body compiled fine standalone, so the trigger is
  // some interaction with the rest of the file, not this shape in
  // isolation — filed as a known compiler quirk, not re-litigated here.
  const reviewRows = computed(() =>
    (arr(swarmState().reviews) as Rec[]).map((r, i) => {
      const tag = reviewTag(r.status)
      const pr = r.pr
      // The lock's taxonomy calls the no-claims case "neutral TEXT", not a
      // chip — every other case renders as a bordered state chip. Computed
      // as plain locals (not inline object-literal values) — the compiler's
      // reactive-declaration scanner mis-reads an object property whose
      // value is a bare comparison/ternary as an un-`let`'d state decl.
      const isChip = tag.tone !== 'neutral'
      const prLabel = typeof pr === 'string' ? pr : ''
      return {
        key: `review-${str(r.contract, String(i))}`,
        contract: str(r.contract, '—'),
        owner: str(r.owner, '—'),
        tagLabel: tag.label,
        tagTone: tag.tone,
        isChip,
        prLabel,
        prHref: prHref(pr),
      }
    }),
  )

  const errorRows = derived(() =>
    (arr(swarmState().errors) as Rec[]).map((e, i) => ({
      key: `error-${str(e.contract, String(i))}`,
      contract: str(e.contract, ''),
      message: firstLine(e),
    })),
  )

  const yourMoveEmpty = derived(
    () => decideRows().length === 0 && reviewRows().length === 0 && errorRows().length === 0,
  )

  // ---------------------------------------------------------------------
  // CONTRACTS ledger + BACKLOG line
  // ---------------------------------------------------------------------

  const contractRows = derived(() =>
    (arr(swarmState().contracts) as Rec[]).map((c, i) => {
      const tag = contractTag(c.status)
      return {
        key: `contract-${str(c.id, String(i))}`,
        id: str(c.id, '—'),
        issue: str(c.issue, ''),
        owner: str(c.owner, '—'),
        tagLabel: tag.label,
        tagTone: tag.tone,
        recon: truncate(c.recon),
      }
    }),
  )

  const backlogLine = derived(() => {
    const b = swarmState().backlog
    const count = typeof b?.count === 'number' ? b.count : 0
    if (count <= 0) return ''
    const sample = Array.isArray(b?.sample) ? (b?.sample as unknown[]) : []
    const latest = typeof sample[0] === 'string' ? sample[0] : ''
    return latest
      ? `${count} open issues pulled from Linear/GitHub, unassigned — latest: ${latest}`
      : `${count} open issues pulled from Linear/GitHub, unassigned`
  })

  // ---------------------------------------------------------------------
  // AGENTS roster
  // ---------------------------------------------------------------------

  const agentRows = derived(() =>
    (arr(swarmState().agents) as Rec[]).map((a, i) => {
      const flags = Array.isArray(a.flags)
        ? (a.flags as unknown[]).filter((f): f is string => typeof f === 'string')
        : []
      return {
        key: `agent-${str(a.role, String(i))}`,
        role: str(a.role, '—'),
        city: str(a.city, ''),
        held: str(a.held, ''),
        last: str(a.last, ''),
        liveActive: bool(a.live_active),
        flags: flags.join(', '),
      }
    }),
  )

  // ---------------------------------------------------------------------
  // ACTIVITY — history, the quietest zone.
  // ---------------------------------------------------------------------

  const activityRows = derived(() =>
    (arr(swarmState().activity) as Rec[]).map((e, i) => ({
      key: `activity-${i}-${str(e.contract, '')}`,
      ago: str(e.ago, ''),
      from: str(e.from, ''),
      to: str(e.to, ''),
      kind: str(e.kind, ''),
      contract: str(e.contract, ''),
    })),
  )
}

@template {
  <div class="sc-shell">
    <header class="sc-header">
      <div class="sc-header-inner">
        <div class="sc-brand">
          <svg class="sc-mark" width="20" height="20" viewBox="0 0 100 100" fill="none" aria-hidden="true">
            <path d="M 18 30 L 18 56 a 32 32 0 0 0 64 0 L 82 30" stroke="currentColor" stroke-width="14" fill="none" stroke-linecap="butt"></path>
            <circle cx="50" cy="16" r="9" fill="var(--accent)"></circle>
          </svg>
          <span class="sc-wordmark">swarm console</span>
        </div>
        <div class="sc-header-status">
          <span class="sc-chip sc-tone-warning" if={stale}>stream stale — data frozen</span>
          <span class="sc-live">
            <span class="sc-dot" class:sc-dot-live={supervisorUp}></span>
            <span class="sc-live-label">{liveLabel}</span>
          </span>
        </div>
      </div>
    </header>

    <main class="sc-main">
      <div class="sc-skeleton" if={!hasData}>
        <p class="sc-skeleton-text">connecting to the swarm bus…</p>
      </div>

      <div class="sc-content" if={hasData}>
        <section class="sc-yourmove" aria-label="Your move">
          <p class="sc-label">your move</p>

          <p class="sc-empty" if={yourMoveEmpty}>nothing needs you</p>

          <div class="sc-yourmove-body" if={!yourMoveEmpty}>
            <article class="sc-decide" each={d of decideRows} key={d.key}>
              <div class="sc-decide-meta">
                <span class="sc-mono sc-decide-from">{d.from}</span>
                <span class="sc-mono sc-decide-contract">{d.contract}</span>
                <span class="sc-decide-age">{d.age}</span>
              </div>
              <p class="sc-decide-q">{d.question}</p>
            </article>

            <ul class="sc-review-list" if={reviewRows.length > 0}>
              <li class="sc-review-row" each={r of reviewRows} key={r.key}>
                <code class="sc-mono sc-review-contract">{r.contract}</code>
                <span class="sc-review-owner">{r.owner}</span>
                <span class={['sc-chip', `sc-tone-${r.tagTone}`]} if={r.isChip}>{r.tagLabel}</span>
                <span class={['sc-neutral-text', `sc-tone-${r.tagTone}`]} if={!r.isChip}>{r.tagLabel}</span>
                <a class="sc-mono sc-pr-link" if={r.prHref} href={r.prHref} target="_blank" rel="noopener noreferrer">{r.prLabel}</a>
                <span class="sc-pr-none" if={!r.prHref}>verdict only — read it</span>
              </li>
            </ul>

            <ul class="sc-error-list" if={errorRows.length > 0}>
              <li class="sc-error-row" each={e of errorRows} key={e.key}>
                <code class="sc-mono sc-error-contract" if={e.contract}>{e.contract}</code>
                <span class="sc-error-msg">{e.message}</span>
              </li>
            </ul>
          </div>
        </section>

        <section class="sc-columns">
          <div class="sc-contracts">
            <p class="sc-label">contracts</p>
            <table class="sc-table">
              <thead>
                <tr>
                  <th scope="col">id</th>
                  <th scope="col">issue</th>
                  <th scope="col">owner</th>
                  <th scope="col">status</th>
                  <th scope="col">recon</th>
                </tr>
              </thead>
              <tbody>
                <tr each={c of contractRows} key={c.key}>
                  <td class="sc-mono">{c.id}</td>
                  <td class="sc-mono sc-muted-cell">{c.issue}</td>
                  <td>{c.owner}</td>
                  <td><span class={['sc-chip', `sc-tone-${c.tagTone}`]}>{c.tagLabel}</span></td>
                  <td class="sc-recon">{c.recon}</td>
                </tr>
              </tbody>
            </table>
            <p class="sc-backlog" if={backlogLine !== ''}>{backlogLine}</p>
          </div>

          <div class="sc-agents">
            <p class="sc-label">agents</p>
            <ul class="sc-agent-list">
              <li class="sc-agent-row" each={a of agentRows} key={a.key}>
                <span class="sc-dot" class:sc-dot-live={a.liveActive}></span>
                <span class="sc-agent-role">{a.role}</span>
                <span class="sc-agent-city">{a.city}</span>
                <span class="sc-mono sc-agent-held" if={a.held}>{a.held}</span>
                <span class="sc-mono sc-agent-last">{a.last}</span>
                <span class="sc-agent-flags" if={a.flags}>{a.flags}</span>
              </li>
            </ul>
          </div>
        </section>

        <section class="sc-activity">
          <p class="sc-label">history</p>
          <p class="sc-empty" if={activityRows.length === 0}>no activity yet</p>
          <ul class="sc-activity-list" if={activityRows.length > 0}>
            <li class="sc-activity-row" each={e of activityRows} key={e.key}>
              <span class="sc-mono sc-activity-ago">{e.ago}</span>
              <span class="sc-mono sc-activity-flow">{e.from} → {e.to}</span>
              <span class="sc-mono sc-activity-kind">{e.kind}</span>
              <span class="sc-mono sc-activity-contract">{e.contract}</span>
            </li>
          </ul>
        </section>
      </div>
    </main>
  </div>
}

@style {
  .sc-shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ---------- header ---------- */
  .sc-header {
    position: sticky;
    top: 0;
    z-index: 10;
    height: var(--header-h);
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .sc-header-inner {
    max-width: var(--page-max);
    height: 100%;
    margin: 0 auto;
    padding: 0 var(--sp-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
  }
  .sc-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--fg);
    min-width: 0;
  }
  .sc-mark {
    color: var(--fg);
    flex: none;
  }
  .sc-wordmark {
    font-weight: 600;
    font-size: var(--fs-md);
    letter-spacing: var(--tracking-tight);
    white-space: nowrap;
  }
  .sc-header-status {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
  }
  .sc-live {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--muted);
    white-space: nowrap;
  }

  /* ---------- the dot — identity + liveness ONLY ---------- */
  .sc-dot {
    display: inline-block;
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--muted);
    position: relative;
  }
  .sc-dot-live {
    background: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .sc-dot-live::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 999px;
      background: var(--accent);
      animation: sc-pulse 2.4s ease-out infinite;
    }
  }
  @keyframes sc-pulse {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    70%,
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }

  /* ---------- state chips / neutral text — text + border on surface only,
     no alpha-tinted fills (style-lock legal-pairing list) ---------- */
  .sc-chip {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.02em;
    padding: 0.1rem 0.5rem;
    border-radius: var(--r-sm);
    border: 1px solid currentColor;
    background: var(--surface);
    line-height: 1.6;
  }
  .sc-neutral-text {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.02em;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sc-chip {
      transition: color 150ms ease, border-color 150ms ease;
    }
  }
  .sc-tone-success {
    color: var(--color-success);
  }
  .sc-tone-warning {
    color: var(--color-warning);
  }
  .sc-tone-destructive {
    color: var(--color-destructive);
  }
  .sc-tone-neutral {
    color: var(--muted);
  }

  /* ---------- section labels — plain, no decorative numbering ---------- */
  .sc-label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 var(--sp-4);
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--border);
  }
  .sc-empty {
    color: var(--muted);
    font-size: var(--fs-sm);
    padding: var(--sp-2) 0;
  }
  .sc-mono {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- main / skeleton ---------- */
  .sc-main {
    flex: 1;
    max-width: var(--page-max);
    width: 100%;
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-5) var(--sp-7);
  }
  .sc-skeleton {
    padding: var(--sp-7) 0;
    text-align: center;
  }
  .sc-skeleton-text {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
  }
  @media (prefers-reduced-motion: no-preference) {
    .sc-skeleton-text {
      animation: sc-skeleton-pulse 1.6s ease-in-out infinite;
    }
  }
  @keyframes sc-skeleton-pulse {
    0%,
    100% {
      opacity: 0.45;
    }
    50% {
      opacity: 0.9;
    }
  }

  /* ---------- entrance on first data ---------- */
  /* Deliberately scoped to the three top-level `.sc-content` children
     (each `.sc-*` zone), NOT to individual `.sc-row`s. `.sc-content` mounts
     exactly once (gated by `if={hasData}`, which flips false -> true a
     single time and never back) — but each `.sc-row` sits inside a keyed
     `each` loop over `derived()` state that recomputes a brand-new array of
     brand-new row objects on EVERY ~1s SSE frame. Verified live (real bus,
     headless-browser screenshots a few seconds apart): animating `.sc-row`
     directly re-triggers the fade-in on every frame — a real once-a-second
     flicker across the whole ledger/roster, not a one-time reveal. Per-zone
     staggering keeps the spirit (a staggered reveal when data first
     appears) without depending on row-level DOM node identity across
     reactive updates. Reduced-motion-aware. */
  @media (prefers-reduced-motion: no-preference) {
    .sc-yourmove,
    .sc-columns,
    .sc-activity {
      animation: sc-row-in 260ms ease both;
    }
    .sc-yourmove {
      animation-delay: 0ms;
    }
    .sc-columns {
      animation-delay: 60ms;
    }
    .sc-activity {
      animation-delay: 120ms;
    }
  }
  @keyframes sc-row-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- YOUR MOVE — the dominant zone ---------- */
  .sc-yourmove {
    margin-bottom: var(--sp-7);
  }
  .sc-yourmove-body {
    display: grid;
    gap: var(--sp-5);
  }
  .sc-decide {
    border-left: 2px solid var(--color-warning);
    padding: var(--sp-5);
    background: var(--surface);
  }
  .sc-yourmove-body .sc-decide + .sc-decide {
    margin-top: 0;
  }
  .sc-decide-meta {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    margin-bottom: var(--sp-2);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .sc-decide-from {
    color: var(--fg);
    font-weight: 550;
  }
  .sc-decide-age {
    margin-left: auto;
  }
  .sc-decide-q {
    font-size: var(--fs-base);
    line-height: 1.6;
    color: var(--fg);
  }

  .sc-review-list,
  .sc-error-list,
  .sc-activity-list,
  .sc-agent-list {
    list-style: none;
    display: grid;
    gap: 0;
  }
  .sc-review-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-3);
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--border);
  }
  .sc-review-contract {
    color: var(--fg);
  }
  .sc-review-owner {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .sc-pr-link {
    margin-left: auto;
    color: var(--fg);
  }
  .sc-pr-link:hover {
    color: var(--accent);
  }
  .sc-pr-none {
    margin-left: auto;
    color: var(--muted);
    font-size: var(--fs-xs);
  }

  .sc-error-row {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--border);
  }
  .sc-error-contract {
    color: var(--color-destructive);
    flex: none;
  }
  .sc-error-msg {
    color: var(--color-destructive);
    font-size: var(--fs-sm);
  }

  /* ---------- CONTRACTS + AGENTS — 7/5 of 12 ---------- */
  .sc-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
    margin-bottom: var(--sp-7);
  }
  @media (min-width: 860px) {
    .sc-columns {
      grid-template-columns: 7fr 5fr;
    }
  }

  .sc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }
  .sc-table th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0 var(--sp-3) var(--sp-2) 0;
    border-bottom: 1px solid var(--border);
  }
  .sc-table td {
    padding: var(--sp-2) var(--sp-3) var(--sp-2) 0;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    color: var(--fg);
  }
  .sc-muted-cell {
    color: var(--muted);
  }
  .sc-recon {
    color: var(--muted);
    font-size: var(--fs-xs);
    max-width: 22rem;
  }
  .sc-backlog {
    margin-top: var(--sp-3);
    color: var(--muted);
    font-size: var(--fs-xs);
  }

  .sc-agent-row {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .sc-agent-role {
    font-weight: 550;
    color: var(--fg);
  }
  .sc-agent-city {
    color: var(--muted);
    font-size: var(--fs-xs);
  }
  .sc-agent-held {
    color: var(--fg);
    font-size: var(--fs-xs);
  }
  .sc-agent-last {
    margin-left: auto;
    color: var(--muted);
    font-size: var(--fs-xs);
  }
  .sc-agent-flags {
    flex-basis: 100%;
    color: var(--color-warning);
    font-size: var(--fs-xs);
  }

  /* ---------- ACTIVITY — full-width, the quietest zone ---------- */
  .sc-activity-list {
    font-size: var(--fs-xs);
  }
  .sc-activity-row {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    padding: var(--sp-2) 0;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
  }
  .sc-activity-ago {
    flex: none;
    width: 4.5rem;
  }
  .sc-activity-flow {
    flex: none;
    min-width: 10rem;
  }
  .sc-activity-kind {
    flex: none;
  }
  .sc-activity-contract {
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .sc-header-inner {
      padding: 0 var(--sp-4);
    }
    .sc-main {
      padding: var(--sp-5) var(--sp-4) var(--sp-6);
    }
    .sc-decide-meta {
      flex-wrap: wrap;
    }
    .sc-activity-row {
      flex-wrap: wrap;
    }
  }
}
