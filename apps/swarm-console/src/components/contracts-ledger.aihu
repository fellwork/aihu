// contracts-ledger — the contracts table + backlog summary line. Now its
// own tab/page (founder: "sections as pages") rather than sharing a page
// with agents-roster. Reads the shared `swarm` singleton directly
// (../lib/swarm-store.ts) rather than a prop from the root — see that
// module's doc comment for why.
//
// A REAL native `<table>` (`<thead>`/`<tbody>`/`<tr>`/`<th>`/`<td>`), not the
// `role="table"`/`row`/`cell` CSS-grid-of-divs the previous pass used. That
// grid version rendered every row as its OWN independent `display: grid`
// container with `items-center` (non-stretch) alignment, so each cell's box
// height matched its OWN content instead of the row's — a cell with no text
// (e.g. an empty `recon` note) got a shorter content box than its siblings,
// and centering that shorter box within the row visibly floated its
// `border-b` line above the neighboring cells' — exactly the founder's "rows
// are offset where there is no data" report (confirmed live: C-FEL-440 /
// C-DEMO-1, both `recon`-less, before this fix). `table-fixed` + explicit
// `w-*` widths on `<th>` fix the column widths (founder feedback: rows need
// to line up vertically down the list); a native `<tr>` gives every `<td>`
// in it the row's SHARED height by construction, so this class of bug can't
// recur regardless of which cell is empty. Converted alongside your-move's
// review rows and agents-roster for the same reason. Paginated at
// CONTRACTS_PAGE_SIZE (../lib/swarm-store.ts) — founder addendum: "~12-15
// rows per page", resets to page 1 on every tab switch (swarm-store's
// shared hashchange listener).

@state {
  import { swarm, CONTRACTS_PAGE_SIZE, contractsPage, goToContractsPage } from '../lib/swarm-store.ts'
  import { arr, chipClasses, contractTag, str, truncate } from '../lib/format.ts'

  type Rec = Record<string, unknown>

  const swarmState = swarm.state

  const allContractRows = derived(() =>
    (arr(swarmState().contracts) as Rec[]).map((c, i) => {
      const tag = contractTag(c.status)
      const tagClasses = chipClasses(tag.tone)
      // Local, not an inline object-literal value — the compiler's
      // reactive-declaration scanner mis-reads an object property whose
      // value is a bare comparison/ternary as an un-`let`'d state decl
      // (same trap documented in your-move.aihu). A contract with no recon
      // note yet (`truncate` defaults to '') still renders its <td> — see
      // the @template comment below — just with this muted placeholder
      // instead of blank text.
      const reconText = truncate(c.recon)
      const recon = reconText !== '' ? reconText : '—'
      return {
        key: `contract-${str(c.id, String(i))}`,
        id: str(c.id, '—'),
        issue: str(c.issue, ''),
        owner: str(c.owner, '—'),
        tagLabel: tag.label,
        tagTitle: tag.title,
        tagClasses,
        recon,
      }
    }),
  )

  const totalContracts = derived(() => allContractRows().length)
  const totalContractPages = derived(() =>
    Math.max(1, Math.ceil(totalContracts() / CONTRACTS_PAGE_SIZE)),
  )
  const contractPage = derived(() => Math.min(contractsPage(), totalContractPages()))
  const contractPageStart = derived(() => (contractPage() - 1) * CONTRACTS_PAGE_SIZE)
  const contractRows = derived(() =>
    allContractRows().slice(contractPageStart(), contractPageStart() + CONTRACTS_PAGE_SIZE),
  )
  const contractRangeStart = derived(() => (totalContracts() === 0 ? 0 : contractPageStart() + 1))
  const contractRangeEnd = derived(() =>
    Math.min(contractPageStart() + CONTRACTS_PAGE_SIZE, totalContracts()),
  )
  const showContractPager = derived(() => totalContracts() > CONTRACTS_PAGE_SIZE)
  const contractHasPrev = derived(() => contractPage() > 1)
  const contractHasNext = derived(() => contractPage() < totalContractPages())
  const prevContractPage = () => goToContractsPage(Math.max(1, contractPage() - 1))
  const nextContractPage = () =>
    goToContractsPage(Math.min(totalContractPages(), contractPage() + 1))

  const backlogLine = derived(() => {
    const b = swarmState().backlog
    const count = typeof b?.count === 'number' ? b.count : 0
    if (count <= 0) return ''
    const sample = Array.isArray(b?.sample) ? (b?.sample as unknown[]) : []
    const latest = typeof sample[0] === 'string' ? sample[0] : ''
    return latest
      ? `${count} open issues pulled from Linear/GitHub, unassigned — latest: ${latest}`
      : `${count} open issues pulled from Linear/GitHub, unassigned`
  })
}

@template {
  <div>
    <p class="font-mono text-xs font-medium tracking-[0.12em] uppercase text-muted mb-4 pb-2 border-b border-border">contracts</p>

    <table class="w-full table-fixed border-collapse" aria-label="Contracts ledger">
      <thead>
        <tr>
          <th scope="col" class="w-36 text-left font-mono text-xs font-medium tracking-[0.04em] uppercase text-muted pb-2 border-b border-border">id</th>
          <th scope="col" class="w-24 text-left font-mono text-xs font-medium tracking-[0.04em] uppercase text-muted pb-2 border-b border-border">issue</th>
          <th scope="col" class="w-28 text-left font-mono text-xs font-medium tracking-[0.04em] uppercase text-muted pb-2 border-b border-border">owner</th>
          <th scope="col" class="w-32 text-left font-mono text-xs font-medium tracking-[0.04em] uppercase text-muted pb-2 border-b border-border">status</th>
          <th scope="col" class="text-left font-mono text-xs font-medium tracking-[0.04em] uppercase text-muted pb-2 border-b border-border">recon</th>
        </tr>
      </thead>
      <!-- Every row renders every <td>, always — no cell is ever
           conditionally omitted. A contract with no recon note yet still
           gets its 5th <td>, just with the '—' placeholder computed above
           instead of blank text. This is the fix for the founder's "rows
           are offset where there is no data" report: see the module doc
           comment at the top of this file for the root cause. -->
      <tbody>
        <tr each={c of contractRows} key={c.key}>
          <td class="align-middle font-mono tabular-nums py-4 border-b border-border text-ink">{c.id}</td>
          <td class="align-middle font-mono tabular-nums py-4 border-b border-border text-muted">{c.issue}</td>
          <td class="align-middle py-4 border-b border-border text-ink">{c.owner}</td>
          <td class="align-middle py-4 border-b border-border"><span class={c.tagClasses} title={c.tagTitle}>{c.tagLabel}</span></td>
          <td class="align-middle py-4 border-b border-border text-muted text-xs">{c.recon}</td>
        </tr>
      </tbody>
    </table>

    <div class="flex items-center gap-4 pt-3 font-mono text-xs text-muted" if={showContractPager}>
      <span class="tabular-nums">{contractRangeStart}–{contractRangeEnd} of {totalContracts}</span>
      <button type="button" class="hover:text-ink disabled:opacity-40 disabled:pointer-events-none motion-safe:transition-colors motion-safe:duration-150" on:click={prevContractPage} disabled={!contractHasPrev} aria-label="Previous page of contracts">‹</button>
      <button type="button" class="hover:text-ink disabled:opacity-40 disabled:pointer-events-none motion-safe:transition-colors motion-safe:duration-150" on:click={nextContractPage} disabled={!contractHasNext} aria-label="Next page of contracts">›</button>
    </div>

    <p class="mt-3 text-muted text-xs" if={backlogLine !== ''}>{backlogLine}</p>
  </div>
}
