// contracts-ledger — the contracts table + backlog summary line. A
// receding zone (design brief: "CONTRACTS/AGENTS recede"). Reads the shared
// `swarm` singleton directly (../lib/swarm-store.ts) rather than a prop
// from the root — see that module's doc comment for why.

@state {
  import { swarm } from '../lib/swarm-store.ts'
  import { arr, chipClasses, contractTag, str, truncate } from '../lib/format.ts'

  type Rec = Record<string, unknown>

  const swarmState = swarm.state

  const contractRows = derived(() =>
    (arr(swarmState().contracts) as Rec[]).map((c, i) => {
      const tag = contractTag(c.status)
      const tagClasses = chipClasses(tag.tone)
      return {
        key: `contract-${str(c.id, String(i))}`,
        id: str(c.id, '—'),
        issue: str(c.issue, ''),
        owner: str(c.owner, '—'),
        tagLabel: tag.label,
        tagClasses,
        recon: truncate(c.recon),
      }
    }),
  )

  const backlogLine = derived(() => {
    const b = swarmState().backlog
    const count = typeof b?.count === 'number' ? b.count : 0
    if (count <= 0) return ''
    const sample = Array.isArray(b?.sample) ? (b?.sample as unknown[]) : []
    const latest = typeof sample[0] === 'string' ? sample[0] : ''
    return latest
      ? `${count} open issues pulled from Linear/GitHub, unassigned — latest: ${latest}`
      : `${count} open issues pulled from Linear/GitHub, unassigned`
  })
}

@template {
  <div>
    <p class="font-mono text-xs font-medium tracking-[0.12em] uppercase text-muted mb-4 pb-2 border-b border-border">contracts</p>
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr>
          <th scope="col" class="text-left font-mono text-xs font-medium tracking-[0.04em] uppercase text-muted pr-3 pb-2 border-b border-border">id</th>
          <th scope="col" class="text-left font-mono text-xs font-medium tracking-[0.04em] uppercase text-muted pr-3 pb-2 border-b border-border">issue</th>
          <th scope="col" class="text-left font-mono text-xs font-medium tracking-[0.04em] uppercase text-muted pr-3 pb-2 border-b border-border">owner</th>
          <th scope="col" class="text-left font-mono text-xs font-medium tracking-[0.04em] uppercase text-muted pr-3 pb-2 border-b border-border">status</th>
          <th scope="col" class="text-left font-mono text-xs font-medium tracking-[0.04em] uppercase text-muted pr-3 pb-2 border-b border-border">recon</th>
        </tr>
      </thead>
      <tbody>
        <tr each={c of contractRows} key={c.key}>
          <td class="font-mono tabular-nums py-2 pr-3 border-b border-border align-top text-ink">{c.id}</td>
          <td class="font-mono tabular-nums py-2 pr-3 border-b border-border align-top text-muted">{c.issue}</td>
          <td class="py-2 pr-3 border-b border-border align-top text-ink">{c.owner}</td>
          <td class="py-2 pr-3 border-b border-border align-top"><span class={c.tagClasses}>{c.tagLabel}</span></td>
          <td class="py-2 pr-3 border-b border-border align-top text-muted text-xs max-w-[22rem]">{c.recon}</td>
        </tr>
      </tbody>
    </table>
    <p class="mt-3 text-muted text-xs" if={backlogLine !== ''}>{backlogLine}</p>
  </div>
}
