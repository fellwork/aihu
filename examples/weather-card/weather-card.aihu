// @agent flagship #1 — sync action against an inline mock forecast table.
// Demonstrates the aihu-unique capability: every component readable as MCP.
// No network: keeps the example self-contained and offline-runnable.

@state {
  // Standalone signal so the example is interactive in isolation.
  // Swap to `$prop location: string = 'San Francisco'` for a parent-driven variant
  // (and remove $bind:value="location" from the input below).
  $prop: {
    location: {
      default: 'San Francisco',
      describe: 'City name to query forecasts for',
      expose: { read: true },
    },
    forecast: {
      type: { high: number; low: number; conditions: string } | null,
      default: null,
      describe: 'Most recent forecast: high, low, conditions',
      expose: { read: true },
    },
    status: {
      type: 'idle' | 'loading' | 'ready' | 'error',
      default: 'idle',
      describe: 'One of: idle | loading | ready | error',
      expose: { read: true },
    },
  }

  errorMessage: string = ''

  // Inline mock table standing in for a real forecast API.
  mockForecasts: Record<string, { high: number; low: number; conditions: string }> = {
    'San Francisco': { high: 64, low: 52, conditions: 'Partly cloudy' },
    'New York':      { high: 72, low: 58, conditions: 'Sunny' },
    'London':        { high: 60, low: 48, conditions: 'Rain showers' },
    'Tokyo':         { high: 68, low: 55, conditions: 'Clear' },
    'Sydney':        { high: 78, low: 64, conditions: 'Sunny' },
  }

  $action: {
    fetchForecast: {
      describe: 'Look up the forecast for the current location signal',
      expose: { read: true, write: true },
      handler: () => {
        status = 'loading'
        const data = mockForecasts[location]
        if (data) {
          forecast = data
          status = 'ready'
          errorMessage = ''
        } else {
          forecast = null
          status = 'error'
          errorMessage = `No forecast available for "${location}".`
        }
      },
    },
  }
}

@template {
  <article class="weather-card">
    <header>
      <h1>Weather</h1>
      <p class="location">{location}</p>
    </header>

    <div class="row">
      <input
        type="text"
        $bind.value="location"
        placeholder="City name"
      />
      <button $on.click="fetchForecast">Get forecast</button>
    </div>

    <div class="result" $if={status === 'loading'}>
      <p>Loading forecast for {location}...</p>
    </div>

    <div class="result ready" $if={status === 'ready' && forecast !== null}>
      <p class="conditions">{forecast.conditions}</p>
      <dl>
        <dt>High</dt><dd>{forecast.high}°F</dd>
        <dt>Low</dt><dd>{forecast.low}°F</dd>
      </dl>
    </div>

    <div class="result error" $if={status === 'error'}>
      <p>{errorMessage}</p>
    </div>
  </article>
}

@style {
  .weather-card { display: grid; gap: 0.75rem; padding: 1rem; max-width: 24rem; font-family: system-ui, sans-serif; border: 1px solid #ddd; border-radius: 6px; }
  header        { display: flex; justify-content: space-between; align-items: baseline; }
  h1            { margin: 0; }
  .location     { margin: 0; color: #666; }
  .row          { display: flex; gap: 0.5rem; }
  input         { flex: 1; padding: 0.4rem; }
  button        { padding: 0.4rem 0.75rem; cursor: pointer; }
  .result       { padding: 0.5rem; border-radius: 4px; background: #f7f7f7; }
  .result.error { background: #fee; color: #a00; }
  .conditions   { font-size: 1.1rem; margin: 0 0 0.5rem 0; }
  dl            { display: grid; grid-template-columns: auto 1fr; gap: 0.25rem 1rem; margin: 0; }
  dt            { font-weight: 600; }
  dd            { margin: 0; font-variant-numeric: tabular-nums; }
}
