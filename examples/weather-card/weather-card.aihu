// @agent flagship #1 — async action against the Open-Meteo public API.
// Demonstrates the aihu-unique capability: every component readable as MCP.
// Round-1 of m2-a2 replaces the inline mock table with a real geocoding +
// forecast chain (no auth, no fetch library — global fetch()).

@state {
  import { signal } from '@aihu/signals'

  type Forecast = { temperature: number; weatherCode: number; conditions: string; resolvedName: string }
  type Status = 'idle' | 'loading' | 'ready' | 'error'

  const [location, setLocation] = signal('San Francisco')
  const [forecastValue, setForecastValue] = signal<Forecast | null>(null)
  const [statusValue, setStatusValue] = signal<Status>('idle')
  const [errorMessage, setErrorMessage] = signal('')

  // Open-Meteo weather_code -> human-readable conditions.
  // Spec: https://open-meteo.com/en/docs (WMO Weather interpretation codes).
  function translateWeatherCode(code: number): string {
    if (code === 0) return 'Clear'
    if (code >= 1 && code <= 3) return 'Partly cloudy'
    if (code === 45 || code === 48) return 'Fog'
    if (code >= 51 && code <= 57) return 'Drizzle'
    if (code >= 61 && code <= 67) return 'Rain'
    if (code >= 71 && code <= 77) return 'Snow'
    if (code >= 80 && code <= 82) return 'Showers'
    if (code >= 95 && code <= 99) return 'Thunderstorm'
    return 'Unknown'
  }

  $computed: {
    forecast: {
      describe: 'Most recent forecast: temperature, weatherCode, conditions, resolvedName (null until fetched)',
      expose: { read: true },
      value: () => forecastValue(),
    },
    status: {
      describe: 'Request status: one of idle | loading | ready | error',
      expose: { read: true },
      value: () => statusValue(),
    },
  }

  $action: {
    fetchForecast: {
      describe: 'Geocode the current location signal via Open-Meteo, then fetch the current temperature + weather code',
      expose: { read: true, write: true },
      handler: async () => {
        const query = location().trim()
        if (!query) {
          setForecastValue(null)
          setStatusValue('error')
          setErrorMessage('Please enter a city name.')
          return
        }

        setStatusValue('loading')
        setErrorMessage('')

        try {
          // Step 1: geocode city name -> lat/lon.
          const geoUrl = `https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(query)}&count=1&language=en&format=json`
          const geoResp = await fetch(geoUrl)
          if (!geoResp.ok) {
            throw new Error(`Geocoding failed (HTTP ${geoResp.status})`)
          }
          const geoJson = await geoResp.json() as { results?: Array<{ latitude: number; longitude: number; name: string; country?: string }> }
          const hit = geoJson.results && geoJson.results[0]
          if (!hit) {
            setForecastValue(null)
            setStatusValue('error')
            setErrorMessage(`No matching city found for "${query}".`)
            return
          }

          // Step 2: forecast lookup.
          const forecastUrl = `https://api.open-meteo.com/v1/forecast?latitude=${hit.latitude}&longitude=${hit.longitude}&current=temperature_2m,weather_code&temperature_unit=fahrenheit&timezone=auto`
          const fcResp = await fetch(forecastUrl)
          if (!fcResp.ok) {
            throw new Error(`Forecast lookup failed (HTTP ${fcResp.status})`)
          }
          const fcJson = await fcResp.json() as { current?: { temperature_2m: number; weather_code: number } }
          if (!fcJson.current) {
            throw new Error('Forecast response missing "current" block.')
          }

          const temp = fcJson.current.temperature_2m
          const code = fcJson.current.weather_code
          const resolvedName = hit.country ? `${hit.name}, ${hit.country}` : hit.name

          setForecastValue({
            temperature: temp,
            weatherCode: code,
            conditions: translateWeatherCode(code),
            resolvedName,
          })
          setStatusValue('ready')
          setErrorMessage('')
        } catch (err) {
          setForecastValue(null)
          setStatusValue('error')
          setErrorMessage(err instanceof Error ? err.message : 'Unknown error fetching forecast.')
        }
      },
    },
  }
}

@template {
  <article class="weather-card">
    <header>
      <h1>Weather</h1>
      <p class="location">{location}</p>
    </header>

    <div class="row">
      <input
        type="text"
        $bind.value="location"
        placeholder="City name"
      />
      <button $on.click="fetchForecast">Get forecast</button>
    </div>

    <div class="result" $if={status === 'loading'}>
      <p>Loading forecast for {location}...</p>
    </div>

    <div class="result ready" $if={status === 'ready' && forecast !== null}>
      <p class="resolved">{forecast.resolvedName}</p>
      <p class="conditions">{forecast.conditions}</p>
      <dl>
        <dt>Temperature</dt><dd>{forecast.temperature}°F</dd>
        <dt>Code</dt><dd>{forecast.weatherCode}</dd>
      </dl>
    </div>

    <p class="error-pill" role="status" $if={status === 'error'}>
      {errorMessage}
    </p>
  </article>
}

@style {
  .weather-card { display: grid; gap: 0.75rem; padding: 1.5rem; max-width: 24rem; background: var(--panel-bg); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--card-shadow); color: var(--fg); }
  header        { display: flex; justify-content: space-between; align-items: baseline; }
  h1            { margin: 0; color: var(--fg); }
  .location     { margin: 0; color: var(--muted); }
  .row          { display: flex; gap: 0.5rem; }
  input         { flex: 1; padding: 0.4rem; background: var(--input-bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--fg); }
  input:focus   { outline: 2px solid var(--focus-ring); outline-offset: 1px; }
  button        { padding: 0.4rem 0.75rem; cursor: pointer; background: var(--btn-bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--fg); transition: background 0.1s; }
  button:hover  { background: var(--hover-bg); }
  .result       { padding: 0.5rem 0.75rem; border-radius: var(--radius); background: var(--code-bg); color: var(--fg); }
  .result.ready { background: var(--success-bg); }
  .resolved     { font-size: 0.85rem; color: var(--muted); margin: 0 0 0.25rem 0; }
  .conditions   { font-size: 1.1rem; margin: 0 0 0.5rem 0; }
  dl            { display: grid; grid-template-columns: auto 1fr; gap: 0.25rem 1rem; margin: 0; }
  dt            { font-weight: 600; color: var(--muted); }
  dd            { margin: 0; font-variant-numeric: tabular-nums; }

  .error-pill {
    display: inline-block;
    background: var(--stub-bg);
    border: 1px solid var(--stub-border);
    color: var(--stub-fg);
    border-radius: var(--radius);
    padding: 0.35rem 0.65rem;
    font-size: 0.85rem;
    margin: 0;
  }

  @media (max-width: 480px) {
    .row { flex-direction: column; }
    button { width: 100%; }
  }
}
