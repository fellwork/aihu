@route {
  path: "/",
  name: "home-page",
  layout: "app",
  head: { title: "Home — aihu layouts", description: "Runtime layout rendering demo" }
}

@template {
  <section class="page">
    <h1>Home</h1>
    <p>This page declares <code>layout: "app"</code>, so it renders inside the
       <code>app</code> layout's <code>&lt;$outlet&gt;</code>.</p>
    <p>Navigate to the <a href="/dashboard">Dashboard</a> — it declares a
       different layout and the shell changes. Or use the toolbar (bottom-right)
       to switch the current page's layout <em>without</em> navigating.</p>
  </section>
}

@style {
  .page h1 { font-size: 1.75rem; margin-bottom: 0.75rem; }
  .page p { line-height: 1.6; margin-bottom: 0.75rem; color: #334155; }
  .page a { color: #2563eb; }
  .page code { background: #f1f5f9; padding: 0.05rem 0.3rem; border-radius: 3px; font-size: 0.9em; }
}
