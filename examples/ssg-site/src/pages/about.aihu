@route {
  path: "/about",
  name: "ssg-about",
  head: {
    title: "About — aihu SSG example",
    description: "What the ssg-site governed example exercises: output: 'static', prerender, hydration adoption, SEO head, onAdopt / onAttributeChange.",
    canonical: "/about"
  }
}

@state {
  /**
   * The governed set's live exerciser for `html={}` (FEL-426).
   *
   * This string is a CONSTANT IN THIS FILE. That is the entire reason the
   * binding below is safe, and it is the only condition under which `html={}`
   * is safe: the compiler documents it as intentionally unsafe by design
   * (`emit.rs:12`), and since #572 the SSR path interpolates it unescaped into
   * the bytes we serve, not just into client DOM.
   *
   * The row used to be held by `examples/hacker-news`, which pointed the same
   * binding at the Hacker News API — so the coverage floor was being satisfied
   * by a live stored-XSS hole. The guarantee and the defect were one line of
   * code. Coverage now means "covered by a CORRECT usage".
   *
   * If you ever need this content to come from a loader, a CMS, or a user:
   * it does not belong in `html={}`. Parse it to structured data and render
   * escaped bindings — see `examples/hacker-news/src/lib/parse-hn-markup.ts`.
   */
  const AUTHORED_NOTICE_HTML =
    '<strong>Authored in this repo.</strong> This block is rendered with ' +
    '<code>html={}</code>, which interpolates its value raw — into the DOM ' +
    'and into the prerendered bytes. Safe here only because the string is a ' +
    'constant in <code>about.aihu</code>.'
}

@template {
  <main class="ssg-about">
    <h1>About this example</h1>
    <div class="ssg-notice" html={AUTHORED_NOTICE_HTML}></div>
    <p>
      <code>ssg-site</code> is the governed example for aihu's static output
      mode. It is the sole live exerciser of the SSG build path and the
      hydration-lifecycle callbacks.
    </p>
    <ul class="ssg-list">
      <li><code>output: 'static'</code> in <code>aihu.config.ts</code></li>
      <li>prerender to per-route <code>index.html</code> with a per-page head</li>
      <li>hydration adoption of the prerendered DOM</li>
      <li><code>onAdopt</code> / <code>onAttributeChange</code> (theme-badge)</li>
      <li>reflected <code>prop</code> attribute surface</li>
    </ul>
    <nav class="ssg-nav"><a href="/">← Home</a></nav>
  </main>
}

@style {
  .ssg-about { max-width: 40rem; margin: 0 auto; padding: 2.5rem 1.5rem; }
  .ssg-about h1 { font-size: 1.6rem; }
  .ssg-list { line-height: 1.7; color: #334155; }
  .ssg-list code { background: #f1f5f9; padding: 0.05rem 0.3rem; border-radius: 3px; }
  .ssg-nav a { color: #2563eb; }
}
