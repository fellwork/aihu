@state {
  import { inject } from '@aihu/context'
  import { HubServiceContext } from './hub-context'
  const sendAcpMessage = action(
    { describe: 'Send a ping ACP message and store the response',
      expose: 'read write' },
    async () => {
        loading = true
        try {
          const res = await fetch('/acp/messages', {
            method: 'POST',
            body: JSON.stringify({ role: 'user', content: 'ping', parts: [] }),
            headers: { 'Content-Type': 'application/json' },
          })
          const data = await res.json()
          result = JSON.stringify(data, null, 2)
        } catch (err) {
          result = `Error: ${err}`
        } finally {
          loading = false
        }
      })

  onMount(() => {
      fetch('/.well-known/acp-agent')
        .then(r => r.json())
        .then(d => { discoveryCard = JSON.stringify(d, null, 2) })
        .catch(() => { discoveryCard = '(discovery unavailable in dev mode)' })
    })

  const _service = inject(HubServiceContext)

  let discoveryCard = state<string | null>(null)

  let result = state<string | null>(null)

  let loading = state(false)
}

@template {
  <div class="acp-panel">
    <h2 class="panel-heading">ACP Protocol</h2>

    <span class="protocol-badge acp-badge">ACP: live</span>

    <section class="discovery-section" aria-label="ACP Discovery">
      <h3 class="subsection-heading">ACP Discovery</h3>
      <pre class="discovery-card">{discoveryCard ?? '(loading...)'}</pre>
    </section>

    <section class="request-section" aria-label="Send ACP Message">
      <button
        class="send-btn"
        on:click={sendAcpMessage}
        disabled={loading}
        aria-busy={loading}
      >
        {loading ? 'Sending...' : 'Send ACP Message'}
      </button>
    </section>

    <section class="result-section" if={result !== null} aria-label="ACP Result">
      <h3 class="subsection-heading">Result</h3>
      <pre class="result-display">{result}</pre>
    </section>

    <p class="result-placeholder" if={result === null && !loading}>
      No result yet — click "Send ACP Message" to make a request.
    </p>
  </div>
}

@style {
  .acp-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--fg);
  }

  .panel-heading {
    margin: 0 0 0.25rem 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--fg);
  }

  .subsection-heading {
    margin: 0 0 0.5rem 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--fg);
  }

  .protocol-badge {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius);
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }

  .acp-badge {
    background: var(--success-bg);
    border: 1px solid var(--success);
    color: var(--success);
  }

  .discovery-section {
    padding: 0.75rem 1rem;
    background: var(--panel-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .discovery-card {
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    color: var(--muted);
    white-space: pre-wrap;
    word-break: break-word;
    max-height: 160px;
    overflow-y: auto;
  }

  .request-section {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .send-btn {
    padding: 0.5rem 1.25rem;
    background: var(--accent);
    color: var(--tag-bg);
    border: none;
    border-radius: var(--radius);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    min-height: 44px;
    min-width: 44px;
    transition: opacity 0.1s;
  }

  .send-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .send-btn:hover:not(:disabled) {
    opacity: 0.88;
  }

  .result-section {
    padding: 0.75rem 1rem;
    background: var(--panel-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .result-display {
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    color: var(--fg);
    white-space: pre-wrap;
    word-break: break-word;
    max-height: 200px;
    overflow-y: auto;
  }

  .result-placeholder {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
    font-style: italic;
  }

  @media (max-width: 480px) {
    .acp-panel {
      gap: 1rem;
    }

    .panel-heading {
      font-size: 1.1rem;
    }

    .protocol-badge {
      font-size: 0.75rem;
      display: block;
    }

    .send-btn {
      width: 100%;
    }

    .discovery-card,
    .result-display {
      max-height: 120px;
    }
  }
}
