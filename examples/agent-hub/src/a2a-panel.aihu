@state {
  import { inject } from '@aihu/context'
  import { HubServiceContext } from './hub-context'
  import { signal } from '@aihu/signals'

  $action: {
    sendA2aRequest: {
      describe: 'Send an A2A SendStreamingMessage JSON-RPC request and show the terminal SSE task status',
      expose: { read: true, write: true },
      handler: async () => {
        setLoading(true)
        try {
          // A2A v1.0.1 JSON-RPC binding: SendStreamingMessage over SSE.
          const res = await fetch('/a2a', {
            method: 'POST',
            body: JSON.stringify({
              jsonrpc: '2.0',
              id: 1,
              method: 'SendStreamingMessage',
              params: {
                message: {
                  messageId: crypto.randomUUID(),
                  role: 'ROLE_USER',
                  parts: [{ text: 'ping' }],
                },
              },
            }),
            headers: { 'Content-Type': 'application/json' },
          })
          const text = await res.text()
          // Show the last SSE frame — the terminal task status update.
          const dataLines = text.split('\n').filter(l => l.startsWith('data:'))
          const payload = dataLines.length > 0 ? dataLines[dataLines.length - 1].slice(5).trim() : text
          setResult(payload)
        } catch (err) {
          setResult(`Error: ${err}`)
        } finally {
          setLoading(false)
        }
      },
    },
  }

  $lifecycle: {
    mount: () => {
      fetch('/.well-known/agent-card.json')
        .then(r => r.json())
        .then(d => setDiscoveryCard(JSON.stringify(d, null, 2)))
        .catch(() => setDiscoveryCard('(discovery unavailable in dev mode)'))
    },
  }

  const _service = inject(HubServiceContext)   // null in client context; API pattern demo

  const [discoveryCard, setDiscoveryCard] = signal<string | null>(null)

  const [result, setResult] = signal<string | null>(null)

  const [loading, setLoading] = signal(false)
}

@template {
  <div class="a2a-panel">
    <h2 class="panel-heading">A2A Protocol</h2>

    <span class="protocol-badge a2a-badge">A2A v1.0.0: JSON-RPC SendStreamingMessage over SSE</span>

    <section class="discovery-section" aria-label="A2A Discovery">
      <h3 class="subsection-heading">A2A Discovery</h3>
      <pre class="discovery-card">{discoveryCard ?? '(loading...)'}</pre>
    </section>

    <section class="request-section" aria-label="Send A2A Request">
      <button
        class="send-btn"
        $on.click={sendA2aRequest}
        $disabled={loading}
        $aria-busy={loading}
      >
        {loading ? 'Sending...' : 'Send A2A Request'}
      </button>
    </section>

    <section class="result-section" $if={result !== null} aria-label="A2A Result">
      <h3 class="subsection-heading">Result</h3>
      <pre class="result-display">{result}</pre>
    </section>

    <p class="result-placeholder" $if={result === null && !loading}>
      No result yet — click "Send A2A Request" to make a request.
    </p>
  </div>
}

@style {
  .a2a-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--fg);
  }

  .panel-heading {
    margin: 0 0 0.25rem 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--fg);
  }

  .subsection-heading {
    margin: 0 0 0.5rem 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--fg);
  }

  .protocol-badge {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius);
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }

  .a2a-badge {
    background: var(--stub-bg);
    border: 1px solid var(--stub-border);
    color: var(--stub-fg);
  }

  .discovery-section {
    padding: 0.75rem 1rem;
    background: var(--panel-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .discovery-card {
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    color: var(--muted);
    white-space: pre-wrap;
    word-break: break-word;
    max-height: 160px;
    overflow-y: auto;
  }

  .request-section {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .send-btn {
    padding: 0.5rem 1.25rem;
    background: var(--accent);
    color: var(--tag-bg);
    border: none;
    border-radius: var(--radius);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    min-height: 44px;
    min-width: 44px;
    transition: opacity 0.1s;
  }

  .send-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .send-btn:hover:not(:disabled) {
    opacity: 0.88;
  }

  .result-section {
    padding: 0.75rem 1rem;
    background: var(--panel-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .result-display {
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    color: var(--fg);
    white-space: pre-wrap;
    word-break: break-word;
    max-height: 200px;
    overflow-y: auto;
  }

  .result-placeholder {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
    font-style: italic;
  }

  @media (max-width: 480px) {
    .a2a-panel {
      gap: 1rem;
    }

    .panel-heading {
      font-size: 1.1rem;
    }

    .protocol-badge {
      font-size: 0.75rem;
      display: block;
    }

    .send-btn {
      width: 100%;
    }

    .discovery-card,
    .result-display {
      max-height: 120px;
    }
  }
}
