@route {
  path: "/",
  name: "hn-top",
  ssr: true
}

@state {
  import type { Story } from './index.loader.ts'

  $prop: {
    route: {
      type: { data: { stories: Array<Story>; page: number; hasMore: boolean } },
      describe: 'Top stories data: stories array, current page, hasMore flag',
      expose: { read: true },
    },
  }

  $action: {
    hostname: (u: string | undefined): string => {
      if (!u) return ''
      try { return new URL(u).hostname.replace(/^www\./, '') } catch { return '' }
    },
    ago: (t: number): string => {
      const s = Math.floor(Date.now() / 1000 - t)
      if (s < 3600)  return `${Math.floor(s / 60)}m ago`
      if (s < 86400) return `${Math.floor(s / 3600)}h ago`
      return `${Math.floor(s / 86400)}d ago`
    },
  }
}

@template {
  <main class="hn-top">
    <header>
      <h1>aihu HN</h1>
      <nav>
        <$link href={`/?page=${Math.max(1, route().data.page - 1)}`} $if={route().data.page > 1} prefetch="hover">&larr; prev</$link>
        <span class="page">page {route().data.page}</span>
        <$link href={`/?page=${route().data.page + 1}`} $if={route().data.hasMore} prefetch="hover">next &rarr;</$link>
      </nav>
    </header>

    <ol class="stories" $start={(route().data.page - 1) * 30 + 1}>
      <li $each="route().data.stories as item" $key={item.id} class="story">
        <div class="title">
          <a $href={item.url ?? `/item/${item.id}`}>{item.title}</a>
          <span class="host" $if={!!item.url}> ({hostname(item.url)})</span>
        </div>
        <div class="meta">
          {item.score} points by
          <$link href={`/user/${item.by}`} prefetch="hover">{item.by}</$link>
          {ago(item.time)} |
          <$link href={`/item/${item.id}`} prefetch="hover">{item.descendants ?? 0} comments</$link>
        </div>
      </li>
    </ol>
  </main>
}

@style {
  /* DA4: pages are light DOM by default, so this @style joins the GLOBAL
     cascade — every selector is scoped under the page root class so bare
     element selectors (main, header, h1, ...) don't bleed into other pages. */
  .hn-top { max-width: 48rem; margin: 1.5rem auto; padding: 0 1rem; font-family: Verdana, system-ui, sans-serif; font-size: 13px; background: var(--bg); color: var(--fg); }
  .hn-top header { display: flex; justify-content: space-between; align-items: baseline; padding: 0.5rem; background: var(--hn-orange, #ff6600); }
  .hn-top h1 { color: white; margin: 0; font-size: 1.1rem; }
  .hn-top nav { color: white; }
  .hn-top nav a, .hn-top nav .page { color: white; text-decoration: none; padding: 0 0.4rem; }
  .hn-top nav a:hover { text-decoration: underline; }
  .hn-top .stories { padding-left: 2rem; }
  .hn-top .story { padding: 0.4rem 0; }
  .hn-top .title a { color: var(--fg); text-decoration: none; font-size: 1rem; }
  .hn-top .title a:hover { text-decoration: underline; }
  .hn-top .host { color: var(--muted); font-size: 0.85em; }
  .hn-top .meta { color: var(--muted); font-size: 0.85em; padding-top: 0.1rem; }
  .hn-top .meta a { color: var(--muted); }
  .hn-top .meta a:hover { text-decoration: underline; color: var(--fg); }

  @media (max-width: 480px) {
    .hn-top { padding: 0 0.5rem; }
    .hn-top .stories { padding-left: 1rem; }
    .hn-top .title a { font-size: 0.95rem; }
  }
}
