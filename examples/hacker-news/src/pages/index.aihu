@route {
  path: "/",
  name: "hn-top",
  ssr: true
}

@state {
  import type { Story } from './index.loader.ts'

  $prop route: {
    data: { stories: Array<Story>; page: number; hasMore: boolean }
  }

  $action hostname(u: string | undefined): string {
    if (!u) return ''
    try { return new URL(u).hostname.replace(/^www\./, '') } catch { return '' }
  }

  $action ago(t: number): string {
    const s = Math.floor(Date.now() / 1000 - t)
    if (s < 3600)  return `${Math.floor(s / 60)}m ago`
    if (s < 86400) return `${Math.floor(s / 3600)}h ago`
    return `${Math.floor(s / 86400)}d ago`
  }
}

@template {
  <main>
    <header>
      <h1>aihu HN</h1>
      <nav>
        <a href={`/?page=${Math.max(1, route.data.page - 1)}`} $if={route.data.page > 1}>&larr; prev</a>
        <span class="page">page {route.data.page}</span>
        <a href={`/?page=${route.data.page + 1}`} $if={route.data.hasMore}>next &rarr;</a>
      </nav>
    </header>

    <ol class="stories" start={(route.data.page - 1) * 30 + 1}>
      <li $each="route.data.stories as item" $key={item.id} class="story">
        <div class="title">
          <a href={item.url ?? `/item/${item.id}`}>{item.title}</a>
          <span class="host" $if={!!item.url}> ({hostname(item.url)})</span>
        </div>
        <div class="meta">
          {item.score} points by
          <a href={`/user/${item.by}`}>{item.by}</a>
          {ago(item.time)} |
          <a href={`/item/${item.id}`}>{item.descendants ?? 0} comments</a>
        </div>
      </li>
    </ol>
  </main>
}

@style {
  main { max-width: 48rem; margin: 1.5rem auto; padding: 0 1rem; font-family: Verdana, system-ui, sans-serif; font-size: 13px; background: var(--bg); color: var(--fg); }
  header { display: flex; justify-content: space-between; align-items: baseline; padding: 0.5rem; background: var(--hn-orange, #ff6600); }
  h1 { color: white; margin: 0; font-size: 1.1rem; }
  nav { color: white; }
  nav a, nav .page { color: white; text-decoration: none; padding: 0 0.4rem; }
  nav a:hover { text-decoration: underline; }
  .stories { padding-left: 2rem; }
  .story { padding: 0.4rem 0; }
  .title a { color: var(--fg); text-decoration: none; font-size: 1rem; }
  .title a:hover { text-decoration: underline; }
  .host { color: var(--muted); font-size: 0.85em; }
  .meta { color: var(--muted); font-size: 0.85em; padding-top: 0.1rem; }
  .meta a { color: var(--muted); }
  .meta a:hover { text-decoration: underline; color: var(--fg); }

  @media (max-width: 480px) {
    main { padding: 0 0.5rem; }
    .stories { padding-left: 1rem; }
    .title a { font-size: 0.95rem; }
  }
}

@agent {
  $expose route

  $describe route "Top stories data: stories array, current page, hasMore flag"
}
