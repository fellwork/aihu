@route {
  path: "/item/[id]",
  name: "hn-item",
  ssr: true
}

@state {
  import type { HnItem, CommentNode } from './[id].loader.ts'

  // arch-5 M1: $route reactive signal — see currentRoute.params.id when consumed
  // by descendant components. The page itself still receives data via the
  // existing $prop route loader pattern (compiled into custom-element attr).
  $prop: {
    route: { type: { data: { story: HnItem; comments: Array<CommentNode> } } },
  }

  $action: {
    hostname: (u: string | undefined): string => {
      if (!u) return ''
      try { return new URL(u).hostname.replace(/^www\./, '') } catch { return '' }
    },
    ago: (t: number | undefined): string => {
      if (!t) return ''
      const s = Math.floor(Date.now() / 1000 - t)
      if (s < 3600)  return `${Math.floor(s / 60)}m ago`
      if (s < 86400) return `${Math.floor(s / 3600)}h ago`
      return `${Math.floor(s / 86400)}d ago`
    },
  }

  $route currentRoute

  // arch-5 M1: post-navigation analytics — runs after each successful nav.
  $afterNavigate((to) => {
    if (typeof window !== 'undefined' && (window as any).analytics?.pageview) {
      (window as any).analytics.pageview(to.pathname)
    }
  })
}

@template {
  <main class="hn-item">
    <header>
      <a href="/">&larr; back to top</a>
    </header>

    <article class="story">
      <h1>
        <a href={route().data.story.url ?? `/item/${route().data.story.id}`}>{route().data.story.title}</a>
        <span class="host" if={!!route().data.story.url}> ({hostname(route().data.story.url)})</span>
      </h1>
      <div class="meta">
        {route().data.story.score ?? 0} points by
        <a href={`/user/${route().data.story.by}`} prefetch="hover">{route().data.story.by}</a>
        {ago(route().data.story.time)} | {route().data.story.descendants ?? 0} comments
      </div>
      <div class="text" if={!!route().data.story.text} html={route().data.story.text}></div>
    </article>

    <section class="comments">
      <h2 if={route().data.comments.length > 0}>Comments</h2>
      <hn-comment each={item of route().data.comments} key={item.id} comment={item} />
    </section>
  </main>
}

@style {
  /* DA4: light-DOM page — selectors scoped under the page root class so they
     stay page-local in the global cascade. */
  .hn-item { max-width: 48rem; margin: 1.5rem auto; padding: 0 1rem; font-family: Verdana, system-ui, sans-serif; font-size: 13px; background: var(--bg); color: var(--fg); }
  .hn-item header { padding: 0.5rem; background: var(--hn-orange, #ff6600); }
  .hn-item header a { color: white; text-decoration: none; }
  .hn-item .story { padding: 1rem 0; }
  .hn-item .story h1 { font-size: 1.1rem; margin: 0 0 0.25rem 0; }
  .hn-item .story h1 a { color: var(--fg); text-decoration: none; }
  .hn-item .story h1 a:hover { text-decoration: underline; }
  .hn-item .host { color: var(--muted); font-size: 0.85em; font-weight: normal; }
  .hn-item .meta { color: var(--muted); font-size: 0.85em; }
  .hn-item .meta a { color: var(--muted); }
  .hn-item .text { padding: 0.5rem 0; line-height: 1.5; }
  .hn-item .comments h2 { font-size: 1rem; margin: 1rem 0 0.5rem 0; padding-bottom: 0.25rem; border-bottom: 1px solid var(--border); }

  @media (max-width: 480px) {
    .hn-item { padding: 0 0.5rem; }
  }
}
