@route {
  path: "/",
  name: "hn-top",
  ssr: true
}

@state {
  import type { Story } from './index.loader.ts'

  $prop route: {
    data: { stories: Array<Story>; page: number; hasMore: boolean }
  }

  $action hostname(u: string | undefined): string {
    if (!u) return ''
    try { return new URL(u).hostname.replace(/^www\./, '') } catch { return '' }
  }

  $action ago(t: number): string {
    const s = Math.floor(Date.now() / 1000 - t)
    if (s < 3600)  return `${Math.floor(s / 60)}m ago`
    if (s < 86400) return `${Math.floor(s / 3600)}h ago`
    return `${Math.floor(s / 86400)}d ago`
  }
}

@template {
  <main>
    <header>
      <h1>scribe HN</h1>
      <nav>
        <a href={`/?page=${Math.max(1, route.data.page - 1)}`} $if={route.data.page > 1}>&larr; prev</a>
        <span class="page">page {route.data.page}</span>
        <a href={`/?page=${route.data.page + 1}`} $if={route.data.hasMore}>next &rarr;</a>
      </nav>
    </header>

    <ol class="stories" start={(route.data.page - 1) * 30 + 1}>
      <li $each="route.data.stories as s" $key="s.id" class="story">
        <div class="title">
          <a href={s.url ?? `/item/${s.id}`}>{s.title}</a>
          <span class="host" $if={!!s.url}> ({hostname(s.url)})</span>
        </div>
        <div class="meta">
          {s.score} points by
          <a href={`/user/${s.by}`}>{s.by}</a>
          {ago(s.time)} |
          <a href={`/item/${s.id}`}>{s.descendants ?? 0} comments</a>
        </div>
      </li>
    </ol>
  </main>
}

@style {
  main { max-width: 48rem; margin: 1.5rem auto; padding: 0 1rem; font-family: Verdana, system-ui, sans-serif; font-size: 13px; }
  header { display: flex; justify-content: space-between; align-items: baseline; padding: 0.5rem; background: #ff6600; }
  h1 { color: white; margin: 0; font-size: 1.1rem; }
  nav { color: white; }
  nav a, nav .page { color: white; text-decoration: none; padding: 0 0.4rem; }
  nav a:hover { text-decoration: underline; }
  .stories { padding-left: 2rem; }
  .story { padding: 0.4rem 0; }
  .title a { color: black; text-decoration: none; font-size: 1rem; }
  .title a:hover { text-decoration: underline; }
  .host { color: #828282; font-size: 0.85em; }
  .meta { color: #828282; font-size: 0.85em; padding-top: 0.1rem; }
  .meta a { color: #828282; }
  .meta a:hover { text-decoration: underline; color: #525252; }
}
