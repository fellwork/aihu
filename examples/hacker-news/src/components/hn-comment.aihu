@state {
  import type { CommentNode } from '../pages/item/[id].loader.ts'

  $prop: {
    comment: { type: CommentNode },
  }

  $action: {
    ago: (t: number): string => {
      const s = Math.floor(Date.now() / 1000 - t)
      if (s < 3600)  return `${Math.floor(s / 60)}m ago`
      if (s < 86400) return `${Math.floor(s / 3600)}h ago`
      return `${Math.floor(s / 86400)}d ago`
    },
  }
}

@template {
  <div class="comment">
    <div class="meta">
      <a href={`/user/${comment().by}`}>{comment().by}</a>
      {ago(comment().time)}
    </div>
    <div class="text" html={comment().text}></div>
    <div class="replies" if={comment().children.length > 0}>
      <hn-comment each={item of comment().children} key={item.id} comment={item} />
    </div>
  </div>
}

@style {
  .comment { padding: 0.5rem 0; border-left: 2px solid var(--border); padding-left: 0.75rem; margin-top: 0.5rem; }
  .meta    { color: var(--muted); font-size: 0.85em; }
  .meta a  { color: var(--muted); text-decoration: none; }
  .meta a:hover { text-decoration: underline; }
  .text    { padding: 0.4rem 0; line-height: 1.45; font-size: 0.95em; color: var(--fg); }
  .text :global(p)    { margin: 0.4rem 0; }
  .text :global(pre)  { background: var(--code-bg); padding: 0.5rem; overflow-x: auto; }
  .replies { margin-left: 0.25rem; }
}
