@state {
  import type { CommentNode } from '../pages/item/[id].loader.ts'

  $prop comment: CommentNode

  $action ago(t: number): string {
    const s = Math.floor(Date.now() / 1000 - t)
    if (s < 3600)  return `${Math.floor(s / 60)}m ago`
    if (s < 86400) return `${Math.floor(s / 3600)}h ago`
    return `${Math.floor(s / 86400)}d ago`
  }

  $action childKey(c: { id: number }): number { return c.id }
}

@template {
  <div class="comment">
    <div class="meta">
      <a href={`/user/${comment.by}`}>{comment.by}</a>
      {ago(comment.time)}
    </div>
    <div class="text" $html="comment.text"></div>
    <div class="replies" $if={comment.children.length > 0}>
      <Comment $each="comment.children" $key="childKey" comment={item} />
    </div>
  </div>
}

@style {
  .comment { padding: 0.5rem 0; border-left: 2px solid #f0f0f0; padding-left: 0.75rem; margin-top: 0.5rem; }
  .meta    { color: #828282; font-size: 0.85em; }
  .meta a  { color: #828282; text-decoration: none; }
  .meta a:hover { text-decoration: underline; }
  .text    { padding: 0.4rem 0; line-height: 1.45; font-size: 0.95em; }
  .text :global(p)    { margin: 0.4rem 0; }
  .text :global(pre)  { background: #f5f5f5; padding: 0.5rem; overflow-x: auto; }
  .replies { margin-left: 0.25rem; }
}
