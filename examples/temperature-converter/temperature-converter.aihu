// 7GUIs #2 — bidirectional binding flagship.
// M1 polish: @agent block + dark-mode tokens.

@state {
  $prop: {
    celsius: { default: 20, describe: 'Temperature in degrees Celsius', expose: { read: true } },
  }

  $computed: {
    fahrenheit: {
      describe: 'Temperature in degrees Fahrenheit (computed)',
      expose: { read: true },
      value: () => celsius * 9 / 5 + 32,
    },
  }

  $action: {
    setFromF: {
      describe: 'Set the temperature by Fahrenheit value',
      expose: { read: true, write: true },
      handler: (f: number) => {
        celsius = (f - 32) * 5 / 9
      },
    },
    setCelsius: {
      describe: 'Set the temperature by Celsius value',
      expose: { read: true, write: true },
      handler: (c: number) => {
        celsius = c
      },
    },
  }
}

@template {
  <fieldset>
    <legend>Temperature converter</legend>
    <label>
      <span>Celsius</span>
      <input type="number" $bind:value="celsius" >
    </label>
    <label>
      <span>Fahrenheit</span>
      <input
        type="number"
        value={fahrenheit}
        $on:input={(e) => setFromF(Number(e.target.value))}
      >
    </label>
  </fieldset>
}

@style {
  fieldset {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    max-width: 22rem;
    background: var(--panel-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--card-shadow);
    color: var(--fg);
  }
  legend { font-weight: 600; color: var(--fg); padding: 0 4px; }
  label  { display: grid; grid-template-columns: 8ch 1fr; align-items: baseline; gap: 0.5rem; }
  span   { color: var(--muted); }
  input  {
    font-variant-numeric: tabular-nums;
    padding: 0.4rem 0.5rem;
    background: var(--input-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--fg);
    font-size: 1rem;
  }
  input:focus { outline: 2px solid var(--focus-ring); outline-offset: 1px; }
}
