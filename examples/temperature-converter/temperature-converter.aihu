// 7GUIs #2 — bidirectional binding flagship.
// M1 polish: @agent block + dark-mode tokens.

@state {
  import { signal } from '@aihu/signals'
  const [celsius, writeCelsius] = signal(20)

  $computed: {
    fahrenheit: {
      describe: 'Temperature in degrees Fahrenheit (computed)',
      expose: { read: true },
      value: () => celsius() * 9 / 5 + 32,
    },
  }

  $action: {
    setFromF: {
      describe: 'Set the temperature by Fahrenheit value',
      expose: { read: true, write: true },
      handler: (f: number) => writeCelsius((f - 32) * 5 / 9),
    },
    setCelsius: {
      describe: 'Set the temperature by Celsius value',
      expose: { read: true, write: true },
      handler: (c: number) => writeCelsius(c),
    },
  }
}

@template {
  <fieldset>
    <legend>Temperature converter</legend>
    <label>
      <span>Celsius</span>
      <input type="number" $bind.value="celsius" >
    </label>
    <label>
      <span>Fahrenheit</span>
      <input
        type="number"
        $value={fahrenheit}
        $on.input={(e) => setFromF(Number((e.target as HTMLInputElement).value))}
      >
    </label>
  </fieldset>
}

@style {
  fieldset {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    max-width: 22rem;
    background: var(--panel-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--card-shadow);
    color: var(--fg);
  }
  legend { color: var(--muted); font-size: 0.875rem; padding: 0 4px; }
  label  { display: grid; grid-template-columns: 6rem 1fr; align-items: center; gap: 0.5rem; }
  span   { color: var(--muted); }
  input[type="number"] {
    padding: 0.4rem 0.6rem;
    background: var(--input-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--fg);
    font-size: 1rem;
    width: 100%;
  }
  input[type="number"]:focus { outline: 2px solid var(--focus-ring); outline-offset: 1px; }
}
