// 7GUIs #4 — effects + cleanup + a slider-controlled duration.
// M1 polish: @agent block + dark-mode tokens.

@state {
  $prop: {
    duration: {
      default: 10000,
      describe: 'Timer duration in milliseconds (slider-controlled)',
      expose: { read: true },
    },
    elapsed: { default: 0, describe: 'Elapsed time in milliseconds', expose: { read: true } },
  }

  intervalId: number | null = null

  $computed: {
    progress: {
      describe: 'Elapsed fraction from 0 to 1',
      expose: { read: true },
      value: () => duration === 0 ? 0 : Math.min(elapsed / duration, 1),
    },
    seconds: () => (elapsed / 1000).toFixed(1),
    maxSecs: () => (duration / 1000).toFixed(1),
    done: () => elapsed >= duration,
  }

  $action: {
    tick: () => {
      if (elapsed < duration) {
        elapsed = Math.min(elapsed + 100, duration)
      }
    },
    reset: {
      describe: 'Reset the elapsed time to 0',
      expose: { read: true, write: true },
      handler: () => {
        elapsed = 0
      },
    },
  }

  $lifecycle: {
    mount: () => {
      intervalId = setInterval(() => tick(), 100) as unknown as number
    },
    dispose: () => {
      if (intervalId !== null) clearInterval(intervalId)
    },
  }
}

@template {
  <section class="timer">
    <h1>Timer</h1>
    <label>
      <span>Elapsed</span>
      <progress value={progress} max="1"></progress>
    </label>
    <p class="readout">{seconds}s / {maxSecs}s</p>
    <label>
      <span>Duration</span>
      <input
        type="range"
        min="1000"
        max="30000"
        step="500"
        $bind:value="duration"
      />
    </label>
    <button $on:click="reset">Reset</button>
    <p class="status" $if={done}>Done.</p>
  </section>
}

@style {
  .timer    { display: grid; gap: 0.75rem; padding: 1.5rem; max-width: 24rem; background: var(--panel-bg); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--card-shadow); color: var(--fg); }
  h1        { margin: 0; color: var(--fg); }
  label     { display: grid; grid-template-columns: 6rem 1fr; align-items: center; gap: 0.5rem; }
  span      { color: var(--muted); }
  progress  { width: 100%; height: 1rem; accent-color: var(--accent); }
  .readout  { font-variant-numeric: tabular-nums; margin: 0; color: var(--fg); }
  input[type="range"] { accent-color: var(--accent); }
  button    { padding: 0.5rem 0.75rem; cursor: pointer; background: var(--btn-bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--fg); transition: background 0.1s; }
  button:hover { background: var(--hover-bg); }
  .status   { color: var(--success); font-weight: 600; margin: 0; }
}
