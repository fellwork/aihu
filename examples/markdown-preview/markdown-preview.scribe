// Reactive text transform: input -> $computed -> $html, with scoped <style>.
// Demo-grade markdown via inline regex (no runtime deps, per Learning #49).
// SECURITY: $html is innerHTML; the example uses author-controlled input only.

@state {
  source: string = '# Hello, scribe\n\nType **markdown** _here_ and watch it render.\n\n- list item\n- another item\n\n[Link](https://github.com/fellwork/scribe)\n\n`inline code`'

  // Demo-grade markdown: ~15 LOC of regex. Not production-grade.
  // Order matters: code spans first, then headings, then inline marks.
  $action renderMd(src: string): string {
    let s = src
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
    s = s.replace(/`([^`]+)`/g, '<code>$1</code>')
    s = s.replace(/^### (.*)$/gm, '<h3>$1</h3>')
    s = s.replace(/^## (.*)$/gm,  '<h2>$1</h2>')
    s = s.replace(/^# (.*)$/gm,   '<h1>$1</h1>')
    s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    s = s.replace(/_([^_]+)_/g,       '<em>$1</em>')
    s = s.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" rel="noopener">$1</a>')
    s = s.replace(/^- (.*)$/gm, '<li>$1</li>')
    s = s.replace(/(<li>.*<\/li>(?:\n<li>.*<\/li>)*)/g, '<ul>$1</ul>')
    s = s.replace(/\n\n+/g, '</p><p>')
    return '<p>' + s + '</p>'
  }

  $computed rendered = renderMd(source)
}

@template {
  <section class="md-preview">
    <header><h1>Markdown preview</h1></header>
    <div class="grid">
      <label>
        <span>Source</span>
        <textarea $bind:value="source" rows="12"></textarea>
      </label>
      <article class="output" $html={rendered}></article>
    </div>
  </section>
}

@style {
  .md-preview { display: grid; gap: 0.75rem; padding: 1rem; max-width: 64rem; font-family: system-ui, sans-serif; }
  h1          { margin: 0; }
  .grid       { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  textarea    { width: 100%; font: 0.95rem ui-monospace, monospace; padding: 0.5rem; }
  .output     { padding: 0.75rem 1rem; border: 1px solid #ddd; border-radius: 4px; background: #fafafa; }
  .output h1  { font-size: 1.5rem; }
  .output h2  { font-size: 1.25rem; }
  .output h3  { font-size: 1.1rem; }
  .output code { background: #eee; padding: 0.1rem 0.3rem; border-radius: 3px; font: 0.9em ui-monospace, monospace; }
  .output ul  { padding-left: 1.25rem; }
}
