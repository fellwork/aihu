@route {
  path: "/",
  name: "css-engine-utility-index"
}

@template {
  <section class="max-w-7xl mx-auto flex flex-col gap-6 px-4 py-6">
    <h1 class="text-lg font-bold">css-engine utility classes</h1>
    <p class="text-sm">
      Utility classes (<code>max-w-7xl</code>, <code>mx-auto</code>,
      <code>flex</code>, <code>flex-col</code>, <code>gap-6</code>,
      <code>px-4</code>, <code>py-6</code>, <code>text-lg</code>,
      <code>font-bold</code>, <code>text-sm</code>) are compiled by
      <code>@aihu/css-engine</code> via the compiler hook wired into
      <code>viteAihuPlugin</code>. Because <code>css.shadowMode: 'none'</code>
      is set, the generated CSS lands in the document cascade.
    </p>

    <div class="grid grid-cols-3 gap-4">
      <div class="border-2 rounded p-4">one</div>
      <div class="border-2 rounded p-4">two</div>
      <div class="border-2 rounded p-4">three</div>
    </div>

    <ul class="space-y-4">
      <li class="text-sm">space-y-4 keeps siblings evenly stacked</li>
      <li class="text-sm">no margin on the first child</li>
      <li class="text-sm">margin-block-start on the rest</li>
    </ul>

    <div class="@container border-2 rounded p-4">
      <div class="@md:flex gap-4">
        <span class="text-sm">@container parent</span>
        <span class="text-sm">@md:flex child (lays out as a row at ≥28rem)</span>
      </div>
    </div>

    <button class="aria-expanded:bg-accent data-[state=open]:underline border-2 rounded px-4 py-6">
      aria-expanded:/data-[state=open]: attribute-variant toggle
    </button>

    <p class="text-sm">
      All classes used here are in the engine's supported vocabulary — see
      <code>apps/docs/.../reference/utility-classes.md</code> for the full
      table, including what is <em>not</em> yet supported (e.g.
      <code>group:</code>/<code>peer:</code> variants and motion utilities).
    </p>
  </section>
}
