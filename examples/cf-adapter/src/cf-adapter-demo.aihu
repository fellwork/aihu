// EX-10 cf-adapter-demo — Cloudflare Workers adapter demo.
// Demonstrates @aihu/adapter-cloudflare wired in aihu.config.ts.
// Shows adapter config metadata and worker deployment details.

@state {
  import { signal, computed } from '@aihu/signals'
  const [workerName, setWorkerName] = signal('cf-adapter-demo')

  const [deployMode, setDeployMode] = signal('workers')

  const statusLabel = computed(() => 'Ready to deploy')
}

@template {
  <section class="cf-demo">
    <h1>EX-10 — Cloudflare Workers Adapter</h1>

    <div class="config-card">
      <div class="config-item">
        <span class="config-label">Worker name</span>
        <span class="config-value">{workerName()}</span>
      </div>

      <div class="config-item">
        <span class="config-label">Deploy mode</span>
        <span class="config-badge">{deployMode()}</span>
      </div>

      <div class="config-item">
        <span class="config-label">Status</span>
        <span class="config-status">{statusLabel()}</span>
      </div>
    </div>

    <div class="adapter-note">
      <p>
        This example wires <code>@aihu/adapter-cloudflare</code> via
        <code>aihu.config.ts</code>. Running <code>vite build</code> produces
        a <code>_worker.js</code> entry compatible with Cloudflare Workers.
        See <code>wrangler.toml</code> for deployment config.
      </p>
      <p class="note-muted">
        Deploy with: <code>wrangler deploy --config wrangler.toml</code>
      </p>
    </div>

    <agent-panel></agent-panel>
  </section>
}

@style {
  .cf-demo {
    display: grid;
    gap: 1.5rem;
    padding: 2rem;
    max-width: var(--max-w);
    margin: 0 auto;
    color: var(--fg);
  }

  h1 {
    margin: 0;
    font-size: 1.4rem;
    color: var(--fg);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
  }

  .config-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--panel-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    box-shadow: var(--card-shadow);
  }

  .config-item {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .config-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    min-width: 7rem;
  }

  .config-value {
    font-family: monospace;
    font-size: 0.95rem;
    color: var(--fg);
  }

  .config-badge {
    font-size: 0.8rem;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    background: var(--tag-bg);
    color: var(--tag-fg);
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .config-status {
    font-size: 0.9rem;
    color: var(--success);
    font-weight: 500;
  }

  .adapter-note {
    background: var(--hover-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
  }

  .adapter-note p {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    color: var(--fg);
    line-height: 1.6;
  }

  .adapter-note p:last-child {
    margin-bottom: 0;
  }

  .note-muted {
    color: var(--muted);
  }

  .adapter-note code {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.1em 0.35em;
    font-size: 0.85em;
    color: var(--accent);
  }

  @media (max-width: 480px) {
    .cf-demo { padding: 1rem; }
    .config-card { flex-direction: column; }
    .config-item { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
    .config-label { min-width: unset; }
  }
}
