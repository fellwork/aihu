// @agent flagship #2 — enum inputs (the most under-demoed grammar feature).
// Static rate table; pure-computed conversion; same value exposed to humans and agents.

@state {
  // Standalone signals so the example is interactive without a parent.
  // For a parent-driven variant, swap to $prop declarations and remove
  // the $bind:value attributes from <select> / <input>.
  let from = prop<'USD' | 'EUR' | 'GBP' | 'JPY'>({
    default: 'USD',
    describe: 'Source currency code (USD | EUR | GBP | JPY)',
    expose: 'read',
  })
  let to = prop<'USD' | 'EUR' | 'GBP' | 'JPY'>({
    default: 'EUR',
    describe: 'Target currency code (USD | EUR | GBP | JPY)',
    expose: 'read',
  })
  let amount = prop({ default: 100, describe: 'Amount in the source currency', expose: 'read' })

  // USD-relative static rates. converted = amount * (rateOf(to) / rateOf(from)).
  const rates: Record<'USD' | 'EUR' | 'GBP' | 'JPY', number> = {
    USD: 1.0,
    EUR: 0.92,
    GBP: 0.79,
    JPY: 156.0,
  }

  const converted = derived(
    { describe: 'Equivalent amount in the target currency, computed from the static rate table',
      expose: 'read' },
    () => amount * (rates[to] / rates[from]))
  const display = derived(() => converted.toFixed(2))
}

@template {
  <section class="converter">
    <h1>Currency converter</h1>

    <div class="row">
      <label>
        <span>Amount</span>
        <input type="number" bind:value={amount} min="0" step="0.01" />
      </label>
      <label>
        <span>From</span>
        <select bind:value={from}>
          <option value="USD">USD</option>
          <option value="EUR">EUR</option>
          <option value="GBP">GBP</option>
          <option value="JPY">JPY</option>
        </select>
      </label>
      <label>
        <span>To</span>
        <select bind:value={to}>
          <option value="USD">USD</option>
          <option value="EUR">EUR</option>
          <option value="GBP">GBP</option>
          <option value="JPY">JPY</option>
        </select>
      </label>
    </div>

    <p class="result">
      <strong>{amount}</strong> {from} = <strong>{display}</strong> {to}
    </p>
  </section>
}

@style {
  .converter { display: grid; gap: 0.75rem; padding: 1.5rem; max-width: 28rem; background: var(--panel-bg); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--card-shadow); color: var(--fg); }
  h1         { margin: 0; color: var(--fg); }
  .row       { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem; }
  label      { display: grid; gap: 0.25rem; color: var(--muted); font-size: 0.875rem; }
  input,
  select     { padding: 0.4rem; background: var(--input-bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--fg); }
  input:focus,
  select:focus { outline: 2px solid var(--focus-ring); outline-offset: 1px; }
  .result    { font-size: 1.1rem; padding: 0.5rem 0.75rem; background: var(--code-bg); border-radius: var(--radius); margin: 0; color: var(--fg); font-variant-numeric: tabular-nums; }
  .result strong { color: var(--accent); }

  @media (max-width: 480px) {
    .row { grid-template-columns: 1fr; }
  }
}
