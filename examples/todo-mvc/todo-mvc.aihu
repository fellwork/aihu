// TodoMVC — universal parity anchor.
// M1 v1.1 fix: localStorage persistence via $lifecycle.mount hydrate + $effect persist.
// @agent block: todos/remaining/filter + addTodo/clearCompleted.

@state {
  let todos = state<Array<{ id: string; text: string; done: boolean }>>([])
  let filter = state<'all' | 'active' | 'completed'>('all')
  let draft = state('')
  // ref target: the new-todo input, captured on mount so actions can refocus it.
  let inputEl = state<HTMLInputElement | null>(null)

  const visible = derived(() => filter === 'all'
      ? todos
      : filter === 'active'
        ? todos.filter(t => !t.done)
        : todos.filter(t => t.done))
  const remaining = derived(
    { describe: 'Count of incomplete todos', expose: 'read' },
    () => todos.filter(t => !t.done).length)
  const allDone = derived(() => todos.length > 0 && remaining() === 0)

  const newId = action((): string => {
      return crypto.randomUUID()
    })
  const addTodo = action(
    { describe: 'Add the current draft text as a new todo',
      expose: 'read write' },
    () => {
        const text = draft.trim()
        if (!text) return
        todos = [...todos(), { id: newId(), text, done: false }]
        draft = ''
        // Refocus the new-todo input via the ref captured on mount, so rapid
        // entry keeps the caret in place. This is the behavior the `inputEl`
        // comment promises; FEL-441 makes the captured ref reliable.
        inputEl?.focus()
      })
  const toggle = action((id: string) => {
      todos = todos.map(t => t.id === id ? { ...t, done: !t.done } : t)
    })
  const remove = action((id: string) => {
      todos = todos.filter(t => t.id !== id)
    })
  const clearCompleted = action(
    { describe: 'Remove all completed todos from the list',
      expose: 'read write' },
    () => {
        todos = todos.filter(t => !t.done)
      })
  const setFilter = action((f: 'all' | 'active' | 'completed') => {
      filter = f
    })

  // v1.1 fix: hydrate from localStorage on mount
  onMount(() => {
      try {
        const saved = localStorage.getItem('aihu-todos')
        if (saved) {
          const parsed = JSON.parse(saved)
          if (Array.isArray(parsed)) (todos = parsed)
        }
      } catch {
        // localStorage unavailable (SSR, private mode, corrupted) — start fresh
      }
    })

  // v1.1 fix: persist to localStorage on every todos change
  effect(() => {
    try {
      localStorage.setItem('aihu-todos', JSON.stringify(todos))
    } catch {
      // ignore quota exceeded / SecurityError
    }
  })
}

@template {
  <section class="todoapp">
    <header>
      <h1>todos</h1>
      <!-- on:submit.prevent — the dotted event-modifier surface; ref captures
           the input element into a signal. -->
      <form class="new-todo-form" on:submit.prevent={addTodo}>
        <input
          class="new-todo"
          placeholder="What needs to be done?"
          bind:value={draft}
          ref={inputEl}
          autofocus
        >
      </form>
      <!-- show= — toggles [hidden] reactively (kept in the DOM, unlike if=). -->
      <p class="all-done" show={allDone()} role="status">All done — nice.</p>
    </header>

    <ul class="todo-list">
      <li
        each={todo of visible}
        key={todo.id}
        class={todo.done ? 'completed' : ''}
      >
        <input
          type="checkbox"
          checked={todo.done}
          on:change={() => toggle(todo.id)}
        >
        <label>{todo.text}</label>
        <button class="destroy" on:click={() => remove(todo.id)}>×</button>
      </li>
      <!-- empty — the each-fallback, rendered only when `visible` is empty. -->
      <li empty class="todo-empty">Nothing here yet — add your first todo above.</li>
    </ul>

    <footer if={todos.length > 0}>
      <span class="todo-count">
        <strong>{remaining}</strong> item{remaining() === 1 ? '' : 's'} left
      </span>
      <ul class="filters">
        <li><button on:click={() => setFilter('all')}       class={filter === 'all' ? 'selected' : ''}>All</button></li>
        <li><button on:click={() => setFilter('active')}    class={filter === 'active' ? 'selected' : ''}>Active</button></li>
        <li><button on:click={() => setFilter('completed')} class={filter === 'completed' ? 'selected' : ''}>Completed</button></li>
      </ul>
      <button
        class="clear-completed"
        if={todos.length - remaining() > 0}
        on:click={clearCompleted}
      >
        Clear completed
      </button>
    </footer>
  </section>
}

@style {
  .todoapp { max-width: 32rem; margin: 2rem auto; }
  .todoapp h1 { font-size: 2rem; color: var(--accent); margin: 0 0 0.5rem 0; }
  .new-todo-form { margin: 0; }
  .all-done { margin: 0.5rem 0 0; color: var(--accent); font-size: 0.9rem; font-weight: 600; }
  .todo-empty { display: block; padding: 0.75rem 0; color: var(--muted); font-style: italic; border-bottom: 0; }
  .new-todo { width: 100%; padding: 0.75rem; font-size: 1rem; background: var(--input-bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--fg); }
  .new-todo:focus { outline: 2px solid var(--focus-ring); outline-offset: 1px; }
  .todo-list { list-style: none; padding: 0; margin: 0.5rem 0; }
  .todo-list li { display: grid; grid-template-columns: auto 1fr auto; gap: 0.5rem; padding: 0.5rem 0; border-bottom: 1px solid var(--border); align-items: center; }
  .completed label { text-decoration: line-through; color: var(--muted); }
  footer { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; padding-top: 0.75rem; font-size: 0.9rem; color: var(--muted); }
  .filters { display: flex; gap: 0.5rem; list-style: none; padding: 0; margin: 0; }
  .filters button { background: none; border: 1px solid transparent; border-radius: var(--radius); padding: 2px 6px; cursor: pointer; color: var(--muted); }
  .filters button:hover { border-color: var(--border); color: var(--fg); }
  .filters .selected { border-color: var(--accent); color: var(--accent); font-weight: 600; }
  .destroy { background: transparent; border: 0; cursor: pointer; color: var(--muted); font-size: 1.1rem; }
  .destroy:hover { color: var(--error); }
  .clear-completed { background: none; border: none; cursor: pointer; color: var(--muted); font-size: 0.9rem; text-decoration: underline; padding: 0; }
  .clear-completed:hover { color: var(--fg); }
  input[type="checkbox"] { accent-color: var(--accent); width: 18px; height: 18px; cursor: pointer; }

  @media (max-width: 480px) {
    footer { font-size: 0.8rem; }
    .filters { gap: 0.25rem; }
  }
}
