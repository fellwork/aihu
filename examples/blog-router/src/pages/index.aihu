@route {
  path: "/",
  name: "blog-index"
}

@state {
  const posts: Array<{ slug: string; title: string }> = [

  const postKey = action((p: { slug: string }): string => {
      return p.slug
    })

  { slug: 'hello',  title: 'Hello, world' },

  { slug: 'meta',   title: 'Why aihu is meta' },

  { slug: 'agents', title: 'Agents are first-class' },

  ]
}

@template {
  <main class="blog-index">
    <h1>The aihu blog</h1>
    <ul>
      <li each={item of posts} key={item.slug}>
        <a href={`/posts/${item.slug}`}>{item.title}</a>
      </li>
    </ul>
    <p><a href="/about">About this blog</a></p>
  </main>
}

@style {
  /* DA4: pages are light DOM by default, so this @style joins the GLOBAL
     cascade — every selector is scoped under the page root class so bare
     element selectors (main, h1, a, ...) don't bleed into other pages. */
  .blog-index { max-width: 38rem; margin: 2rem auto; font-family: system-ui, sans-serif; }
  .blog-index h1 { margin-bottom: 1rem; }
  .blog-index ul { list-style: none; padding: 0; }
  .blog-index li { padding: 0.25rem 0; }
  .blog-index a { color: #0070f3; text-decoration: none; }
  .blog-index a:hover { text-decoration: underline; }
}
