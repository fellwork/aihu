@route {
  path: "/about",
  name: "blog-about"
}

@template {
  <main>
    <h1>About this blog</h1>
    <p>This example demonstrates file-based routing in scribe.
       Each <code>.scribe</code> file under <code>src/pages/</code>
       becomes a route automatically.</p>
    <p><a href="/">Home</a></p>
  </main>
}

@style {
  main { max-width: 38rem; margin: 2rem auto; font-family: system-ui, sans-serif; line-height: 1.55; }
  code { background: #f5f5f5; padding: 0.1rem 0.3rem; border-radius: 3px; font-size: 0.9em; }
  a    { color: #0070f3; text-decoration: none; }
  a:hover { text-decoration: underline; }
}
