@route {
  path: "/posts/[slug]",
  name: "blog-loader-post",
  ssr: true
}

@state {
  // Inject ReadingContext — a parallel data channel provided server-side in
  // [slug].loader.ts via @aihu/context/ssr runWithContext + provide.
  // This demonstrates @aihu/context alongside route.data; it is NOT a
  // replacement for route.data but an additive context slot.
  import { inject } from '@aihu/context'
  import { ReadingContextToken } from './[slug].loader.ts'

  // The loader runs server-side (see [slug].loader.ts) and the resolved
  // payload is injected as the `route.data` prop. See:
  //   docs/site/data-fetching.md → "Server loaders → SFC handoff"
  const route = prop<{ params: { slug: string }; data: { title: string; body: string; readingTimeMs: number } }>()
  const readingCtx = inject(ReadingContextToken)
}

@template {
  <article class="loader-post">
    <a href="/">&larr; Back</a>

    <suspense source="route.data">
      <slot name="fallback">
        <p class="loading">Loading post...</p>
      </slot>

      <h1>{route.data.title}</h1>
      <p class="meta">
        About {Math.round(route.data.readingTimeMs / 1000)}s to read
      </p>
      <p>{route.data.body}</p>

      <!-- context-badge: sourced from injected ReadingContext (parallel to route.data) -->
      <p class="context-badge">
        Context slug: {readingCtx?.slug ?? route.params.slug}
      </p>
    </suspense>
  </article>
}

@style {
  /* DA4: light-DOM page — selectors scoped under the page root class so they
     stay page-local in the global cascade (generic names like `.meta` would
     otherwise collide with other pages' rules). */
  .loader-post { max-width: 38rem; margin: 2rem auto; font-family: system-ui, sans-serif; line-height: 1.55; }
  .loader-post h1 { margin-top: 1rem; }
  .loader-post .meta { color: var(--text-muted); font-size: 0.9em; }
  .loader-post .loading { color: var(--text-muted); font-style: italic; }
  .loader-post a { color: var(--accent); text-decoration: none; }
  .loader-post a:hover { text-decoration: underline; }
  .loader-post .context-badge {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.2em 0.6em;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 0.8em;
    color: var(--text);
    font-family: monospace;
  }
  @media (max-width: 480px) {
    .loader-post { margin: 1rem; }
    .loader-post .context-badge { font-size: 0.75em; }
  }
}
