@route {
  path: "/posts/[slug]",
  name: "blog-loader-post",
  ssr: true
}

@state {
  // The loader runs server-side (see [slug].loader.ts) and the resolved
  // payload is injected as the `route.data` prop. See:
  //   docs/site/data-fetching.md → "Server loaders → SFC handoff"
  $prop: {
    route: {
      type: { params: { slug: string } data: { title: string; body: string; readingTimeMs: number } },
    },
  }

  // Inject ReadingContext — a parallel data channel provided server-side in
  // [slug].loader.ts via @aihu/context/ssr runWithContext + provide.
  // This demonstrates @aihu/context alongside route.data; it is NOT a
  // replacement for route.data but an additive context slot.
  import { inject } from '@aihu/context'
  import { ReadingContextToken } from './[slug].loader.ts'
  const readingCtx = inject(ReadingContextToken)
}

@template {
  <article>
    <a href="/">&larr; Back</a>

    <$suspense source="route.data">
      <$slot name="fallback">
        <p class="loading">Loading post...</p>
      </$slot>

      <h1>{route.data.title}</h1>
      <p class="meta">
        About {Math.round(route.data.readingTimeMs / 1000)}s to read
      </p>
      <p>{route.data.body}</p>

      <!-- context-badge: sourced from injected ReadingContext (parallel to route.data) -->
      <p class="context-badge">
        Context slug: {readingCtx?.slug ?? route.params.slug}
      </p>
    </$suspense>
  </article>
}

@style {
  article { max-width: 38rem; margin: 2rem auto; font-family: system-ui, sans-serif; line-height: 1.55; }
  h1      { margin-top: 1rem; }
  .meta   { color: var(--text-muted); font-size: 0.9em; }
  .loading { color: var(--text-muted); font-style: italic; }
  a       { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .context-badge {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.2em 0.6em;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 0.8em;
    color: var(--text);
    font-family: monospace;
  }
  @media (max-width: 480px) {
    article { margin: 1rem; }
    .context-badge { font-size: 0.75em; }
  }
}

@agent {
  // Agent surface for blog-loader-post — exposes the currently rendered post
  // and a list of known slugs for agent discoverability.
  // Arch-2 §0: every example demonstrates BOTH a human UX and an agent surface.

  expose: {
    getPost: {
      // Returns the current post's title, body, and readingTimeMs
      // sourced from the route.data prop (the loader handoff).
      title: route.data.title,
      body: route.data.body,
      readingTimeMs: route.data.readingTimeMs,
    },
    listPosts: {
      // Mirrors POSTS keys in [slug].loader.ts — update both if posts change.
      slugs: ["hello", "meta", "agents"],
    },
  }
}
