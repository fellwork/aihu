<!-- Recipe: ref-dom — $ref={myRef} + accessing DOM element in $lifecycle.mount -->

@state {
  canvasEl: HTMLCanvasElement | null = null
  width: number = 300
  height: number = 150

  $lifecycle: {
    mount: () => {
      if (!canvasEl) return
      const ctx = canvasEl.getContext('2d')
      if (!ctx) return
      // Draw a simple gradient to prove the ref works.
      const gradient = ctx.createLinearGradient(0, 0, width, 0)
      gradient.addColorStop(0, '#06f')
      gradient.addColorStop(1, '#f06')
      ctx.fillStyle = gradient
      ctx.fillRect(0, 0, width, height)
      ctx.fillStyle = 'white'
      ctx.font = 'bold 18px sans-serif'
      ctx.textAlign = 'center'
      ctx.fillText('$ref works!', width / 2, height / 2 + 6)
    },
  }
}

@template {
  <div class="canvas-demo">
    <canvas
      $ref={canvasEl}
      width={width}
      height={height}
      class="canvas"
    ></canvas>
    <p class="caption">Canvas drawn via $ref after mount</p>
  </div>
}

@style {
  .canvas-demo { display: grid; gap: 0.5rem; justify-items: center; padding: 1rem; }
  .canvas { border: 1px solid var(--border, #ccc); border-radius: 4px; display: block; }
  .caption { font-size: 0.85rem; color: var(--muted, #888); }
}
