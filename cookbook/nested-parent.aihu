<!-- @cookbook
description: Parent component that composes a child component and listens to its selection event
tags: nested, parent, composition, $on, event, child, action, handler
-->
<!-- Recipe: nested-component (parent) — composes nested-child; listens with $on.selected -->
<!-- Demonstrates parent↔child event composition: child $emit → parent $on handler -->

@state {
  lastSelection: string = '(none)'
  selectionCount: number = 0

  $action: {
    handleSelected: (detail: { value: string; index: number }) => {
      lastSelection = `${detail.value} (index ${detail.index})`
      selectionCount++
    },
  }
}

@template {
  <div class="parent-demo">
    <h3>Parent component</h3>
    <p>Last selection: <strong>{lastSelection}</strong></p>
    <p>Total selections: {selectionCount}</p>

    <nested-child
      $on.selected={(e) => handleSelected(e.detail)}
    ></nested-child>
  </div>
}

@style {
  .parent-demo { display: grid; gap: 1rem; padding: 1.5rem; max-width: 28rem; border: 1px solid var(--border, #ccc); border-radius: 4px; }
}
