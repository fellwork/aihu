<!-- @cookbook
description: Computed values derived from multiple signals with template binding for an order summary
tags: computed, signal, derived, binding, calculation, reactive, price, quantity
-->
<!-- Recipe: computed-values — $computed derived from multiple signals + template binding -->

@state {
  price: number = 10
  quantity: number = 3
  taxRate: number = 0.08

  $computed: {
    subtotal: () => price * quantity,
    tax: () => subtotal * taxRate,
    total: () => subtotal + tax,
    formattedTotal: () => `$${total.toFixed(2)}`,
  }

  $action: {
    setPrice: (v: number) => { price = v },
    setQuantity: (v: number) => { quantity = v },
  }
}

@template {
  <div class="order-summary">
    <label>
      Price
      <input type="number" min="0" step="0.01" $bind.value={price} />
    </label>
    <label>
      Quantity
      <input type="number" min="1" step="1" $bind.value={quantity} />
    </label>
    <dl class="totals">
      <dt>Subtotal</dt><dd>${subtotal.toFixed(2)}</dd>
      <dt>Tax ({(taxRate * 100).toFixed(0)}%)</dt><dd>${tax.toFixed(2)}</dd>
      <dt class="total-label">Total</dt><dd class="total">{formattedTotal}</dd>
    </dl>
  </div>
}

@style {
  .order-summary { display: grid; gap: 0.75rem; max-width: 20rem; padding: 1rem; }
  label { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.9rem; }
  input { padding: 0.4rem; border: 1px solid var(--border, #ccc); border-radius: 4px; }
  .totals { display: grid; grid-template-columns: 1fr auto; gap: 0.25rem 1rem; margin: 0; }
  .total-label, .total { font-weight: bold; }
}
