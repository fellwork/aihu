<!-- @cookbook
description: Agent-surface counter with described actions and exposed computed state for agent introspection
tags: agent, action, computed, expose, describe, mcp, surface, counter, agent-surface
-->
<!-- Recipe: agent-surface — $action with describe/expose for agent visibility + $computed exposed state -->

@state {
  count: number = 0
  label: string = 'Agent Counter'

  $computed: {
    doubled: {
      describe: 'The count multiplied by 2.',
      expose: { read: true },
      value: () => count * 2,
    },
    status: {
      describe: 'Human-readable status of the counter.',
      expose: { read: true },
      value: () => count === 0 ? 'at zero' : count > 0 ? 'positive' : 'negative',
    },
  }

  $action: {
    increment: {
      describe: 'Add 1 to the counter. Use this when the user wants to increase the count.',
      expose: { read: true, write: true },
      handler: () => { count++ },
    },
    decrement: {
      describe: 'Subtract 1 from the counter.',
      expose: { read: true, write: true },
      handler: () => { count-- },
    },
    reset: {
      describe: 'Reset the counter to zero.',
      expose: { read: true, write: true },
      handler: () => { count = 0 },
    },
    setLabel: {
      describe: 'Update the display label for the counter.',
      expose: { read: true, write: true },
      handler: (newLabel: string) => { label = newLabel },
    },
  }
}

@template {
  <section class="agent-counter" aria-label={label}>
    <h2>{label}</h2>
    <output class="count">{count}</output>
    <p class="status">Status: {status} · Doubled: {doubled}</p>
    <div class="controls">
      <button $on.click={decrement}>−</button>
      <button $on.click={reset} class="ghost">Reset</button>
      <button $on.click={increment}>+</button>
    </div>
  </section>
}

@style {
  .agent-counter { display: grid; gap: 0.75rem; padding: 1.5rem; max-width: 16rem; border: 1px solid var(--border, #ccc); border-radius: 4px; }
  .count { font-size: 3rem; font-variant-numeric: tabular-nums; text-align: center; display: block; }
  .status { font-size: 0.85rem; color: var(--muted, #888); text-align: center; }
  .controls { display: flex; gap: 0.5rem; }
  .controls button { flex: 1; padding: 0.5rem; cursor: pointer; border: 1px solid var(--border, #ccc); border-radius: 4px; font-size: 1.2rem; }
  .ghost { background: transparent; }
}
