<!-- @cookbook
description: Router link with programmatic navigation via history.pushState and active-link styling
tags: router, link, navigation, history, pushState, active, computed, lifecycle, prop
-->
<!-- Recipe: router-link — programmatic navigation with history.pushState + active-link styling -->
<!-- TODO: $route / $navigate macros ship with the @route block (arch-5). Using platform APIs below. -->

@state {
  $prop: {
    href: { type: String, default: '/' },
    label: { type: String, default: 'Link' },
    exact: { type: Boolean, default: false },
  }

  currentPath: string = window.location.pathname

  $computed: {
    isActive: () => exact
      ? currentPath === href
      : currentPath.startsWith(href),
  }

  $lifecycle: {
    mount: () => {
      const handler = () => { currentPath = window.location.pathname }
      window.addEventListener('popstate', handler)
    },
  }

  $action: {
    navigate: (e: MouseEvent) => {
      e.preventDefault()
      window.history.pushState({}, '', href)
      window.dispatchEvent(new PopStateEvent('popstate'))
    },
  }
}

@template {
  <a
    href={href}
    class={['router-link', isActive && 'active']}
    aria-current={isActive ? 'page' : undefined}
    $on.click={navigate}
  >
    {label}
  </a>
}

@style {
  .router-link { text-decoration: none; color: var(--fg, #333); padding: 0.25rem 0.5rem; border-radius: 4px; }
  .router-link:hover { background: var(--hover-bg, #f5f5f5); }
  .router-link.active { color: var(--accent, #06f); font-weight: 600; }
}
