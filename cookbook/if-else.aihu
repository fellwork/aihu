<!-- @cookbook
description: Conditional rendering with if/else-if/else chain and reactive computed condition
tags: if, else, conditional, computed, reactive, template, grade, branch
-->
<!-- Recipe: if-else — {#if} / {:else if} / {:else} chain + reactive condition -->

@state {
  $prop: {
    score: { type: Number, default: 0 },
  }

  $computed: {
    grade: () => {
      if (score >= 90) return 'A'
      if (score >= 80) return 'B'
      if (score >= 70) return 'C'
      if (score >= 60) return 'D'
      return 'F'
    },
    passing: () => score >= 60,
  }

  $action: {
    setScore: (v: number) => { score = Math.max(0, Math.min(100, v)) },
  }
}

@template {
  <div class="grade-display">
    <label>
      Score (0–100)
      <input type="range" min="0" max="100" $bind.value={score} />
      <output>{score}</output>
    </label>

    {#if grade === 'A'}
      <p class="grade grade-a">Excellent! Grade A</p>
    {:else if grade === 'B'}
      <p class="grade grade-b">Good work! Grade B</p>
    {:else if grade === 'C'}
      <p class="grade grade-c">Satisfactory. Grade C</p>
    {:else if grade === 'D'}
      <p class="grade grade-d">Needs improvement. Grade D</p>
    {:else}
      <p class="grade grade-f">Not passing. Grade F</p>
    {/if}

    {#if passing}
      <span class="badge pass">PASS</span>
    {:else}
      <span class="badge fail">FAIL</span>
    {/if}
  </div>
}

@style {
  .grade-display { display: grid; gap: 0.75rem; max-width: 22rem; padding: 1rem; }
  label { display: flex; flex-direction: column; gap: 0.25rem; }
  .grade { font-size: 1.1rem; font-weight: bold; padding: 0.5rem; border-radius: 4px; }
  .grade-a { color: #0a0; background: #e8fce8; }
  .grade-b { color: #060; background: #f0fce8; }
  .grade-c { color: #660; background: #fdfce0; }
  .grade-d { color: #a50; background: #fef5e0; }
  .grade-f { color: #c00; background: #fde8e8; }
  .badge { display: inline-block; padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.85rem; font-weight: bold; }
  .pass { background: #0a0; color: white; }
  .fail { background: #c00; color: white; }
}
