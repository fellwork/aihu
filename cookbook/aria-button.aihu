<!-- Recipe: aria-button — accessible button with role/aria-label + keyboard support -->
<!-- TODO: requires B4 for $aria: { role, label } declarative form — stubbed as HTML attrs below -->

@state {
  $prop: {
    label: { type: String, default: 'Action', reflect: true },
    pressed: { type: Boolean, default: false, reflect: true },
  }

  $event: {
    activate: { payload: { pressed: boolean }, describe: 'Button was activated by click or keyboard.' },
  }

  $action: {
    toggle: () => {
      pressed = !pressed
      $emit.activate({ pressed })
    },
    handleKey: (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault()
        toggle()
      }
    },
  }
}

@template {
  <span
    role="button"
    tabindex="0"
    aria-pressed={String(pressed)}
    aria-label={label}
    class={['aria-btn', pressed && 'pressed']}
    $on.click={toggle}
    $on.keydown={handleKey}
  >
    {label}
  </span>
}

@style {
  .aria-btn { display: inline-flex; align-items: center; padding: 0.5rem 1rem; cursor: pointer; border: 2px solid var(--border, #ccc); border-radius: 4px; user-select: none; }
  .aria-btn:focus-visible { outline: 2px solid var(--focus-ring, #06f); outline-offset: 2px; }
  .aria-btn.pressed { background: var(--accent, #06f); color: white; border-color: var(--accent, #06f); }
}
