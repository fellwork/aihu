<!-- Recipe: fetch-data — $resource for async fetch + {#if} loading/error/success states -->

@state {
  $prop: {
    url: { type: String, default: '/api/data' },
  }

  $resource: {
    payload: async () => {
      const res = await fetch(url)
      if (!res.ok) throw new Error(`HTTP ${res.status}`)
      return res.json()
    },
  }
}

@template {
  <div class="fetch-data">
    {#if payload.loading}
      <p class="state loading">Loading…</p>
    {:else if payload.error}
      <p class="state error">Error: {payload.error.message}</p>
    {:else}
      <pre class="result">{JSON.stringify(payload.value, null, 2)}</pre>
    {/if}
  </div>
}

@style {
  .fetch-data { font-family: monospace; }
  .state { padding: 1rem; border-radius: 4px; }
  .loading { background: var(--info-bg, #e8f4fd); color: var(--info, #036); }
  .error { background: var(--error-bg, #fde8e8); color: var(--error, #c00); }
  .result { background: var(--code-bg, #f5f5f5); padding: 1rem; overflow: auto; border-radius: 4px; }
}
