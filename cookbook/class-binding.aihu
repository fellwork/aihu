<!-- @cookbook
description: Dynamic class binding with array form including conditional and interpolated class names
tags: class, binding, dynamic, array, conditional, prop, toggle, styling
-->
<!-- Recipe: class-binding — class={['base', isActive() && 'active', size()]} array form -->

@state {
  $prop: {
    size: { type: String, default: 'md' },
    variant: { type: String, default: 'primary' },
  }

  isActive: boolean = false
  isDisabled: boolean = false

  $action: {
    toggleActive: () => { isActive = !isActive },
    toggleDisabled: () => { isDisabled = !isDisabled },
  }
}

@template {
  <div class="demo">
    <div class={['card', `size-${size}`, `variant-${variant}`, isActive && 'active', isDisabled && 'disabled']}>
      Card content
    </div>
    <div class="controls">
      <button $on.click={toggleActive}>Toggle active</button>
      <button $on.click={toggleDisabled}>Toggle disabled</button>
    </div>
    <p class="classes-preview">Applied: {['card', `size-${size}`, `variant-${variant}`, isActive && 'active', isDisabled && 'disabled'].filter(Boolean).join(' ')}</p>
  </div>
}

@style {
  .demo { display: grid; gap: 0.75rem; padding: 1rem; }
  .card { padding: 1rem; border: 2px solid var(--border, #ccc); border-radius: 4px; transition: all 0.15s; }
  .card.active { border-color: var(--accent, #06f); background: var(--accent-bg, #e8f0ff); }
  .card.disabled { opacity: 0.4; pointer-events: none; }
  .card.size-sm { font-size: 0.85rem; padding: 0.5rem; }
  .card.size-lg { font-size: 1.2rem; padding: 1.5rem; }
  .controls { display: flex; gap: 0.5rem; }
  button { padding: 0.4rem 0.75rem; cursor: pointer; border: 1px solid var(--border, #ccc); border-radius: 4px; }
  .classes-preview { font-family: monospace; font-size: 0.8rem; color: var(--muted, #888); }
}
