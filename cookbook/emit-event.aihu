<!-- Recipe: emit-event — $event collection + $emit.selected({ id }) + $on.selected consumer pattern -->

@state {
  $prop: {
    items: { type: Array, default: [] },
  }

  $event: {
    selected: { payload: { id: string; label: string }, describe: 'User selected an item.' },
  }
}

@template {
  <ul class="item-list" role="listbox">
    {#each items as item (item.id)}
      <li
        role="option"
        class="item"
        $on.click={() => $emit.selected({ id: item.id, label: item.label })}
      >
        {item.label}
      </li>
    {:empty}
      <li class="empty">No items to select.</li>
    {/each}
  </ul>
}

@style {
  .item-list { list-style: none; padding: 0; margin: 0; border: 1px solid var(--border, #ccc); border-radius: 4px; }
  .item { padding: 0.5rem 0.75rem; cursor: pointer; border-bottom: 1px solid var(--border, #eee); }
  .item:hover { background: var(--hover-bg, #f5f5f5); }
  .empty { padding: 0.75rem; color: var(--muted, #888); font-style: italic; }
}
