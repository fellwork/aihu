// context-provider — $context provide: exposes a static theme token to descendants
// Pairs with context-consumer.aihu, which injects `theme` and renders it.
// The static `value: 'light'` is provided verbatim (not called as a factory).

@state {
  $context: {
    provide: {
      theme: { value: 'light', type: 'string' },
    },
  }
}

@template {
  <div class="provider" data-theme="light">
    <div class="controls">
      <span class="label">Providing theme: <strong>light</strong></span>
    </div>
    <div class="slot-area">
      <slot />
    </div>
  </div>
}

@style {
  .provider { padding: 1rem; border: 2px solid var(--border, #ccc); border-radius: 6px; }
  .controls { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .label { font-size: 0.9rem; color: var(--muted, #666); }
  .slot-area { padding-top: 0.5rem; border-top: 1px solid var(--border, #eee); }
}
