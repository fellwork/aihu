<!-- @cookbook
description: Form with two-way binding, submit handler, and validation using signals
tags: form, input, bind, validation, submit, email, signal, action, two-way
-->
<!-- Recipe: form-input — $bind.value two-way binding + $on.submit + form validation signal -->

@state {
  email: string = ''
  name: string = ''
  error: string = ''
  submitted: boolean = false

  $action: {
    validate: () => {
      if (!name.trim()) { error = 'Name is required'; return false }
      if (!email.includes('@')) { error = 'Valid email required'; return false }
      error = ''
      return true
    },
    submit: () => {
      if (!validate()) return
      submitted = true
    },
    reset: () => {
      email = ''
      name = ''
      error = ''
      submitted = false
    },
  }
}

@template {
  {#if submitted}
    <p class="success">Submitted! <button $on.click={reset}>Again</button></p>
  {:else}
    <form $on.submit={(e) => { e.preventDefault(); submit() }}>
      <label>Name <input $bind.value={name} placeholder="Your name" /></label>
      <label>Email <input type="email" $bind.value={email} placeholder="you@example.com" /></label>
      {#if error}
        <p class="error">{error}</p>
      {/if}
      <button type="submit">Submit</button>
    </form>
  {/if}
}

@style {
  form { display: grid; gap: 0.75rem; max-width: 24rem; }
  label { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.9rem; }
  input { padding: 0.5rem; border: 1px solid var(--border, #ccc); border-radius: 4px; }
  .error { color: var(--error, #c00); font-size: 0.85rem; }
  .success { color: var(--success, #080); }
}
