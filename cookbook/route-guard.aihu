<!-- @cookbook
description: Route guard auth gate pattern that redirects to login when unauthenticated
tags: route, guard, auth, authentication, redirect, lifecycle, prop, navigation, if
-->
<!-- Recipe: route-guard — auth gate pattern; redirects to /login when unauthenticated -->
<!-- TODO: requires @route block / $beforeNavigate when the router macro ships -->

@state {
  $prop: {
    // Pass your auth signal down from a parent or read from a shared store.
    authenticated: { type: Boolean, default: false },
    redirectTo: { type: String, default: '/login' },
  }

  $lifecycle: {
    mount: () => {
      // Imperative guard: navigate away if not authenticated.
      // Replace with $beforeNavigate once the router macro ships.
      if (!authenticated) {
        const url = new URL(window.location.href)
        url.pathname = redirectTo
        window.location.replace(url.toString())
      }
    },
  }
}

@template {
  {#if authenticated}
    <div class="guarded-content"><slot></slot></div>
  {:else}
    <p class="redirect-notice">Redirecting to {redirectTo}…</p>
  {/if}
}

@style {
  .redirect-notice { padding: 1rem; color: var(--muted, #888); font-style: italic; }
}
