<!-- Recipe: action-collection — $action collection form with multiple named actions -->

@state {
  count: number = 0
  step: number = 1
  history: number[] = []

  $action: {
    increment: () => {
      history = [...history, count]
      count += step
    },
    decrement: () => {
      history = [...history, count]
      count -= step
    },
    reset: () => {
      history = [...history, count]
      count = 0
    },
    setStep: (n: number) => {
      step = Math.max(1, n)
    },
    undo: () => {
      if (history.length === 0) return
      count = history[history.length - 1] ?? 0
      history = history.slice(0, -1)
    },
  }
}

@template {
  <div class="action-demo">
    <output class="count">{count}</output>
    <div class="controls">
      <button $on.click={decrement}>- {step}</button>
      <button $on.click={reset} class="ghost">Reset</button>
      <button $on.click={increment}>+ {step}</button>
    </div>
    <label class="step-label">
      Step
      <input type="number" min="1" $bind.value={step} class="step-input" />
    </label>
    <button $on.click={undo} class={['undo', history.length === 0 && 'disabled']}>
      Undo ({history.length})
    </button>
  </div>
}

@style {
  .action-demo { display: grid; gap: 0.75rem; max-width: 18rem; padding: 1rem; }
  .count { font-size: 2.5rem; font-variant-numeric: tabular-nums; text-align: center; display: block; }
  .controls { display: flex; gap: 0.5rem; }
  .controls button { flex: 1; padding: 0.5rem; cursor: pointer; border: 1px solid var(--border, #ccc); border-radius: 4px; }
  .ghost { background: transparent; }
  .step-label { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; }
  .step-input { width: 4rem; padding: 0.3rem; border: 1px solid var(--border, #ccc); border-radius: 4px; }
  .undo { padding: 0.4rem 0.75rem; cursor: pointer; border: 1px solid var(--border, #ccc); border-radius: 4px; }
  .undo.disabled { opacity: 0.4; pointer-events: none; }
}
