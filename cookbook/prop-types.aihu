<!-- Recipe: prop-types — $prop full options form: type, default, reflect, attribute, converter -->

@state {
  $prop: {
    // Basic string prop — reflects back to attribute on change.
    label: { type: String, default: 'Click me', reflect: true },

    // Number prop — convertor parses attribute string to number.
    count: { type: Number, default: 0, reflect: true },

    // Boolean prop with custom attribute name.
    disabled: { type: Boolean, default: false, attribute: 'aria-disabled', reflect: true },

    // Property-only (no attribute observation).
    config: { type: Object, default: null, attribute: false },

    // Custom converter: parse ISO date string from attribute.
    since: {
      type: String,
      default: null,
      attribute: 'since',
      converter: (s: string | null) => s ? new Date(s).toLocaleDateString() : null,
    },
  }
}

@template {
  <div class={['prop-demo', disabled && 'disabled']}>
    <h3>{label}</h3>
    <p>Count: {count}</p>
    {#if since}
      <p class="since">Since: {since}</p>
    {/if}
  </div>
}

@style {
  .prop-demo { padding: 1rem; border: 1px solid var(--border, #ccc); border-radius: 4px; }
  .prop-demo.disabled { opacity: 0.5; pointer-events: none; }
  .since { font-size: 0.85rem; color: var(--muted, #888); }
}
