<script setup lang="ts">
// R3 — $show lowers to the platform hidden attribute (NOT a CSS custom property).
// Reactivity: cond is a signal; mountEffect runs once + on every signal update.
const [isOpen, setIsOpen] = signal(false)
function toggle() {
  setIsOpen(!isOpen())
}
</script>
<template>
  <div>
    <button $on:click="toggle">Toggle</button>
    <div $show={isOpen()}>I appear when isOpen() is true</div>
  </div>
</template>
