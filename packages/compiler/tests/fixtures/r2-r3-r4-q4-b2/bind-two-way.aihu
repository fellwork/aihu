<script setup lang="ts">
// R4 (Director r6 §3.R4) — $bind:value two-way write-side. When the bound
// expression is a registered signal, the compiler ALSO emits `oninput`
// (or `onchange` for `$bind:checked`) that writes the user input back to
// the signal. Without this, $bind would be read-only — userland edits in
// the input element would never propagate to component state.
//
// Compose with $prop reflect: true → cycle is guarded by the runtime's
// `_isInternalAttrChange` flag (Q3, Director r6 §2.Q3). See
// packages/runtime/tests/bind-reflect.test.ts.
const [text, setText] = signal('')
const [done, setDone] = signal(false)
</script>
<template>
  <fieldset>
    <input $bind:value="text" placeholder="Type here">
    <p>You typed: {text()}</p>
    <input type="checkbox" $bind:checked="done">
    <p>Done? {done() ? 'yes' : 'no'}</p>
  </fieldset>
</template>
