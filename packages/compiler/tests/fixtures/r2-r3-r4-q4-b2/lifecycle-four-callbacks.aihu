<script setup lang="ts">
// R2 (Director r6 §3.R2) — exercise all four $lifecycle callbacks.
// `mount` and `dispose` are pre-R2 v1 surface; `adopt` and `attributeChange`
// were added in R2. Compiler lowers each to its platform callback:
//   mount           → connectedCallback dispatcher (onMount)
//   dispose         → disconnectedCallback dispatcher (onCleanup)
//   adopt           → adoptedCallback dispatcher (onAdopt) — new
//   attributeChange → attributeChangedCallback dispatcher (onAttributeChange) — new
//
// Order contract (Director r6 §3.R2): R1's $prop signal-update runs FIRST,
// userland's `attributeChange` runs AFTER. Authors observe the post-converted
// signal value rather than the raw attribute string.
@state {
  $prop: {
    name: { default: 'World' },
  }
  $lifecycle: {
    mount: () => {
      console.log('mounted')
    },
    dispose: () => {
      console.log('disposed')
    },
    adopt: () => {
      console.log('adopted')
    },
    attributeChange: (attrName, oldValue, newValue) => {
      console.log('attr', attrName, oldValue, '->', newValue)
    },
  }
}
</script>
<template>
  <div class="r2-demo">
    <h1>{name}</h1>
  </div>
</template>
