// R1 — exercise every optional key on $prop. Spec source:
//   docs/superpowers/specs/2026-05-06-spec-template-syntax-v2-platform-audit.md §3.6
//   .team/director-notes/template-syntax-005.md §5 (Builder B1 brief)
//
// This fixture compiles with the R1 emit (options-form defineComponent +
// observedAttributes wiring). Each entry below cites which acceptance
// criterion it covers.
@state {
  $prop: {
    // AC5 — bare default; reactive on setAttribute.
    name: { default: 'World' },

    // AC6 — property-only; not in observedAttributes.
    user: { default: null, attribute: false },

    // AC7 — reflect: signal updates write back to attribute.
    count: { default: 0, reflect: true },

    // R5 §5 — attribute name override (kebab default would be `theme-mode`).
    themeMode: { default: 'light', attribute: 'theme' },

    // AC8 — converter: custom Date round-trip.
    when: {
      default: null,
      attribute: 'when',
      converter: (s) => s ? new Date(s) : null,
    },
  }
}
@template {
  <div class="r1-demo">
    <h1>{name}</h1>
    <p>Count: {count}</p>
    <p>Theme: {themeMode}</p>
    <time>{when}</time>
  </div>
}
