// W4 — line-citation fixture: `nope` is undefined. The sidecar's
// line-preserving layout (#390) must make tsc cite the REAL .aihu line of
// the template-literal interpolation — line 11 — and the AST harvest must
// declare `count`, so the ONLY error is the genuine one about `nope`.

@state {
  import { signal } from '@aihu/signals'
  const [count, setCount] = signal(0)
}

@template { <p>{`n=${count} ${nope}`}</p> }
