// B3b — passing fixture for AC12 sidecar consumer wiring.
//
// `$event.dayjump.payload` is `{ day: Date }`; template emits the
// matching shape. tsc must produce 0 errors over the sidecar.

@state {
  $event: {
    dayjump: { payload: { day: Date } },
  }
}

@template {
  <button $on.click={() => $emit.dayjump({ day: new Date() })}>x</button>
}
