// B3b — deliberate-type-error fixture for AC12 sidecar consumer wiring.
//
// `$event.dayjump.payload` requires `{ day: Date }`. The template emits
// `$emit.dayjump({ day: 'oops' })` (string instead of Date). The sidecar
// `.aihu.ts` should surface a tsc error against the typed `$emit.dayjump`
// dispatcher emitted from the SFC's $event collection.

@state {
  $event: {
    dayjump: { payload: { day: Date } },
  }
}

@template {
  <button on:click={() => $emit.dayjump({ day: 'oops' })}>x</button>
}
