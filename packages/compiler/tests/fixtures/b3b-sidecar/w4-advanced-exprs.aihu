// W4 — advanced-expression fixture: template-literal holes, spread, and a
// destructured {#each} alias. Every read is in scope, so tsc must produce
// 0 errors — before W4's AST harvest each of these forms false-TS2304'd
// (`count`/`nums` invisible to the token scan; `k`/`v`/`i` bound nothing).

@state {
  import { signal } from '@aihu/signals'
  const [count, setCount] = signal(0)
  const [nums, setNums] = signal([1, 2])
  const [pairs, setPairs] = signal([['a', 1]])
}

@template {
  <span>{`Count: ${count}`}</span>
  <b>{Math.max(...nums)}</b>
  <ul>
    {#each pairs as [k, v], i (k)}
      <li>{k}: {v} #{i}</li>
    {/each}
  </ul>
}
