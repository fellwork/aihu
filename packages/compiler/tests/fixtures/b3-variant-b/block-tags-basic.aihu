// Grammar v2 — attribute control flow (canonical shape).
// Exercises if/elseif/else chains on <group> carriers, each={item, idx of items}
// with key + an empty sibling, and the on:click colon directive.

@state {
  $prop: {
    items: { type: string[], default: [], expose: { read: true } },
    view: { type: 'list' | 'detail' | 'empty', default: 'list' },
  }

  selected: number = 0

  $action: {
    select: (i: number) => { selected = i },
  }
}

@template {
  <group if={view === 'list'}>
    <ul class="items">
      <group each={item, idx of items} key={idx}>
        <li class={['row', idx === selected && 'sel']} on:click={() => select(idx)}>
          {item}
        </li>
      </group><group empty>
        <li class="empty">No items.</li>
      </group>
    </ul>
  </group><group elseif={view === 'detail'}>
    <article>
      <h2>Detail</h2>
      <p>Selected index: {selected}</p>
    </article>
  </group><group else>
    <p>Empty.</p>
  </group>
}

@style {
  .items { list-style: none; padding: 0; margin: 0; }
  .row { padding: 4px 8px; cursor: pointer; }
  .row.sel { background: var(--accent); color: white; }
  .empty { color: var(--muted); padding: 8px; }
}
