// #487 §5 — identity typing threads: `prop<string>({ default })` is a plain
// `string` (narrowed by the §5.2 overloads); a defaultless prop is
// `string | undefined` and must be handled. `tsc --strict` green.

@state {
  const city = prop<string>({ default: 'London' })
  const nickname = prop<string>()

  let visits = state(0)

  const banner = derived(() => `${city.toUpperCase()} (${nickname ?? 'anonymous'})`)

  const visit = action(() => { visits++ })
}

@template {
  <div>
    <h1>{banner}</h1>
    <p class="len">{city.length}</p>
    <button on:click={visit}>Visit ({visits})</button>
  </div>
}
