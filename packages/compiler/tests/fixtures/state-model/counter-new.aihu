// #487 Phase 1 — the reactive-write headline (state-model spec §8 item 2):
// `let count = state(0)` + a plain handler write + a derived recompute.

@state {
  let count = state(0)

  const doubled = derived(() => count * 2)

  const increment = action(() => { count++ })
  const decrement = action(() => { count -= 1 })
  const reset = action(() => { count = 0 })
}

@template {
  <div class="counter">
    <p class="value">Count: {count}</p>
    <p class="doubled">Doubled: {doubled}</p>
    <button class="inc" on:click={increment}>+</button>
    <button class="dec" on:click={decrement}>-</button>
    <button class="direct" on:click={() => count = count + 10}>+10</button>
    <button class="reset" on:click={reset}>0</button>
  </div>
}
