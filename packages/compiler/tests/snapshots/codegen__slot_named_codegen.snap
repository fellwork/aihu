// @aihu:extract read=agents call=anonymous
// @aihu:island static
import { branch, leaf, slot } from '@aihu/arbor'
import { defineComponent, defineElement } from '@aihu/runtime'

const createSlotBoundary = (o, b) => branch('slot', o?.name != null ? { name: o.name } : undefined, typeof b === 'function' ? [b()] : []);

defineElement('x-named-slot', defineComponent((_ctx) => {
  return branch('div', undefined, [createSlotBoundary({ name: 'header', expose: [] }, () => { return branch(null, undefined, []) })])
}))
