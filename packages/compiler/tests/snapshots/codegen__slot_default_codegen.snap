// @aihu:extract read=agents call=anonymous
// @aihu:island static
import { branch, leaf, slot } from '@aihu/arbor'
import { defineComponent, defineElement } from '@aihu/runtime'

const createSlotBoundary = (o, b) => slot(o?.name ?? undefined);

defineElement('x-slot', defineComponent((_ctx) => {
  return branch('div', undefined, [createSlotBoundary({ expose: [] }, () => { return branch(null, undefined, []) })])
}))
