@state {
  import { signal } from '@aihu/signals'
  const [content, setContent] = signal('<strong>bold</strong>')
  const [active, setActive] = signal(false)
}

@template {
  <div>
    <button $on.click={() => setActive(!active())}>toggle</button>
    <div $html={content()}></div>
    <p $class={active() ? 'active' : 'idle'}>status</p>
  </div>
}

@style {
  .active { color: green; }
  .idle { color: gray; }
}
