@state {
  import { signal } from '@aihu/signals'
  const [active, setActive] = signal(false)
  const [value, setValue] = signal('')
  const [html, setHtml] = signal('<em>hello</em>')
}

@template {
  <div>
    <button $on:click={() => setActive(!active())}>toggle</button>
    <input $bind:value={value} $on:input={() => {}} />
    <div $html={html()}></div>
    <span $class={active() ? 'on' : 'off'}>{value()}</span>
  </div>
}

@style {
  .on { color: green; }
  .off { color: gray; }
}
