@state {
  import { signal } from '@aihu/signals'
  const [tab, setTab] = signal<'a' | 'b' | 'c'>('a')
  const [htmlContent, setHtmlContent] = signal('<p>content</p>')
}

@template {
  <div>
    <nav>
      <button $on:click={() => setTab('a')} $class={tab() === 'a' ? 'active' : ''}>A</button>
      <button $on:click={() => setTab('b')} $class={tab() === 'b' ? 'active' : ''}>B</button>
      <button $on:click={() => setTab('c')} $class={tab() === 'c' ? 'active' : ''}>C</button>
    </nav>
    <section>
      <div $if={tab() === 'a'} $html={htmlContent()}></div>
      <div $if={tab() === 'b'}>Tab B content</div>
      <div $if={tab() === 'c'}>Tab C content</div>
    </section>
  </div>
}

@style {
  nav { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
  .active { font-weight: bold; border-bottom: 2px solid currentColor; }
}
