@state {
  year: number = new Date().getFullYear()
  month: number = new Date().getMonth()
  selected: number | null = null

  $computed days = (() => {
    const first = new Date(year, month, 1).getDay()
    const count = new Date(year, month + 1, 0).getDate()
    return Array.from({ length: first + count }, (_, i) => i < first ? null : i - first + 1)
  })()

  $action prevMonth() {
    if (month === 0) { year -= 1; month = 11 } else { month -= 1 }
    selected = null
  }
  $action nextMonth() {
    if (month === 11) { year += 1; month = 0 } else { month += 1 }
    selected = null
  }
  $action select(d: number | null) { selected = d }
}

@template {
  <div class="calendar">
    <header>
      <button $on:click={prevMonth}>‹</button>
      <span>{year}-{String(month + 1).padStart(2, '0')}</span>
      <button $on:click={nextMonth}>›</button>
    </header>
    <div class="grid">
      <span
        $each={days as d}
        $key={String(d ?? 'x')}
        $on:click={() => select(d)}
        class={d === selected ? 'selected' : ''}
      >
        {d ?? ''}
      </span>
    </div>
  </div>
}

@style {
  .calendar { font-family: system-ui; max-width: 320px; }
  .calendar header { display: flex; justify-content: space-between; padding: 0.5rem; }
  .grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
  .grid span { text-align: center; padding: 4px; cursor: pointer; }
  .selected { background: var(--accent); color: #fff; border-radius: 4px; }
}
