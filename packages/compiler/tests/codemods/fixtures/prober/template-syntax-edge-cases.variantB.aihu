@state {
  import { signal } from '@aihu/signals'
  const [items, setItems] = signal<string[]>([])
  const [draft, setDraft] = signal('')
  const [selected, setSelected] = signal<string | null>(null)
}

@template {
  <div>
    <input $bind:value={draft} $on:keydown={(e) => e.key === 'Enter' && setItems([...items(), draft()])} />
    <ul>
      <li
        $each={items() as item}
        $key={item}
        $on:click={() => setSelected(item)}
        $class={item === selected() ? 'selected' : ''}
      >
        {item}
      </li>
    </ul>
  </div>
}

@style {
  .selected { font-weight: bold; background: #e8f4f8; }
}
