@state {
  import { signal } from '@aihu/signals'
  const [count, setCount] = signal(0)
}

@template {
  <div class="counter">
    <button $on.click={() => setCount(count() - 1)}>-</button>
    <span>{count()}</span>
    <button $on.click={() => setCount(count() + 1)}>+</button>
  </div>
}

@style {
  .counter { display: flex; gap: 1rem; align-items: center; font-size: 1.5rem; }
  button { padding: 0.25rem 0.75rem; cursor: pointer; }
}
