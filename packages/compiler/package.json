{
  "name": "@aihu/compiler",
  "version": "0.5.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "aihu-compile": "./bin/aihu-compile"
  },
  "files": [
    "dist",
    "js/postinstall.ts",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "postinstall": "bun run js/postinstall.ts",
    "prepublishOnly": "bun run build",
    "codemod:template-syntax": "bun js/codemods/template-syntax/run-migration.ts"
  },
  "peerDependencies": {
    "vite": ">=5.0.0",
    "@aihu/css-engine": ">=0.2.1"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "@aihu/css-engine": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aihu/css-engine": "workspace:*"
  },
  "description": "Single File Component (.aihu) compiler — Rust binary + JS glue.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fellwork/aihu.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/fellwork/aihu/tree/main/packages/compiler#readme",
  "bugs": "https://github.com/fellwork/aihu/issues",
  "publishConfig": {
    "access": "public"
  }
}
