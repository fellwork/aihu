{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Scribe",
  "scopeName": "source.scribe",
  "fileTypes": ["scribe"],
  "patterns": [
    { "include": "#block-state" },
    { "include": "#block-template" },
    { "include": "#block-style" },
    { "include": "#block-agent" },
    { "include": "#block-route" },
    { "include": "#block-unknown" },
    { "include": "#comment-line" },
    { "include": "#comment-block" }
  ],
  "repository": {
    "comment-line": {
      "match": "//.*$",
      "name": "comment.line.double-slash.scribe"
    },
    "comment-block": {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.scribe"
    },

    "block-keyword": {
      "match": "@(state|template|style|agent|route|plugin|data)\\b",
      "captures": {
        "0": { "name": "keyword.other.block.scribe" },
        "1": { "name": "storage.type.block.scribe" }
      }
    },

    "block-state": {
      "begin": "(@state)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.other.block.scribe storage.type.block.scribe" },
        "2": { "name": "punctuation.definition.block.begin.scribe" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.scribe" }
      },
      "name": "meta.block.state.scribe",
      "contentName": "source.ts",
      "patterns": [{ "include": "source.ts" }]
    },

    "block-template": {
      "begin": "(@template)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.other.block.scribe storage.type.block.scribe" },
        "2": { "name": "punctuation.definition.block.begin.scribe" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.scribe" }
      },
      "name": "meta.block.template.scribe",
      "patterns": [
        { "include": "#template-interpolation" },
        { "include": "#template-macro-attr" },
        { "include": "#template-tag" },
        { "include": "#comment-line" },
        { "include": "#comment-block" }
      ]
    },

    "block-style": {
      "begin": "(@style)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.other.block.scribe storage.type.block.scribe" },
        "2": { "name": "punctuation.definition.block.begin.scribe" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.scribe" }
      },
      "name": "meta.block.style.scribe",
      "contentName": "source.css",
      "patterns": [{ "include": "source.css" }]
    },

    "block-agent": {
      "begin": "(@agent)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.other.block.scribe storage.type.block.scribe" },
        "2": { "name": "punctuation.definition.block.begin.scribe" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.scribe" }
      },
      "name": "meta.block.agent.scribe",
      "contentName": "source.ts",
      "patterns": [{ "include": "source.ts" }]
    },

    "block-route": {
      "begin": "(@route)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.other.block.scribe storage.type.block.scribe" },
        "2": { "name": "punctuation.definition.block.begin.scribe" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.scribe" }
      },
      "name": "meta.block.route.scribe",
      "patterns": [{ "include": "#route-key-value" }]
    },

    "block-unknown": {
      "begin": "(@\\w+)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.other.block.scribe" },
        "2": { "name": "punctuation.definition.block.begin.scribe" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.scribe" }
      },
      "name": "meta.block.unknown.scribe"
    },

    "template-interpolation": {
      "begin": "\\{\\{",
      "end": "\\}\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.template-expression.begin.scribe" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.template-expression.end.scribe" }
      },
      "name": "meta.template.expression.scribe",
      "contentName": "source.ts",
      "patterns": [{ "include": "source.ts" }]
    },

    "template-macro-attr": {
      "patterns": [
        {
          "comment": "$on:event={handler} — event binding",
          "match": "(\\$on:[a-zA-Z][a-zA-Z0-9-]*)(?:(=)(\\{[^}]*\\}))?",
          "captures": {
            "1": { "name": "keyword.operator.scribe entity.other.attribute-name.scribe" },
            "2": { "name": "punctuation.separator.key-value.scribe" },
            "3": { "name": "meta.expression.scribe" }
          }
        },
        {
          "comment": "$bind:prop={expr} — property binding",
          "match": "(\\$bind:[a-zA-Z][a-zA-Z0-9-]*)(?:(=)(\\{[^}]*\\}))?",
          "captures": {
            "1": { "name": "keyword.operator.scribe entity.other.attribute-name.scribe" },
            "2": { "name": "punctuation.separator.key-value.scribe" },
            "3": { "name": "meta.expression.scribe" }
          }
        },
        {
          "comment": "$each, $if, $html, $show, etc.",
          "match": "(\\$[a-zA-Z][a-zA-Z0-9]*)(?:(=)(?:(\\{[^}]*\\})|(\"[^\"]*\")|('[^']*')))?",
          "captures": {
            "1": { "name": "keyword.operator.scribe support.type.directive.scribe" },
            "2": { "name": "punctuation.separator.key-value.scribe" },
            "3": { "name": "meta.expression.scribe" },
            "4": { "name": "string.quoted.double.scribe" },
            "5": { "name": "string.quoted.single.scribe" }
          }
        }
      ]
    },

    "template-tag": {
      "patterns": [
        { "include": "#template-tag-open" },
        { "include": "#template-tag-close" },
        { "include": "#template-tag-self-close" }
      ]
    },

    "template-tag-open": {
      "begin": "(<)([a-zA-Z][a-zA-Z0-9-]*)",
      "end": "(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.scribe" },
        "2": { "name": "entity.name.tag.scribe" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.scribe" }
      },
      "name": "meta.tag.open.scribe",
      "patterns": [
        { "include": "#template-macro-attr" },
        { "include": "#template-attr-expr" },
        { "include": "#template-attr-static" }
      ]
    },

    "template-tag-close": {
      "match": "(</)([a-zA-Z][a-zA-Z0-9-]*)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.scribe" },
        "2": { "name": "entity.name.tag.scribe" },
        "3": { "name": "punctuation.definition.tag.end.scribe" }
      },
      "name": "meta.tag.close.scribe"
    },

    "template-tag-self-close": {
      "begin": "(<)([a-zA-Z][a-zA-Z0-9-]*)",
      "end": "(/>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.scribe" },
        "2": { "name": "entity.name.tag.scribe" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.scribe" }
      },
      "name": "meta.tag.self-close.scribe",
      "patterns": [
        { "include": "#template-macro-attr" },
        { "include": "#template-attr-expr" },
        { "include": "#template-attr-static" }
      ]
    },

    "template-attr-expr": {
      "match": "([a-zA-Z][a-zA-Z0-9-]*)(?:(=)(\\{[^}]*\\}))",
      "captures": {
        "1": { "name": "entity.other.attribute-name.scribe" },
        "2": { "name": "punctuation.separator.key-value.scribe" },
        "3": { "name": "meta.expression.scribe" }
      }
    },

    "template-attr-static": {
      "patterns": [
        {
          "match": "([a-zA-Z][a-zA-Z0-9-]*)=(\"[^\"]*\")",
          "captures": {
            "1": { "name": "entity.other.attribute-name.scribe" },
            "2": { "name": "string.quoted.double.scribe" }
          }
        },
        {
          "match": "([a-zA-Z][a-zA-Z0-9-]*)=('[^']*')",
          "captures": {
            "1": { "name": "entity.other.attribute-name.scribe" },
            "2": { "name": "string.quoted.single.scribe" }
          }
        },
        {
          "match": "([a-zA-Z][a-zA-Z0-9-]+)",
          "name": "entity.other.attribute-name.scribe"
        }
      ]
    },

    "route-key-value": {
      "patterns": [
        {
          "match": "^\\s*(path|name|layout|ssr|middleware|params)\\s*(:)\\s*(.+)$",
          "captures": {
            "1": { "name": "support.type.property-name.scribe" },
            "2": { "name": "punctuation.separator.key-value.scribe" },
            "3": { "name": "string.unquoted.scribe" }
          }
        },
        { "include": "#comment-line" }
      ]
    }
  }
}
