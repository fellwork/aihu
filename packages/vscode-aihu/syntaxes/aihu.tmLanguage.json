{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aihu",
  "scopeName": "source.aihu",
  "fileTypes": ["aihu"],
  "patterns": [
    { "include": "#block-state" },
    { "include": "#block-template" },
    { "include": "#block-style" },
    { "include": "#block-agent" },
    { "include": "#block-route" },
    { "include": "#block-unknown" },
    { "include": "#comment-line" },
    { "include": "#comment-block" }
  ],
  "repository": {
    "comment-line": {
      "match": "//.*$",
      "name": "comment.line.double-slash.aihu"
    },
    "comment-block": {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.aihu"
    },

    "block-keyword": {
      "match": "@(state|template|style|agent|route|plugin|data)\\b",
      "captures": {
        "0": { "name": "keyword.other.block.aihu" },
        "1": { "name": "storage.type.block.aihu" }
      }
    },

    "block-state": {
      "begin": "(@state)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.other.block.aihu storage.type.block.aihu" },
        "2": { "name": "punctuation.definition.block.begin.aihu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.aihu" }
      },
      "name": "meta.block.state.aihu",
      "contentName": "source.ts",
      "patterns": [{ "include": "source.ts" }]
    },

    "block-template": {
      "begin": "(@template)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.other.block.aihu storage.type.block.aihu" },
        "2": { "name": "punctuation.definition.block.begin.aihu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.aihu" }
      },
      "name": "meta.block.template.aihu",
      "patterns": [
        { "include": "#template-interpolation" },
        { "include": "#template-tag" },
        { "include": "#comment-line" },
        { "include": "#comment-block" }
      ]
    },

    "block-style": {
      "begin": "(@style)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.other.block.aihu storage.type.block.aihu" },
        "2": { "name": "punctuation.definition.block.begin.aihu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.aihu" }
      },
      "name": "meta.block.style.aihu",
      "contentName": "source.css",
      "patterns": [{ "include": "source.css" }]
    },

    "block-agent": {
      "begin": "(@agent)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.other.block.aihu storage.type.block.aihu" },
        "2": { "name": "punctuation.definition.block.begin.aihu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.aihu" }
      },
      "name": "meta.block.agent.aihu",
      "contentName": "source.ts",
      "patterns": [{ "include": "source.ts" }]
    },

    "block-route": {
      "begin": "(@route)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.other.block.aihu storage.type.block.aihu" },
        "2": { "name": "punctuation.definition.block.begin.aihu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.aihu" }
      },
      "name": "meta.block.route.aihu",
      "patterns": [{ "include": "#route-key-value" }]
    },

    "block-unknown": {
      "begin": "(@\\w+)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.other.block.aihu" },
        "2": { "name": "punctuation.definition.block.begin.aihu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.aihu" }
      },
      "name": "meta.block.unknown.aihu"
    },

    "template-interpolation": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.template-expression.begin.aihu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.template-expression.end.aihu" }
      },
      "name": "meta.template.expression.aihu",
      "contentName": "source.ts",
      "patterns": [{ "include": "#expression-nested-braces" }, { "include": "source.ts" }]
    },

    "expression-nested-braces": {
      "comment": "Balanced-brace matcher so object literals, arrow-fn blocks, and template-literal ${…} inside a `{expr}`/`={…}` region don't prematurely close the enclosing expression.",
      "begin": "\\{",
      "end": "\\}",
      "name": "source.ts",
      "patterns": [{ "include": "#expression-nested-braces" }, { "include": "source.ts" }]
    },

    "template-directive-colon": {
      "comment": "on:<event>[.modifier...]={expr} / bind:<prop>={expr} / class:<name>={expr} — grammar v2 colon directives",
      "begin": "\\b(on|bind|class)(:)([A-Za-z_$][\\w$-]*(?:\\.[a-z]+)*)\\s*(=)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.control.aihu support.type.directive.aihu" },
        "2": { "name": "punctuation.separator.namespace.aihu" },
        "3": { "name": "entity.other.attribute-name.aihu" },
        "4": { "name": "punctuation.separator.key-value.aihu" },
        "5": { "name": "punctuation.definition.template-expression.begin.aihu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.template-expression.end.aihu" }
      },
      "name": "meta.directive.event.aihu",
      "contentName": "source.ts",
      "patterns": [{ "include": "#expression-nested-braces" }, { "include": "source.ts" }]
    },

    "template-directive-naked": {
      "comment": "Naked (prefix-less) grammar v2 directives: if, elseif, each, key, show, html, memo — all require a braced expression.",
      "begin": "\\b(if|elseif|each|key|show|html|memo)\\b\\s*(=)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.control.aihu support.type.directive.aihu" },
        "2": { "name": "punctuation.separator.key-value.aihu" },
        "3": { "name": "punctuation.definition.template-expression.begin.aihu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.template-expression.end.aihu" }
      },
      "name": "meta.directive.aihu",
      "contentName": "source.ts",
      "patterns": [{ "include": "#expression-nested-braces" }, { "include": "source.ts" }]
    },

    "template-directive-bare": {
      "comment": "Bare boolean grammar v2 directives with no value: once, raw, else, empty.",
      "match": "(?<=[\\s<])(once|raw|else|empty)(?=[\\s/>])",
      "name": "keyword.control.aihu support.type.directive.aihu"
    },

    "template-tag": {
      "patterns": [
        { "include": "#template-tag-open" },
        { "include": "#template-tag-close" },
        { "include": "#template-tag-self-close" }
      ]
    },

    "template-tag-open": {
      "begin": "(<)([a-zA-Z][a-zA-Z0-9-]*)",
      "end": "(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.aihu" },
        "2": { "name": "entity.name.tag.aihu" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.aihu" }
      },
      "name": "meta.tag.open.aihu",
      "patterns": [
        { "include": "#template-directive-colon" },
        { "include": "#template-directive-naked" },
        { "include": "#template-directive-bare" },
        { "include": "#template-attr-expr" },
        { "include": "#template-attr-static" }
      ]
    },

    "template-tag-close": {
      "match": "(</)([a-zA-Z][a-zA-Z0-9-]*)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.aihu" },
        "2": { "name": "entity.name.tag.aihu" },
        "3": { "name": "punctuation.definition.tag.end.aihu" }
      },
      "name": "meta.tag.close.aihu"
    },

    "template-tag-self-close": {
      "begin": "(<)([a-zA-Z][a-zA-Z0-9-]*)",
      "end": "(/>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.aihu" },
        "2": { "name": "entity.name.tag.aihu" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.aihu" }
      },
      "name": "meta.tag.self-close.aihu",
      "patterns": [
        { "include": "#template-directive-colon" },
        { "include": "#template-directive-naked" },
        { "include": "#template-directive-bare" },
        { "include": "#template-attr-expr" },
        { "include": "#template-attr-static" }
      ]
    },

    "template-attr-expr": {
      "comment": "Generic name={expr} HTML/component attribute (class, href, style, custom props, ...). Colon-namespaced (on:/bind:) and the naked control-flow directives are matched first by dedicated rules above.",
      "begin": "([a-zA-Z][a-zA-Z0-9-]*)\\s*(=)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "entity.other.attribute-name.aihu" },
        "2": { "name": "punctuation.separator.key-value.aihu" },
        "3": { "name": "punctuation.definition.template-expression.begin.aihu" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.template-expression.end.aihu" }
      },
      "name": "meta.attribute.expression.aihu",
      "contentName": "source.ts",
      "patterns": [{ "include": "#expression-nested-braces" }, { "include": "source.ts" }]
    },

    "template-attr-static": {
      "patterns": [
        {
          "match": "([a-zA-Z][a-zA-Z0-9-]*)=(\"[^\"]*\")",
          "captures": {
            "1": { "name": "entity.other.attribute-name.aihu" },
            "2": { "name": "string.quoted.double.aihu" }
          }
        },
        {
          "match": "([a-zA-Z][a-zA-Z0-9-]*)=('[^']*')",
          "captures": {
            "1": { "name": "entity.other.attribute-name.aihu" },
            "2": { "name": "string.quoted.single.aihu" }
          }
        },
        {
          "match": "([a-zA-Z][a-zA-Z0-9-]+)",
          "name": "entity.other.attribute-name.aihu"
        }
      ]
    },

    "route-key-value": {
      "patterns": [
        {
          "match": "^\\s*(path|name|layout|ssr|middleware|params)\\s*(:)\\s*(.+)$",
          "captures": {
            "1": { "name": "support.type.property-name.aihu" },
            "2": { "name": "punctuation.separator.key-value.aihu" },
            "3": { "name": "string.unquoted.aihu" }
          }
        },
        { "include": "#comment-line" }
      ]
    }
  }
}
