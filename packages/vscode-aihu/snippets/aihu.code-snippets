{
  "Aihu SFC scaffold": {
    "prefix": "aihu-sfc",
    "description": "Minimal complete v2 aihu SFC with @state and @template blocks",
    "body": [
      "@state {",
      "  import { signal } from '@aihu/signals'",
      "",
      "  $0",
      "}",
      "",
      "@template {",
      "  <div>",
      "  </div>",
      "}"
    ]
  },

  "Aihu Component (minimal)": {
    "prefix": "aihu-min",
    "description": "Minimal aihu component with state and template",
    "body": [
      "@state {",
      "import { signal } from '@aihu/signals'",
      "",
      "const [${1:count}, set${1/(.*)/${1:/capitalize}/}] = signal(${2:0})",
      "}",
      "",
      "@template {",
      "  <div class=\"${3:component}\">",
      "    <span>{${1:count}}</span>",
      "    $0",
      "  </div>",
      "}"
    ]
  },

  "Aihu Component (full)": {
    "prefix": "aihu",
    "description": "Full aihu SFC with state, template, and style",
    "body": [
      "@state {",
      "import { signal } from '@aihu/signals'",
      "",
      "const [${1:count}, set${1/(.*)/${1:/capitalize}/}] = signal(${2:0})",
      "}",
      "",
      "@template {",
      "  <div class=\"${3:component}\">",
      "    $0",
      "  </div>",
      "}",
      "",
      "@style {",
      ".${3:component} {",
      "  $4",
      "}",
      "}"
    ]
  },

  "Signal": {
    "prefix": "signal",
    "description": "Create a aihu signal pair",
    "body": "const [${1:value}, set${1/(.*)/${1:/capitalize}/}] = signal(${2:undefined})"
  },

  "Event handler binding ($on)": {
    "prefix": "on",
    "description": "$on.event directive (v2 dot-form)",
    "body": "\\$on.${1:click}={() => ${2:handler}}"
  },

  "Emit event ($emit)": {
    "prefix": "emit",
    "description": "$emit.eventName(payload) — dispatch a typed custom event (v2 dot-form)",
    "body": "\\$emit.${1:eventName}(${2:payload})"
  },

  "Attribute binding ($bind)": {
    "prefix": "bind",
    "description": "$bind.attr={expr} — two-way attribute binding (v2 dot-form)",
    "body": "\\$bind.${1:value}={${2:signal}}"
  },

  "Template interpolation": {
    "prefix": "{",
    "description": "Template interpolation expression (v2 single-brace form)",
    "body": "{${1:value}}"
  },

  "If block": {
    "prefix": "if",
    "description": "{#if condition}...{/if} conditional block (v2 block-tag form)",
    "body": [
      "{#if ${1:condition}}",
      "  $0",
      "{/if}"
    ]
  },

  "If-else block": {
    "prefix": "if-else",
    "description": "{#if condition}...{:else}...{/if} conditional block (v2 block-tag form)",
    "body": [
      "{#if ${1:condition}}",
      "  $2",
      "{:else}",
      "  $3",
      "{/if}"
    ]
  },

  "Each block": {
    "prefix": "each",
    "description": "{#each items as item}...{/each} iteration block (v2 block-tag form)",
    "body": [
      "{#each ${1:items} as ${2:item}}",
      "  $0",
      "{/each}"
    ]
  },

  "Each block with key": {
    "prefix": "each-key",
    "description": "{#each items as item, idx (key)}...{/each} iteration block with key (v2 block-tag form)",
    "body": [
      "{#each ${1:items} as ${2:item}, ${3:idx} (${3:idx})}",
      "  $0",
      "{/each}"
    ]
  },

  "Action declaration ($action)": {
    "prefix": "action",
    "description": "$action collection in @state block — callable from template (v2 collection form)",
    "body": [
      "\\$action: {",
      "  ${1:name}: (${2:arg}: ${3:type}) => {",
      "    $0",
      "  },",
      "}"
    ]
  },

  "HTML injection ({@html})": {
    "prefix": "html",
    "description": "{@html expr} — raw HTML injection (v2 Svelte-style block form)",
    "body": "{@html ${1:htmlContent}}"
  },

  "State block": {
    "prefix": "@state",
    "description": "@state block",
    "body": ["@state {", "import { signal } from '@aihu/signals'", "", "$0", "}"]
  },

  "Template block": {
    "prefix": "@template",
    "description": "@template block",
    "body": ["@template {", "  <div>", "    $0", "  </div>", "}"]
  },

  "Style block": {
    "prefix": "@style",
    "description": "@style block",
    "body": ["@style {", "$0", "}"]
  },

  "Agent block": {
    "prefix": "@agent",
    "description": "@agent block for MCP tool exposure",
    "body": [
      "@agent {",
      "  name: ${1:my-tool}",
      "  $input ${2:param}: string",
      "  $action ${3:run}() {",
      "    $0",
      "  }",
      "}"
    ]
  },

  "Route block": {
    "prefix": "@route",
    "description": "@route block for file-based routing",
    "body": ["@route {", "  path: ${1:/}", "  name: ${2:home}", "}"]
  }
}
