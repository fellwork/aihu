{
  "Aihu SFC scaffold": {
    "prefix": "aihu-sfc",
    "description": "Minimal complete v2 aihu SFC with @state and @template blocks",
    "body": [
      "@state {",
      "  import { signal } from '@aihu/signals'",
      "",
      "  $0",
      "}",
      "",
      "@template {",
      "  <div>",
      "  </div>",
      "}"
    ]
  },

  "Aihu Component (minimal)": {
    "prefix": "aihu-min",
    "description": "Minimal aihu component with state and template",
    "body": [
      "@state {",
      "import { signal } from '@aihu/signals'",
      "",
      "const [${1:count}, set${1/(.*)/${1:/capitalize}/}] = signal(${2:0})",
      "}",
      "",
      "@template {",
      "  <div class=\"${3:component}\">",
      "    <span>{${1:count}}</span>",
      "    $0",
      "  </div>",
      "}"
    ]
  },

  "Aihu Component (full)": {
    "prefix": "aihu",
    "description": "Full aihu SFC with state, template, and style",
    "body": [
      "@state {",
      "import { signal } from '@aihu/signals'",
      "",
      "const [${1:count}, set${1/(.*)/${1:/capitalize}/}] = signal(${2:0})",
      "}",
      "",
      "@template {",
      "  <div class=\"${3:component}\">",
      "    $0",
      "  </div>",
      "}",
      "",
      "@style {",
      ".${3:component} {",
      "  $4",
      "}",
      "}"
    ]
  },

  "Signal": {
    "prefix": "signal",
    "description": "Create a aihu signal pair",
    "body": "const [${1:value}, set${1/(.*)/${1:/capitalize}/}] = signal(${2:undefined})"
  },

  "Event handler binding (on:)": {
    "prefix": "on",
    "description": "on:event={handler} — colon-namespaced event directive (grammar v2)",
    "body": "on:${1:click}={${2:handler}}"
  },

  "Emit event ($emit)": {
    "prefix": "emit",
    "description": "$emit.eventName(payload) — dispatch a typed custom event (@state macro, dot-form)",
    "body": "\\$emit.${1:eventName}(${2:payload})"
  },

  "Attribute binding (bind:)": {
    "prefix": "bind",
    "description": "bind:prop={expr} — colon-namespaced two-way attribute binding (grammar v2)",
    "body": "bind:${1:value}={${2:signal}}"
  },

  "Template interpolation": {
    "prefix": "{",
    "description": "Template interpolation expression (single-brace form)",
    "body": "{${1:value}}"
  },

  "If attribute": {
    "prefix": "if",
    "description": "if={condition} — naked conditional directive on the governed element (grammar v2)",
    "body": "<${1:div} if={${2:condition}}>\n  $0\n</${1:div}>"
  },

  "If-else attribute": {
    "prefix": "if-else",
    "description": "if={condition} on one element, else on its immediate sibling (grammar v2)",
    "body": "<${1:div} if={${2:condition}}>\n  $3\n</${1:div}>\n<${1:div} else>\n  $4\n</${1:div}>"
  },

  "Each attribute": {
    "prefix": "each",
    "description": "each={item of items} — naked iteration directive on the repeated element (grammar v2)",
    "body": "<${1:li} each={${2:item} of ${3:items}}>\n  $0\n</${1:li}>"
  },

  "Each attribute with key": {
    "prefix": "each-key",
    "description": "each={item of items} key={expr} — naked iteration directive with an explicit key (grammar v2)",
    "body": "<${1:li} each={${2:item} of ${3:items}} key={${4:item.id}}>\n  $0\n</${1:li}>"
  },

  "Action declaration (action())": {
    "prefix": "action",
    "description": "action(fn) in @state — callable from the template",
    "body": ["const ${1:name} = action((${2:arg}: ${3:type}) => {", "  $0", "})"]
  },

  "HTML injection (html attribute)": {
    "prefix": "html",
    "description": "html={expr} — naked raw-HTML directive on the containing element (grammar v2)",
    "body": "html={${1:htmlContent}}"
  },

  "State block": {
    "prefix": "@state",
    "description": "@state block",
    "body": ["@state {", "import { signal } from '@aihu/signals'", "", "$0", "}"]
  },

  "Template block": {
    "prefix": "@template",
    "description": "@template block",
    "body": ["@template {", "  <div>", "    $0", "  </div>", "}"]
  },

  "Style block": {
    "prefix": "@style",
    "description": "@style block",
    "body": ["@style {", "$0", "}"]
  },

  "Agent block": {
    "prefix": "@agent",
    "description": "@agent block for MCP tool exposure",
    "body": [
      "@agent {",
      "  name: ${1:my-tool}",
      "  $input ${2:param}: string",
      "  $action ${3:run}() {",
      "    $0",
      "  }",
      "}"
    ]
  },

  "Route block": {
    "prefix": "@route",
    "description": "@route block for file-based routing",
    "body": ["@route {", "  path: ${1:/}", "  name: ${2:home}", "}"]
  }
}
