# moon root project — entry point used to discover the monorepo.
# Per-app tasks live in apps/web/moon.yml and packages/shared/moon.yml.
# https://moonrepo.dev/docs

$schema: 'https://moonrepo.dev/schemas/project.json'

layer: 'application'
language: 'typescript'

project:
  name: '__APP_NAME__'
  description: 'Root tasks for __APP_NAME__'

tasks:
  build:
    command: 'noop'
    deps:
      - 'web:build'
      - 'shared:build'

  test:
    command: 'noop'
    deps:
      - 'web:test'
      - 'shared:test'

  dev:
    command: 'noop'
    deps:
      - 'web:dev'
    preset: 'server'

  lint:
    command: 'bun run biome lint .'
    options:
      cache: false

  format:
    command: 'bun run biome format --write .'
    options:
      cache: false

  typecheck:
    command: 'noop'
    deps:
      - 'web:typecheck'
      - 'shared:typecheck'
