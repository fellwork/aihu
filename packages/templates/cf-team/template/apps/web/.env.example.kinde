# Kinde configuration for __APP_NAME__
# Scaffolded by @aihu/templates-cf-team. Copy to `.env` and fill in values.
# Docs: https://kinde.com/docs/developer-tools/typescript-sdk

# Application credentials from your Kinde dashboard
# (Settings → Applications → your app → Quick start).
KINDE_CLIENT_ID=""
KINDE_CLIENT_SECRET=""

# Your Kinde domain (e.g. https://your-tenant.kinde.com).
KINDE_ISSUER_URL=""

# OAuth redirect URL — must match the entry registered in your Kinde
# application's "Allowed callback URLs". Use http://localhost:5173/api/auth/callback
# for local dev.
KINDE_REDIRECT_URL="http://localhost:5173/api/auth/callback"
