# better-auth configuration for __APP_NAME__
# Scaffolded by @aihu/templates-cf-team. Copy to `.env` and fill in values.
# Docs: https://better-auth.com

# Server-side secret used to sign sessions and tokens.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="generate-via: openssl rand -base64 32"

# Public origin where the auth client expects to be reached.
# Use http://localhost:5173 for `bun run dev`; set to your prod URL
# (e.g. https://__APP_NAME__.workers.dev) before deploying.
BETTER_AUTH_URL="http://localhost:5173"
