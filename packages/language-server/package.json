{
  "name": "@aihu/language-server",
  "version": "0.2.19",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aihu-language-server": "./dist/bin.js"
  },
  "main": "./dist/server.js",
  "module": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "bun tests/latency.bench.ts",
    "bench:gate": "bun tests/latency.bench.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aihu/compiler": "workspace:*",
    "@volar/language-core": "2.4.28",
    "@volar/language-server": "2.4.28",
    "@volar/source-map": "2.4.28",
    "vscode-uri": "3.1.0"
  },
  "description": "Cross-editor Language Server (aihu-language-server) for .aihu Single File Components — diagnostics, hover, completion, and quick-fix code actions.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fellwork/aihu.git",
    "directory": "packages/language-server"
  },
  "homepage": "https://github.com/fellwork/aihu/tree/main/packages/language-server#readme",
  "bugs": "https://github.com/fellwork/aihu/issues",
  "publishConfig": {
    "access": "public"
  }
}
