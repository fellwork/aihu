{
  "name": "@aihu/arbor",
  "version": "4.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hydrate": {
      "types": "./dist/hydrate.d.ts",
      "import": "./dist/hydrate.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rolldown -c && node scripts/mangle-dist.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@aihu/signals": "workspace:^"
  },
  "description": "Reactive component tree (the rendering layer that consumes @aihu/signals).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fellwork/aihu.git",
    "directory": "packages/arbor"
  },
  "homepage": "https://github.com/fellwork/aihu/tree/main/packages/arbor#readme",
  "bugs": "https://github.com/fellwork/aihu/issues",
  "publishConfig": {
    "access": "public"
  }
}
