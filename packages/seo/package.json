{
  "name": "@aihu/seo",
  "version": "0.2.1",
  "description": "aihu SEO plugin: sitemap.xml, robots.txt, llms.txt, JSON-LD injection via afterParse hook.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "install-manifest.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aihu/plugin": "workspace:*",
    "@aihu/server": "workspace:*",
    "@aihu-plugin/agent-readiness": "workspace:*"
  },
  "devDependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fellwork/aihu.git",
    "directory": "packages/seo"
  },
  "homepage": "https://github.com/fellwork/aihu/tree/main/packages/seo#readme",
  "bugs": "https://github.com/fellwork/aihu/issues",
  "publishConfig": {
    "access": "public"
  }
}
