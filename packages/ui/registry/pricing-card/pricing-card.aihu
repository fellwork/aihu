<!--
  aihu-pricing-card — presentational styled recipe (performativeUI port,
  Slice 5 — docs/plans/2026-08-01-performative-ui-port.md §Tier-B batch 2).

  Design and behavior transcribed in spirit from performativeUI (MIT); no
  source text or `pui-` class names vendored — see NOTICES.md.

  A pricing tier card. Default slot holds the consumer's own feature list
  (`<ul>/<li>`) — this recipe renders no list markup of its own.

  tier:     tier name, e.g. "Pro".
  price:    price string, e.g. "$29".
  period:   billing period suffix, e.g. "/mo". Default "" (one-time/no suffix).
  featured: off (default) | on — accent border + elevation via
            --color-primary when "on".
  (`featured`'s variant matrix is the registry catalog contract — see
  meta.json — reflected as data-featured and matched in @style below.)

  `shadow: 'light'` — see the parent execution plan's theming decision.
-->

@state {
  import { cn } from '@aihu/css-engine/runtime/cn'

  shadow: 'light'

  let tier = prop({ default: 'Pro' })
  let price = prop({ default: '$0' })
  let period = prop({ default: '' })
  let featured = prop({ default: 'off' })
}

@template {
  <div data-slot="pricing-card" data-featured={featured} class={cn('aihu-pricing-card')}>
    <p class="aihu-pricing-card-tier">{tier}</p>
    <p class="aihu-pricing-card-price">
      {price}<span if={period} class="aihu-pricing-card-period">{period}</span>
    </p>
    <div class="aihu-pricing-card-features">
      <slot />
    </div>
  </div>
}

@style {
  .aihu-pricing-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    color: var(--color-surface-foreground);
  }
  .aihu-pricing-card[data-featured="on"] {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 1px var(--color-primary), 0 10px 30px color-mix(in oklab, var(--color-primary) 25%, transparent);
  }
  .aihu-pricing-card-tier {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-muted-foreground);
  }
  .aihu-pricing-card[data-featured="on"] .aihu-pricing-card-tier {
    color: var(--color-primary);
  }
  .aihu-pricing-card-price {
    margin: 0;
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1;
  }
  .aihu-pricing-card-period {
    margin-left: 0.25rem;
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-muted-foreground);
  }
  .aihu-pricing-card-features {
    font-size: 0.875rem;
    color: var(--color-surface-foreground);
  }
}
