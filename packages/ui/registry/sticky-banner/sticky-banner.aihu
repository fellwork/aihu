<!--
  aihu-sticky-banner — presentational styled recipe (performativeUI port,
  Slice 2 — docs/plans/2026-08-01-performative-ui-port.md).

  Design and behavior transcribed in spirit from performativeUI (MIT); no
  source text or `pui-` class names vendored — see NOTICES.md.

  A full-width announcement bar. Presentational-only in this slice — no
  dismiss affordance (if one is added later this becomes a Tier-B/Phase-2
  component per the roadmap's authoring-pattern rule). `aihu add` rewrites
  the `aihu-` prefix at copy time.

  tone: neutral (default) | accent | warning

  `shadow: 'light'` — see status-dot.aihu's header for why.
-->

@state {
  import { cn } from '@aihu/css-engine/runtime/cn'

  shadow: 'light'

  let tone = prop({ default: 'neutral' })
}

@template {
  <div data-slot="sticky-banner" data-tone={tone} class={cn('aihu-sticky-banner')}>
    <slot />
  </div>
}

@style {
  .aihu-sticky-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding-block: 0.5rem;
    padding-inline: 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-align: center;
    background-color: var(--color-neutral);
    color: var(--color-neutral-foreground);
  }
  /* `--color-accent-foreground` on raw `--color-accent` is only 4.14:1 in
     aihu-default light — under the 4.5:1 WCAG 2 AA floor for this 0.875rem
     banner text. Deepening the fill with 20% `--color-foreground` keeps the
     accent read and lifts every pack x mode to >=5.5:1. */
  .aihu-sticky-banner[data-tone="accent"] {
    background-color: color-mix(in oklab, var(--color-accent) 80%, var(--color-foreground));
    color: var(--color-accent-foreground);
  }
  .aihu-sticky-banner[data-tone="warning"] {
    background-color: var(--color-warning);
    color: var(--color-warning-foreground);
  }
}
