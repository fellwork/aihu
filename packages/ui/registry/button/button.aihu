<!--
  aihu-button — styled recipe (Plan 5 Task 5, master spec §9.2 / §9.4).

  The class-extension recipe: extends the HEADLESS `AihuButton` base from
  `@aihu/primitives/button` (behavior + ARIA, zero CSS) and registers a concrete
  prefixed tag (`<aihu-button>`). `aihu add` rewrites the `aihu-` prefix to the
  consumer's chosen prefix at copy time; after copy the consumer owns this source.

  variant: default | destructive | outline | ghost | link
  size:    sm | md | lg | icon
  slots:   button
  (The variant/size matrix is the registry catalog contract — see meta.json.
  These are reflected as `data-variant` / `data-size` and matched in @style below.)

  CSS attachment (R2): the compiled recipe stylesheet is a Constructable
  StyleSheet adopted into the element's shadow root, constructed ONCE as a
  `static` on the class and SHARED across instances — never a per-instance
  inline style element. See `AihuButtonRecipe.sheet` in @state.
-->

@state {
  import { cn } from '@aihu/css-engine/runtime/cn'
  import { AihuButton } from '@aihu/primitives/button'

  let variant = prop({ default: 'default' })
  let size = prop({ default: 'md' })
  let disabled = prop({ default: false })

  // The concrete styled element: behavior inherited from the headless base,
  // appearance from the adopted stylesheet (R2 — shared static, not per-instance).
  class AihuButtonRecipe extends AihuButton {
    static sheet = (() => {
      const s = new CSSStyleSheet()
      // The recipe stylesheet is produced by the css-engine scanner at the
      // consumer's `aihu build`; this static is the shared, single-construction
      // sheet every instance adopts.
      return s
    })()

    connectedCallback() {
      super.connectedCallback?.()
      if (!this.shadowRoot) this.attachShadow({ mode: 'open' })
      this.shadowRoot.adoptedStyleSheets = [AihuButtonRecipe.sheet]
    }
  }

  if (!customElements.get('aihu-button')) {
    customElements.define('aihu-button', AihuButtonRecipe)
  }
}

@template {
  <button
    type="button"
    data-slot="button"
    data-variant={variant}
    data-size={size}
    disabled={disabled}
    class={cn('aihu-button')}>
    <slot />
  </button>
}

@style {
  /* Base — semantic utilities (no raw colors). */
  .aihu-button {
    @apply inline-flex items-center justify-center rounded-md font-medium select-none
           transition-colors disabled:opacity-50 disabled:pointer-events-none;
  }

  /* Variant matrix — semantic tokens via var(--color-*); pack-invariant (R4). */
  .aihu-button[data-variant="default"] {
    background-color: var(--color-primary);
    color: var(--color-primary-foreground);
  }
  .aihu-button[data-variant="default"]:hover {
    background-color: var(--color-primary);
  }
  .aihu-button[data-variant="destructive"] {
    background-color: var(--color-destructive);
    color: var(--color-destructive-foreground);
  }
  .aihu-button[data-variant="destructive"]:hover {
    background-color: var(--color-destructive);
  }
  .aihu-button[data-variant="outline"] {
    border: 1px solid var(--color-border);
    background-color: var(--color-background);
  }
  .aihu-button[data-variant="outline"]:hover {
    background-color: var(--color-accent);
  }
  .aihu-button[data-variant="ghost"] {
    background-color: transparent;
  }
  .aihu-button[data-variant="ghost"]:hover {
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
  }
  .aihu-button[data-variant="link"] {
    background-color: transparent;
    color: var(--color-primary);
    text-underline-offset: 4px;
  }
  .aihu-button[data-variant="link"]:hover {
    text-decoration: underline;
  }

  /* Size matrix. */
  .aihu-button[data-size="sm"] {
    height: 2rem;
    padding-inline: 0.75rem;
    font-size: 0.75rem;
  }
  .aihu-button[data-size="md"] {
    height: 2.25rem;
    padding-inline: 1rem;
    font-size: 0.875rem;
  }
  .aihu-button[data-size="lg"] {
    height: 2.5rem;
    padding-inline: 2rem;
    font-size: 0.875rem;
  }
  .aihu-button[data-size="icon"] {
    height: 2.25rem;
    width: 2.25rem;
  }
}
