{
  "name": "button",
  "type": "ui",
  "description": "Styled button recipe extending the headless AihuButton primitive (variants + sizes).",
  "dependencies": ["@aihu/primitives"],
  "registryDependencies": [],
  "variants": {
    "variant": ["default", "destructive", "outline", "ghost", "link"],
    "size": ["sm", "md", "lg", "icon"]
  },
  "meta": {
    "capabilities": {
      "interactive": true,
      "keyboard": true,
      "form": false,
      "overlay": false,
      "directional": false,
      "hoverable": true
    }
  }
}
