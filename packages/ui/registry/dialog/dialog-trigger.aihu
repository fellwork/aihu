<!--
  aihu-dialog-trigger — styled recipe piece (Phase 2, master spec §9.4 / §9.7).

  `<aihu-dialog-trigger>` EXTENDS the headless AihuDialogTrigger primitive
  (toggles the dialog, wires `aria-haspopup`/`aria-expanded`/`aria-controls`)
  via the compiler's `$extends:` macro. Light DOM (`$shadow: 'light'`) so the
  context injection reaches the ancestor root. The trigger is usually the
  consumer's own button — styling is intentionally minimal.

  `aihu add` rewrites the `aihu-` prefix (tag + selectors) at copy time.
-->

@state {
  import { AihuDialogTrigger } from '@aihu/primitives/dialog'

  $extends: AihuDialogTrigger
  $shadow: 'light'
}

@template {
  <slot></slot>
}

@style {
  aihu-dialog-trigger {
    display: inline-flex;
    cursor: pointer;
  }
}
