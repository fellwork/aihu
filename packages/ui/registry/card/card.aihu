<!--
  aihu-card — presentational styled recipe (Plan 5 Task 5, master spec §9.7).

  Standalone styled custom element — NO primitive import (card has no headless
  behavior base; it is purely visual). Slotted header / body / footer regions.
  `aihu add` rewrites the `aihu-` prefix at copy time.

  CSS attachment (R2): the compiled recipe stylesheet is a shared static
  Constructable StyleSheet adopted into the shadow root, not a per-instance
  inline style element.
-->

@state {
  import { cn } from '@aihu/css-engine/runtime/cn'

  class AihuCard extends HTMLElement {
    static sheet = new CSSStyleSheet()

    connectedCallback() {
      if (!this.shadowRoot) this.attachShadow({ mode: 'open' })
      this.shadowRoot.adoptedStyleSheets = [AihuCard.sheet]
    }
  }

  if (!customElements.get('aihu-card')) {
    customElements.define('aihu-card', AihuCard)
  }
}

@template {
  <div data-slot="card" class={cn('aihu-card')}>
    <div class="aihu-card-header" part="header"><slot name="header" /></div>
    <div class="aihu-card-body" part="body"><slot /></div>
    <div class="aihu-card-footer" part="footer"><slot name="footer" /></div>
  </div>
}

@style {
  .aihu-card {
    display: block;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background-color: var(--color-surface);
    color: var(--color-surface-foreground);
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  }
  .aihu-card-header {
    padding: 1.5rem 1.5rem 0;
  }
  .aihu-card-body {
    padding: 1.5rem;
  }
  .aihu-card-footer {
    padding: 0 1.5rem 1.5rem;
  }
}
