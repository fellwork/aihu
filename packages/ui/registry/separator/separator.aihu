<!--
  aihu-separator — presentational styled recipe (Plan 5 Task 5, master spec §9.7).

  Standalone styled custom element — NO primitive import. A 1px token-colored
  rule. Reflects an `orientation` attribute (horizontal | vertical), exposes
  `role="separator"` + `aria-orientation`. `aihu add` rewrites the `aihu-`
  prefix at copy time.

  orientation: horizontal (default) | vertical

  CSS attachment (R2): the compiled `@style` block below IS the shared
  Constructable StyleSheet — see `card.aihu`'s header. A recipe writes no
  registration and no `adoptedStyleSheets` code of its own.

  ARIA lives on the TEMPLATE element, not the host. `role="separator"` +
  `aria-orientation` are authored on the rendered `[data-slot="separator"]`
  div, which is inside the shadow root and therefore in the accessibility tree.
  This recipe deliberately does NOT `$extends:` the headless `AihuSeparator`
  from `@aihu/primitives/separator` — that primitive puts the role on the HOST
  and renders nothing, which is a different (also valid) shape. Consumers who
  want the host-as-separator shape should use the primitive directly.
-->

@state {
  import { cn } from '@aihu/css-engine/runtime/cn'

  let orientation = prop({ default: 'horizontal' })
}

@template {
  <div
    data-slot="separator"
    role="separator"
    aria-orientation={orientation}
    data-orientation={orientation}
    class={cn('aihu-separator')}></div>
}

@style {
  .aihu-separator {
    display: block;
    background-color: var(--color-border);
    flex-shrink: 0;
  }
  .aihu-separator[data-orientation="horizontal"] {
    height: 1px;
    width: 100%;
  }
  .aihu-separator[data-orientation="vertical"] {
    width: 1px;
    height: 100%;
  }
}
