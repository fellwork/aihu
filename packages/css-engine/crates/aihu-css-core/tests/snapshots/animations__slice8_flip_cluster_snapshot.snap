assertion_line: 160
expression: compile_classes(&classes)
---
.animate-flip-horizontal { animation: flip-horizontal 1s ease-in-out both; }
@keyframes flip-horizontal { 0% { transform: rotateY(0deg); } 100% { transform: rotateY(180deg); } }
.animate-flip-in-x { animation: flip-in-x 0.6s ease-out both; }
@keyframes flip-in-x { 0% { opacity: 0; transform: rotateY(90deg); } 100% { opacity: 1; transform: rotateY(0deg); } }
.animate-flip-in-y { animation: flip-in-y 0.6s ease-out both; }
@keyframes flip-in-y { 0% { opacity: 0; transform: rotateX(90deg); } 100% { opacity: 1; transform: rotateX(0deg); } }
.animate-flip-out-x { animation: flip-out-x 0.6s ease-out both; }
@keyframes flip-out-x { 0% { opacity: 1; transform: rotateY(0deg); } 100% { opacity: 0; transform: rotateY(90deg); } }
.animate-flip-out-y { animation: flip-out-y 0.6s ease-out both; }
@keyframes flip-out-y { 0% { opacity: 1; transform: rotateX(0deg); } 100% { opacity: 0; transform: rotateX(90deg); } }
.animate-flip-vertical { animation: flip-vertical 1s ease-in-out both; }
@keyframes flip-vertical { 0% { transform: rotateX(0deg); } 100% { transform: rotateX(180deg); } }
.animate-flip-x { animation: flip-x 0.6s ease-out both; }
@keyframes flip-x { 0% { transform: scaleX(1); } 50% { transform: scaleX(-1); } 100% { transform: scaleX(1); } }
.animate-flip-y { animation: flip-y 0.6s ease-out both; }
@keyframes flip-y { 0% { transform: scaleY(1); } 50% { transform: scaleY(-1); } 100% { transform: scaleY(1); } }
