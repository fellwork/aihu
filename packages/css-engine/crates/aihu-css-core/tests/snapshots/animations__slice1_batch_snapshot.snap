---
source: packages/css-engine/crates/aihu-css-core/tests/animations.rs
assertion_line: 67
expression: compile_classes(&classes)
---
.animate-fade-in { animation: fade-in 0.6s ease-in both; }
@keyframes fade-in { 0% { opacity: 0; } 100% { opacity: 1; } }
.animate-fade-out { animation: fade-out 0.6s ease-out both; }
@keyframes fade-out { 0% { opacity: 1; } 100% { opacity: 0; } }
.animate-jump { animation: jump 1s ease-in-out both; }
@keyframes jump { 0% { transform: translateY(0); } 50% { transform: translateY(-20px); } 100% { transform: translateY(0); } }
.animate-rotate-in { animation: rotate-in 0.6s ease-out both; }
@keyframes rotate-in { 0% { opacity: 0; transform: rotate(-90deg); } 100% { opacity: 1; transform: rotate(0deg); } }
.animate-shake { animation: shake 0.5s ease-in-out both; }
@keyframes shake { 0% { transform: translateX(0); } 25% { transform: translateX(-10px); } 50% { transform: translateX(10px); } 75% { transform: translateX(-10px); } 100% { transform: translateX(0); } }
.animate-slide-in-left { animation: slide-in-left 0.6s ease-out both; }
@keyframes slide-in-left { 0% { transform: translateX(calc(var(--aihu-anim-slide-distance, 20px) * -1)); } 100% { transform: translateX(0); } }
.animate-slide-in-top { animation: slide-in-top 0.6s ease-out both; }
@keyframes slide-in-top { 0% { transform: translateY(calc(var(--aihu-anim-slide-distance, 20px) * -1)); } 100% { transform: translateY(0); } }
.animate-zoom-in { animation: zoom-in 0.6s ease-out both; }
@keyframes zoom-in { 0% { opacity: 0; transform: scale(.5); } 100% { opacity: 1; transform: scale(1); } }
