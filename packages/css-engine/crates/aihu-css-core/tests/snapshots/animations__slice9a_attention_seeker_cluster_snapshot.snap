source: packages/css-engine/crates/aihu-css-core/tests/animations.rs
assertion_line: 185
expression: compile_classes(&classes)
---
.animate-blink { animation: blink 0.5s both; }
@keyframes blink { 0% { opacity: 0; } 100% { opacity: 1; } }
.animate-bouncing { animation: bouncing 1s ease-in-out both; }
@keyframes bouncing { 0% { transform: translateY(0); } 50% { transform: translateY(-10px); } 100% { transform: translateY(0); } }
.animate-dancing { animation: dancing 1s ease-in-out both; }
@keyframes dancing { 0% { transform: skew(0deg); } 25% { transform: skew(-40deg); } 50% { transform: skew(40deg); } 75% { transform: skew(-40deg); } 100% { transform: skew(0deg); } }
.animate-flash { animation: flash 1s ease-in-out both; }
@keyframes flash { 0% { opacity: 1; } 50% { opacity: 0; } 100% { opacity: 1; } }
.animate-float { animation: float 1s ease-in-out both; }
@keyframes float { 0% { transform: translateY(0); } 50% { transform: translateY(-10px); } 100% { transform: translateY(0); } }
.animate-hang { animation: hang 1s ease-in-out both; }
@keyframes hang { 0% { transform: translateY(-20px); } 50% { transform: translateY(0); } 100% { transform: translateY(-20px); } }
.animate-heartbeat { animation: heartbeat 0.6s ease-out both; }
@keyframes heartbeat { 0% { transform: scale(1); } 25% { transform: scale(1.1); } 50% { transform: scale(1); } 75% { transform: scale(0.9); } 100% { transform: scale(1); } }
.animate-horizontal-bounce { animation: horizontal-bounce 0.6s ease-in-out both; }
@keyframes horizontal-bounce { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(20px); } }
.animate-horizontal-vibration { animation: horizontal-vibration 0.3s linear infinite both; }
@keyframes horizontal-vibration { 0% { transform: translateX(0); } 25% { transform: translateX(5px); } 50% { transform: translateX(-5px); } 75% { transform: translateX(5px); } 100% { transform: translateX(0); } }
.animate-impulse-rotation-left { animation: impulse-rotation-left 1s ease-in-out both; }
@keyframes impulse-rotation-left { 0% { transform: rotate(0deg); } 50% { transform: rotate(40deg); } 100% { transform: rotate(-360deg); } }
.animate-impulse-rotation-right { animation: impulse-rotation-right 1s ease-in-out both; }
@keyframes impulse-rotation-right { 0% { transform: rotate(0deg); } 50% { transform: rotate(-40deg); } 100% { transform: rotate(360deg); } }
.animate-jelly { animation: jelly 1s ease-out forwards; }
@keyframes jelly { 0% { transform: scale(1, 1); } 20% { transform: scale(1.25, 0.75); } 40% { transform: scale(0.75, 1.25); } 60% { transform: scale(1.15, 0.85); } 75% { transform: scale(0.95, 1.05); } 85% { transform: scale(1.05, 0.95); } 92% { transform: scale(1, 1.02); } 100% { transform: scale(1, 1); } }
.animate-jiggle { animation: jiggle 0.5s ease-in-out both; }
@keyframes jiggle { 0% { transform: rotate(-3deg); } 50% { transform: rotate(3deg); } 100% { transform: rotate(-3deg); } }
.animate-pulsing { animation: pulsing 1s ease-in-out both; }
@keyframes pulsing { 0% { transform: scale(1); } 50% { transform: scale(1.1); } 100% { transform: scale(1); } }
.animate-roll-in { animation: roll-in 1s ease-in-out both; }
@keyframes roll-in { 0% { transform: translateX(-20px) rotate(-120deg); } 100% { transform: translateX(0) rotate(0); } }
