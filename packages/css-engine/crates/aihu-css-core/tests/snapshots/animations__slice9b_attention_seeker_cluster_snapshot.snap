.animate-roll-out { animation: roll-out 1s ease-in-out both; }
@keyframes roll-out { 0% { transform: translateX(0) rotate(0); } 100% { transform: translateX(20px) rotate(120deg); } }
.animate-rotational-wave { animation: rotational-wave 2s ease-in-out infinite both; }
@keyframes rotational-wave { 0% { transform: rotate(0deg); } 25% { transform: rotate(10deg); } 50% { transform: rotate(-10deg); } 75% { transform: rotate(10deg); } 100% { transform: rotate(0deg); } }
.animate-rubber-band { animation: rubber-band 1s ease-in-out both; }
@keyframes rubber-band { 0% { transform: scale(1); } 30% { transform: scale(1.25); } 40% { transform: scale(0.75); } 50% { transform: scale(1.15); } 65% { transform: scale(0.95); } 75% { transform: scale(1.05); } 100% { transform: scale(1); } }
.animate-sink { animation: sink 1s ease-in-out both; }
@keyframes sink { 0% { transform: translateY(-10px); } 50% { transform: translateY(0); } 100% { transform: translateY(-10px); } }
.animate-skew { animation: skew 0.5s ease-in-out both; }
@keyframes skew { 0% { transform: skew(0deg); } 100% { transform: skew(20deg); } }
.animate-skew-right { animation: skew-right 0.5s ease-in-out both; }
@keyframes skew-right { 0% { transform: skew(0deg); } 100% { transform: skew(-20deg); } }
.animate-squeeze { animation: squeeze 0.6s ease-in-out both; }
@keyframes squeeze { 0%, 100% { transform: scale(1, 1); } 50% { transform: scale(1.1, 0.9); } }
.animate-sway { animation: sway 0.6s ease-out both; }
@keyframes sway { 0% { transform: rotate(0deg); } 50% { transform: rotate(15deg); } 100% { transform: rotate(0deg); } }
.animate-swing { animation: swing 1s ease-in-out both; }
@keyframes swing { 0% { transform: rotate(0deg); } 50% { transform: rotate(15deg); } 100% { transform: rotate(0deg); } }
.animate-swing-drop-in { animation: swing-drop-in 0.6s ease-out both; }
@keyframes swing-drop-in { 0% { transform: rotate(-30deg) translateY(-50px); opacity: 0; } 100% { transform: rotate(0deg) translateY(0); opacity: 1; } }
.animate-tada { animation: tada 1s ease-in-out both; }
@keyframes tada { 0% { transform: scale(1); } 10% { transform: scale(0.9) rotate(-3deg); } 20% { transform: scale(0.9) rotate(-3deg); } 30% { transform: scale(1.1) rotate(3deg); } 40% { transform: scale(1.1) rotate(-3deg); } 50% { transform: scale(1.1) rotate(3deg); } 60% { transform: scale(1.1) rotate(-3deg); } 70% { transform: scale(1.1) rotate(3deg); } 80% { transform: scale(1.1) rotate(3deg); } 90% { transform: scale(1.1) rotate(3deg); } 100% { transform: scale(1) rotate(0); } }
.animate-tilt { animation: tilt 0.6s ease-in-out both; }
@keyframes tilt { 0% { transform: rotateY(0deg); } 50% { transform: rotateY(20deg); } 100% { transform: rotateY(0deg); } }
.animate-vertical-bounce { animation: vertical-bounce 0.6s ease-in-out both; }
@keyframes vertical-bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-20px); } }
.animate-wobble { animation: wobble 1s ease-in-out both; }
@keyframes wobble { 0% { transform: translateX(0); } 15% { transform: translateX(-20px); } 30% { transform: translateX(20%); } 45% { transform: translateX(-15%); } 60% { transform: translateX(20px); } 75% { transform: translateX(-5%); } 100% { transform: translateX(0); } }
