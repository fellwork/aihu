// Synthetic edge-case fixture for prober round 1.
// Exercises: lambda-LHS $each, curly $bind drift, $ref no-op, $html security
// opt-in, inline class ternary, deprecated `:value=` alias.

@state {
  $prop: {
    posts: { type: Array<{ id: string; title: string; tags: string[] }> },
    query: { type: string, default: '' },
  }

  selected: string = ''
  selectedNode: HTMLElement | null = null

  $computed: {
    filtered: () => posts.filter(p => p && p.title.includes(query)),
  }

  $action: {
    select: (id: string) => { selected = id },
    setQuery: (q: string) => { query = q },
  }
}

@template {
  <div class="search">
    <!-- Deprecated alias: should be rewritten to $bind:value -->
    <input :value="query" $on:input={(e) => setQuery(e.target.value)} />

    <!-- Drift: $bind:* with curly form (parser accepts but spec forbids) -->
    <input $bind:value={query} placeholder="curly-bind drift" />

    <!-- Lambda LHS landmine: filter().map() chain inside $each quoted form -->
    <ul $if={filtered.length > 0}>
      <li
        $each="posts.filter(p => p && p.title.includes(query)).map(m => ({ id: m.id, title: m.title })) as item, idx"
        $key={item.id}
        class={'row' + (item.id === selected ? ' selected' : '')}
        $on:click={() => select(item.id)}
      >
        <span>{idx}: {item.title}</span>
      </li>
    </ul>

    <!-- $ref: silently dropped by codegen (Scout D1.1 finding) -->
    <div $ref="selectedNode" class="preview">
      <!-- $html: security opt-in -->
      <article $html={item && item.bodyHtml}></article>
    </div>
  </div>
}
