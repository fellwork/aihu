// Edge-case fixture transformed for Variant A (harmonize-and-stay).
// Refinements applied:
// - $on:event -> $on.event (dot, not colon)
// - $bind:prop -> $bind.prop (dot, not colon)
// - All expression-typed directives use curly form ($if, $each, $key, $on, $bind, $class)
// - Inline class ternary -> $class array form
// - Deprecated `:value=` removed in pre-pass (dropped to $bind.value)
// - $ref dropped: refused (codemod must warn — see report). Replaced with $on.mount capture.
// - Lambda LHS in $each: hoisted to $computed (refusal in template; codemod errors with C501).

@state {
  $prop: {
    posts: { type: Array<{ id: string; title: string; tags: string[]; bodyHtml?: string }> },
    query: { type: string, default: '' },
  }

  selected: string = ''
  selectedNode: HTMLElement | null = null

  $computed: {
    filtered: () => posts
      .filter(p => p && p.title.includes(query))
      .map(m => ({ id: m.id, title: m.title })),
    selectedItem: () => filtered.find(it => it.id === selected),
  }

  $action: {
    select: (id: string) => { selected = id },
    setQuery: (q: string) => { query = q },
  }

  $lifecycle: {
    mount: () => {
      // Variant A refusal: $ref="selectedNode" was silently dropped in v1.
      // Codemod replaces with explicit ref-capture via a query selector
      // OR requires the author to use the new $ref={(el) => signal} curly form.
      // Hoisted here as an explicit refusal example — codemod emits warning W500.
    },
  }
}

@template {
  <div class="search">
    <!-- Pre-pass dropped `:value="query"` -> `$bind.value={query}` -->
    <input $bind.value={query} $on.input={(e) => setQuery(e.target.value)} />

    <!-- Drift fixed: $bind:value={query} (curly) -> $bind.value={query} (now legal in A) -->
    <input $bind.value={query} placeholder="curly-bind drift" />

    <!-- Lambda LHS landmine: hoisted to $computed `filtered` above; $each uses identifier reference -->
    <ul $if={filtered.length > 0}>
      <li
        $each={filtered as item, idx}
        $key={item.id}
        $class={['row', item.id === selected && 'selected']}
        $on.click={() => select(item.id)}
      >
        <span>{idx}: {item.title}</span>
      </li>
    </ul>

    <!-- $ref refused in template: see @state.$lifecycle.mount above -->
    <div class="preview">
      <!-- $html: kept (security opt-in remains explicit) -->
      <article $html={selectedItem && selectedItem.bodyHtml}></article>
    </div>
  </div>
}
